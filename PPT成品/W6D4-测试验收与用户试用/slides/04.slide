<Slide style={{ width: 1280, height: 720, padding: 60, background: '#FFFFFF', position: 'relative' }}>
  <Box style={{ position: 'absolute', top: 24, left: 60, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
    <Box style={{ width: 8, height: 24, background: '#7C3AED', borderRadius: 4 }} />
    <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W6D4</Text>
    <Box style={{ background: '#F5F3FF', borderRadius: 10, padding: '3px 12px' }}>
      <Text style={{ fontSize: 12, fontWeight: 'bold', color: '#7C3AED' }}>距路演 1 天</Text>
    </Box>
  </Box>
  <Box style={{ position: 'absolute', bottom: 26, right: 60 }}>
    <Text style={{ fontSize: 14, color: '#64748B' }}>04 / 12</Text>
  </Box>

  <Box style={{ gap: 16 }}>
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B' }}>破案示范：一条「编造政策」的 badcase</Text>
    <Box style={{ width: '100%', height: 1, background: '#E5E7EB' }} />
  </Box>

  <Box style={{ flex: 1, flexDirection: 'row', gap: 24, paddingTop: 24, justifyContent: 'center' }}>
    <Box style={{ width: 520, gap: 14, justifyContent: 'center' }}>
      <Box style={{ background: '#FFFFFF', border: '1px solid #E5E7EB', borderRadius: 12, padding: '16px 22px', gap: 6 }}>
        <Text style={{ fontSize: 14, color: '#64748B' }}>用户提问</Text>
        <Text style={{ fontSize: 20, color: '#1E1B4B' }}>「你们的退款政策是什么？」</Text>
      </Box>
      <Box style={{ background: '#EFF6FF', border: '1px solid #BFDBFE', borderRadius: 12, padding: '16px 22px', gap: 6 }}>
        <Text style={{ fontSize: 14, color: '#2563EB' }}>模型实际输出</Text>
        <Text style={{ fontSize: 20, color: '#1E1B4B', lineHeight: 1.5 }}>「<span style={{ fontWeight: 'bold' }}>72 小时</span>无条件退款，<span style={{ fontWeight: 'bold' }}>2 小时</span>原路退回」</Text>
        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#7C3AED' }}>定位标签：编造政策</Text>
      </Box>
      <Box style={{ background: '#F5F3FF', border: '1px solid #DDD6FE', borderRadius: 12, padding: '16px 22px', gap: 6 }}>
        <Text style={{ fontSize: 14, color: '#7C3AED' }}>真实政策</Text>
        <Text style={{ fontSize: 20, color: '#1E1B4B' }}>「<span style={{ fontWeight: 'bold' }}>7 天无理由</span>，激活后不支持」</Text>
      </Box>
    </Box>

    <Box style={{ flex: 1, gap: 12, justifyContent: 'center' }}>
      <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1E1B4B' }}>证据逐层揭开</Text>
      <Box style={{ background: '#F5F3FF', borderRadius: 10, padding: '12px 18px', gap: 4 }}>
        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#7C3AED' }}>第 1 层 · 引用原文</Text>
        <Text style={{ fontSize: 17, color: '#1E1B4B' }}>原文里没有「72 小时」，数字凭空出现</Text>
      </Box>
      <Box style={{ background: '#F5F3FF', borderRadius: 10, padding: '12px 18px', gap: 4 }}>
        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#7C3AED' }}>第 2 层 · chunk 完整</Text>
        <Text style={{ fontSize: 17, color: '#1E1B4B' }}>政策 chunk 完好，主题没有被切断</Text>
      </Box>
      <Box style={{ background: '#F5F3FF', borderRadius: 10, padding: '12px 18px', gap: 4 }}>
        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#7C3AED' }}>第 3 层 · 召回正确</Text>
        <Text style={{ fontSize: 17, color: '#1E1B4B' }}>正确的政策 chunk 已经被捞到</Text>
      </Box>
      <Box style={{ background: '#EFF6FF', borderRadius: 10, padding: '12px 18px', gap: 4 }}>
        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#2563EB' }}>第 4 层 · 裸模型对照</Text>
        <Text style={{ fontSize: 17, color: '#1E1B4B' }}>拿着好资料仍编造 → 定位：生成问题</Text>
      </Box>
    </Box>
  </Box>
</Slide>
