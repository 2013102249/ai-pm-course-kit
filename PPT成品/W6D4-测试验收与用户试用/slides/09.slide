<Slide style={{ width: 1280, height: 720, padding: 60, background: '#FFFFFF', position: 'relative' }}>
  <Box style={{ position: 'absolute', top: 24, left: 60, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
    <Box style={{ width: 8, height: 24, background: '#7C3AED', borderRadius: 4 }} />
    <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W6D4</Text>
    <Box style={{ background: '#F5F3FF', borderRadius: 10, padding: '3px 12px' }}>
      <Text style={{ fontSize: 12, fontWeight: 'bold', color: '#7C3AED' }}>距路演 1 天</Text>
    </Box>
  </Box>
  <Box style={{ position: 'absolute', bottom: 26, right: 60 }}>
    <Text style={{ fontSize: 14, color: '#64748B' }}>09 / 12</Text>
  </Box>

  <Box style={{ gap: 16 }}>
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B' }}>真实用户试用：≥10 人怎么邀请</Text>
    <Box style={{ width: '100%', height: 1, background: '#E5E7EB' }} />
  </Box>

  <Box style={{ flex: 1, flexDirection: 'row', gap: 32, alignItems: 'center' }}>
    <Box style={{ flex: 1, gap: 18 }}>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 18, background: '#F5F3FF', borderRadius: 12, padding: '20px 26px' }}>
        <Box style={{ width: 28, height: 28, background: '#7C3AED', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
          <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>01</Text>
        </Box>
        <Box style={{ gap: 4 }}>
          <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1E1B4B' }}>列 15 个候选</Text>
          <Text style={{ fontSize: 17, color: '#64748B' }}>按匹配度排序，优先最像目标用户的人</Text>
        </Box>
      </Box>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 18, background: '#EFF6FF', borderRadius: 12, padding: '20px 26px' }}>
        <Box style={{ width: 28, height: 28, background: '#7C3AED', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
          <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>02</Text>
        </Box>
        <Box style={{ gap: 4 }}>
          <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1E1B4B' }}>给 3 个具体任务</Text>
          <Text style={{ fontSize: 17, color: '#64748B' }}>禁「随便看看」，任务越具体反馈越可用</Text>
        </Box>
      </Box>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 18, background: '#F5F3FF', borderRadius: 12, padding: '20px 26px' }}>
        <Box style={{ width: 28, height: 28, background: '#7C3AED', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
          <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>03</Text>
        </Box>
        <Box style={{ gap: 4 }}>
          <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1E1B4B' }}>必填问题</Text>
          <Text style={{ fontSize: 17, color: '#64748B' }}>「哪个环节你想关掉它？」</Text>
        </Box>
      </Box>
    </Box>
    <Box style={{ width: 400, alignItems: 'center', justifyContent: 'center' }}>
      <Image src="assets/feedback-levels.svg" style={{ width: 400, height: 233, borderRadius: 12 }} />
    </Box>
  </Box>
</Slide>
