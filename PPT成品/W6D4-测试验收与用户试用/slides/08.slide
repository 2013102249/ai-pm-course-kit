<Slide style={{ width: 1280, height: 720, padding: 60, background: '#FFFFFF', position: 'relative' }}>
  <Box style={{ position: 'absolute', top: 24, left: 60, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
    <Box style={{ width: 8, height: 24, background: '#7C3AED', borderRadius: 4 }} />
    <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W6D4</Text>
    <Box style={{ background: '#F5F3FF', borderRadius: 10, padding: '3px 12px' }}>
      <Text style={{ fontSize: 12, fontWeight: 'bold', color: '#7C3AED' }}>距路演 1 天</Text>
    </Box>
  </Box>
  <Box style={{ position: 'absolute', bottom: 26, right: 60 }}>
    <Text style={{ fontSize: 14, color: '#64748B' }}>08 / 12</Text>
  </Box>

  <Box style={{ gap: 16 }}>
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B' }}>跑分读三个数</Text>
    <Box style={{ width: '100%', height: 1, background: '#E5E7EB' }} />
    <Text style={{ fontSize: 17, color: '#64748B' }}>本页配合现场工具投屏讲解 · 以下为示例数据实况读数</Text>
  </Box>

  <Box style={{ flex: 1, justifyContent: 'center', gap: 14 }}>
    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 20, background: '#F5F3FF', borderRadius: 12, padding: '18px 26px' }}>
      <Box style={{ width: 28, height: 28, background: '#7C3AED', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>01</Text>
      </Box>
      <Box style={{ flex: 1, gap: 4 }}>
        <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1E1B4B' }}>通过率</Text>
        <Text style={{ fontSize: 17, color: '#64748B' }}>上线线：≥90% 且无 P0 才够上线线</Text>
      </Box>
      <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#1E1B4B' }}>示例读数 33.3%</Text>
    </Box>
    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 20, background: '#EFF6FF', borderRadius: 12, padding: '18px 26px' }}>
      <Box style={{ width: 28, height: 28, background: '#7C3AED', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>02</Text>
      </Box>
      <Box style={{ flex: 1, gap: 4 }}>
        <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1E1B4B' }}>badcase 率</Text>
        <Text style={{ fontSize: 17, color: '#64748B' }}>熔断线：<span style={{ color: '#DC2626', fontWeight: 'bold' }}>30%</span>，触线即熔断排查</Text>
      </Box>
      <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#DC2626' }}>示例读数 33.3%</Text>
    </Box>
    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 20, background: '#F5F3FF', borderRadius: 12, padding: '18px 26px' }}>
      <Box style={{ width: 28, height: 28, background: '#7C3AED', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>03</Text>
      </Box>
      <Box style={{ flex: 1, gap: 4 }}>
        <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1E1B4B' }}>雷达凹点</Text>
        <Text style={{ fontSize: 17, color: '#64748B' }}>补根因，不补最低分</Text>
      </Box>
      <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#1E1B4B' }}>综合均分 3.6</Text>
    </Box>
  </Box>

  <Box style={{ background: '#7C3AED', borderRadius: 12, padding: '14px 28px', alignItems: 'center', justifyContent: 'center' }}>
    <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#FFFFFF' }}>雷达图看形状，通过率看底线</Text>
  </Box>
</Slide>
