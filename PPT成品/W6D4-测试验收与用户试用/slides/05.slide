<Slide style={{ width: 1280, height: 720, padding: 60, background: '#FFFFFF', position: 'relative' }}>
  <Box style={{ position: 'absolute', top: 24, left: 60, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
    <Box style={{ width: 8, height: 24, background: '#7C3AED', borderRadius: 4 }} />
    <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W6D4</Text>
    <Box style={{ background: '#F5F3FF', borderRadius: 10, padding: '3px 12px' }}>
      <Text style={{ fontSize: 12, fontWeight: 'bold', color: '#7C3AED' }}>距路演 1 天</Text>
    </Box>
  </Box>
  <Box style={{ position: 'absolute', bottom: 26, right: 60 }}>
    <Text style={{ fontSize: 14, color: '#64748B' }}>05 / 12</Text>
  </Box>

  <Box style={{ gap: 16 }}>
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B' }}>四类归因：每种病吃不同的药</Text>
    <Box style={{ width: '100%', height: 1, background: '#E5E7EB' }} />
  </Box>

  <Box style={{ flex: 1, justifyContent: 'center', gap: 16 }}>
    <Box style={{ flexDirection: 'row', gap: 16 }}>
      <Box style={{ flex: 1, background: '#F5F3FF', borderRadius: 12, padding: '20px 24px', gap: 8 }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
          <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#1E1B4B' }}>解析问题</Text>
          <Box style={{ background: '#EFF6FF', borderRadius: 10, padding: '3px 12px' }}>
            <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#2563EB' }}>答非所问</Text>
          </Box>
        </Box>
        <Text style={{ fontSize: 17, color: '#64748B' }}>原文错：解析阶段就把原文读错</Text>
      </Box>
      <Box style={{ flex: 1, background: '#EFF6FF', borderRadius: 12, padding: '20px 24px', gap: 8 }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
          <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#1E1B4B' }}>分块问题</Text>
          <Box style={{ background: '#F5F3FF', borderRadius: 10, padding: '3px 12px' }}>
            <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#7C3AED' }}>格式错误</Text>
          </Box>
        </Box>
        <Text style={{ fontSize: 17, color: '#64748B' }}>答案被切断，主题被稀释</Text>
      </Box>
    </Box>
    <Box style={{ flexDirection: 'row', gap: 16 }}>
      <Box style={{ flex: 1, background: '#EFF6FF', borderRadius: 12, padding: '20px 24px', gap: 8 }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
          <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#1E1B4B' }}>检索问题</Text>
          <Box style={{ background: '#F5F3FF', borderRadius: 10, padding: '3px 12px' }}>
            <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#7C3AED' }}>答非所问</Text>
          </Box>
        </Box>
        <Text style={{ fontSize: 17, color: '#64748B' }}>资料里有，却没捞到</Text>
      </Box>
      <Box style={{ flex: 1, background: '#F5F3FF', borderRadius: 12, padding: '20px 24px', gap: 8 }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
          <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#1E1B4B' }}>生成问题</Text>
          <Box style={{ background: '#EFF6FF', borderRadius: 10, padding: '3px 12px' }}>
            <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#2563EB' }}>编造政策</Text>
          </Box>
        </Box>
        <Text style={{ fontSize: 17, color: '#64748B' }}>好资料仍编造，模型自由发挥</Text>
      </Box>
    </Box>
  </Box>

  <Box style={{ background: '#7C3AED', borderRadius: 12, padding: '14px 28px', alignItems: 'center', justifyContent: 'center' }}>
    <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#FFFFFF' }}>纪律：无归因，不派单</Text>
