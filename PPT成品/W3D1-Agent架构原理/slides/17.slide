<Slide style={{ width: 1280, height: 720, padding: 60, background: '#FFFFFF', fontFamily: 'Microsoft YaHei', position: 'relative' }}>
  <Box style={{ position: 'absolute', top: 24, left: 60, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
    <Box style={{ width: 8, height: 24, background: '#7C3AED', borderRadius: 4 }} />
    <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W3D1</Text>
  </Box>
  <Text style={{ position: 'absolute', bottom: 24, right: 60, fontSize: 14, color: '#64748B' }}>17 / 18</Text>

  <Box style={{ flexDirection: 'column', height: '100%' }}>
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B' }}>现场作画：主项目架构草图</Text>
    <Box style={{ width: '100%', height: 1, background: '#E5E7EB', marginTop: 16, marginBottom: 24 }} />

    <Box style={{ flexDirection: 'row', gap: 28, flex: 1 }}>
      <Box style={{ flex: 0.85, flexDirection: 'column', gap: 18, justifyContent: 'center' }}>
        <Box style={{ background: 'linear-gradient(135deg, #4C1D95 0%, #7C3AED 100%)', borderRadius: 14, padding: '28px 24px', alignItems: 'center' }}>
          <Text style={{ fontSize: 52, fontWeight: 'bold', color: '#FFFFFF' }}>8 分钟</Text>
          <Text style={{ fontSize: 17, color: '#FFFFFF', opacity: 0.85, marginTop: 6 }}>计时开始，画出你的架构草图</Text>
        </Box>
        <Box style={{ background: '#F5F3FF', borderRadius: 12, padding: '16px 20px' }}>
          <Text style={{ fontSize: 17, color: '#1E1B4B' }}>画在导学案上，画完对照右侧清单自查</Text>
        </Box>
      </Box>

      <Box style={{ flex: 1.15, background: '#F5F3FF', borderRadius: 14, border: '1px solid #DDD6FE', padding: 24, flexDirection: 'column', gap: 14 }}>
        <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#7C3AED' }}>自查清单</Text>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12, background: '#FFFFFF', borderRadius: 10, padding: '14px 18px' }}>
          <Text style={{ fontSize: 20, color: '#16A34A', fontWeight: 'bold' }}>✓</Text>
          <Text style={{ fontSize: 18, color: '#1E1B4B' }}>四要素齐全：规划 / 记忆 / 工具 / 执行</Text>
        </Box>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12, background: '#FFFFFF', borderRadius: 10, padding: '14px 18px' }}>
          <Text style={{ fontSize: 20, color: '#16A34A', fontWeight: 'bold' }}>✓</Text>
          <Text style={{ fontSize: 18, color: '#1E1B4B' }}>标出人工接管点：哪里交还人类</Text>
        </Box>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12, background: '#FFFFFF', borderRadius: 10, padding: '14px 18px' }}>
          <Text style={{ fontSize: 20, color: '#16A34A', fontWeight: 'bold' }}>✓</Text>
          <Text style={{ fontSize: 18, color: '#1E1B4B' }}>标出步数与成本上限</Text>
        </Box>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12, background: '#FFFFFF', borderRadius: 10, padding: '14px 18px' }}>
          <Text style={{ fontSize: 20, color: '#16A34A', fontWeight: 'bold' }}>✓</Text>
          <Text style={{ fontSize: 18, color: '#1E1B4B' }}>列出工具清单：每个工具做什么</Text>
        </Box>
      </Box>
    </Box>
  </Box>
</Slide>
