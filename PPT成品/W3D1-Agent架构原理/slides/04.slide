    <Box style={{ flexDirection: 'row', gap: 24, marginTop: 24, flex: 1 }}>
      <Box style={{ flex: 1.4, background: '#F5F3FF', borderRadius: 14, padding: 16, alignItems: 'center', justifyContent: 'center' }}>
