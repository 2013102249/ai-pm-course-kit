<Slide style={{ width: 1280, height: 720, padding: 60, background: '#FFFFFF', fontFamily: 'Microsoft YaHei', position: 'relative' }}>
  <Box style={{ position: 'absolute', top: 24, left: 60, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
    <Box style={{ width: 8, height: 24, background: '#7C3AED', borderRadius: 4 }} />
    <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W3D1</Text>
  </Box>
  <Text style={{ position: 'absolute', bottom: 24, right: 60, fontSize: 14, color: '#64748B' }}>10 / 18</Text>

  <Box style={{ flexDirection: 'column', height: '100%' }}>
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B' }}>ReAct：把思考摊开给用户看</Text>
    <Box style={{ width: '100%', height: 1, background: '#E5E7EB', marginTop: 16, marginBottom: 24 }} />

    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16 }}>
      <Box style={{ flex: 1, background: '#7C3AED', borderRadius: 12, padding: '24px 20px', alignItems: 'center' }}>
        <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#FFFFFF' }}>思考</Text>
        <Text style={{ fontSize: 15, color: '#FFFFFF', opacity: 0.8, marginTop: 4 }}>下一步该做什么</Text>
      </Box>
      <Text style={{ fontSize: 28, color: '#64748B' }}>→</Text>
      <Box style={{ flex: 1, background: '#2563EB', borderRadius: 12, padding: '24px 20px', alignItems: 'center' }}>
        <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#FFFFFF' }}>行动</Text>
        <Text style={{ fontSize: 15, color: '#FFFFFF', opacity: 0.8, marginTop: 4 }}>调用工具动手做</Text>
      </Box>
      <Text style={{ fontSize: 28, color: '#64748B' }}>→</Text>
      <Box style={{ flex: 1, background: '#4C1D95', borderRadius: 12, padding: '24px 20px', alignItems: 'center' }}>
        <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#FFFFFF' }}>观察</Text>
        <Text style={{ fontSize: 15, color: '#FFFFFF', opacity: 0.8, marginTop: 4 }}>拿到结果再判断</Text>
      </Box>
    </Box>

    <Box style={{ marginTop: 16, background: '#F5F3FF', borderRadius: 10, padding: '12px 24px', alignItems: 'center', flexDirection: 'row', justifyContent: 'center', gap: 10 }}>
      <Text style={{ fontSize: 20, color: '#7C3AED', fontWeight: 'bold' }}>↺ 循环</Text>
      <Text style={{ fontSize: 17, color: '#1E1B4B' }}>观察结果回流到思考，直到完成任务</Text>
    </Box>

    <Box style={{ flexDirection: 'row', gap: 18, marginTop: 24, flex: 1 }}>
      <Box style={{ flex: 1, background: '#EFF6FF', borderRadius: 12, padding: 20, flexDirection: 'column', gap: 8, border: '1px solid #BFDBFE' }}>
        <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#2563EB' }}>可观测 → 信任</Text>
        <Text style={{ fontSize: 16, color: '#1E1B4B' }}>看得见过程，用户才敢用</Text>
      </Box>
      <Box style={{ flex: 1, background: '#EFF6FF', borderRadius: 12, padding: 20, flexDirection: 'column', gap: 8, border: '1px solid #BFDBFE' }}>
        <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#2563EB' }}>可中断</Text>
        <Text style={{ fontSize: 16, color: '#1E1B4B' }}>任何一步都能停下来</Text>
      </Box>
      <Box style={{ flex: 1, background: '#EFF6FF', borderRadius: 12, padding: 20, flexDirection: 'column', gap: 8, border: '1px solid #BFDBFE' }}>
        <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#2563EB' }}>可纠偏</Text>
        <Text style={{ fontSize: 16, color: '#1E1B4B' }}>方向错了随时能拉回来</Text>
      </Box>
    </Box>
  </Box>
</Slide>
