<Slide style={{ width: 1280, height: 720, padding: 60, background: '#FFFFFF', fontFamily: 'Microsoft YaHei', position: 'relative' }}>
  <Box style={{ position: 'absolute', top: 24, left: 60, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
    <Box style={{ width: 8, height: 24, background: '#7C3AED', borderRadius: 4 }} />
    <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W3D1</Text>
  </Box>
  <Text style={{ position: 'absolute', bottom: 24, right: 60, fontSize: 14, color: '#64748B' }}>11 / 18</Text>

  <Box style={{ flexDirection: 'column', height: '100%' }}>
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B' }}>ReAct 的呈现设计</Text>
    <Box style={{ width: '100%', height: 1, background: '#E5E7EB', marginTop: 16, marginBottom: 24 }} />

    <Box style={{ flexDirection: 'row', gap: 24, flex: 1 }}>
      <Box style={{ flex: 1, background: '#F5F3FF', borderRadius: 14, border: '1px solid #DDD6FE', padding: 24, flexDirection: 'column', gap: 14 }}>
        <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#7C3AED' }}>默认视图：步骤清单</Text>
        <Box style={{ background: '#FFFFFF', borderRadius: 10, padding: '12px 18px' }}>
          <Text style={{ fontSize: 17, color: '#1E1B4B' }}>一条步骤一行，随执行逐条点亮</Text>
        </Box>
        <Box style={{ background: '#FFFFFF', borderRadius: 10, padding: '12px 18px' }}>
          <Text style={{ fontSize: 17, color: '#1E1B4B' }}>默认收起，不打扰普通用户</Text>
        </Box>
        <Box style={{ background: '#FFFFFF', borderRadius: 10, padding: '12px 18px' }}>
          <Text style={{ fontSize: 17, color: '#1E1B4B' }}>失败步骤一眼可辨</Text>
        </Box>
      </Box>
      <Box style={{ flex: 1, background: '#EFF6FF', borderRadius: 14, border: '1px solid #BFDBFE', padding: 24, flexDirection: 'column', gap: 14 }}>
        <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#2563EB' }}>可展开详情</Text>
        <Box style={{ background: '#FFFFFF', borderRadius: 10, padding: '12px 18px' }}>
          <Text style={{ fontSize: 17, color: '#1E1B4B' }}>点开单步，看输入与输出</Text>
        </Box>
        <Box style={{ background: '#FFFFFF', borderRadius: 10, padding: '12px 18px' }}>
          <Text style={{ fontSize: 17, color: '#1E1B4B' }}>进阶用户与排障场景使用</Text>
        </Box>
        <Box style={{ background: '#FFFFFF', borderRadius: 10, padding: '12px 18px' }}>
          <Text style={{ fontSize: 17, color: '#1E1B4B' }}>层级清晰，不要一次全铺开</Text>
        </Box>
      </Box>
    </Box>

    <Box style={{ marginTop: 24, background: '#F5F3FF', borderRadius: 10, padding: '14px 24px' }}>
      <Text style={{ fontSize: 18, color: '#1E1B4B' }}><span style={{ fontWeight: 'bold', color: '#7C3AED' }}>反思机制</span>：失败后自我修正，但要设计「反思几次」的上限，避免原地打转</Text>
    </Box>
  </Box>
</Slide>
