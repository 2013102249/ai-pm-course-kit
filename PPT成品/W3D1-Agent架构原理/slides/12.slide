<Slide style={{ width: 1280, height: 720, padding: 60, background: '#FFFFFF', fontFamily: 'Microsoft YaHei', position: 'relative' }}>
  <Box style={{ position: 'absolute', top: 24, left: 60, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
    <Box style={{ width: 8, height: 24, background: '#7C3AED', borderRadius: 4 }} />
    <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W3D1</Text>
  </Box>
  <Text style={{ position: 'absolute', bottom: 24, right: 60, fontSize: 14, color: '#64748B' }}>12 / 18</Text>

  <Box style={{ flexDirection: 'column', height: '100%' }}>
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B' }}>MCP：工具的 USB 接口</Text>
    <Box style={{ width: '100%', height: 1, background: '#E5E7EB', marginTop: 16, marginBottom: 24 }} />

    <Box style={{ flexDirection: 'row', gap: 24, flex: 1, alignItems: 'stretch' }}>
      <Box style={{ flex: 1, background: '#FFFFFF', borderRadius: 14, border: '1px solid #E5E7EB', padding: 24, flexDirection: 'column', gap: 12, justifyContent: 'center' }}>
        <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#64748B' }}>没有统一协议</Text>
        <Text style={{ fontSize: 44, fontWeight: 'bold', color: '#DC2626' }}>M × N</Text>
        <Text style={{ fontSize: 18, color: '#1E1B4B' }}>M 个 Agent 对接 N 个工具，每对都要单独适配，组合爆炸</Text>
      </Box>
      <Box style={{ justifyContent: 'center', alignItems: 'center' }}>
        <Text style={{ fontSize: 36, color: '#7C3AED', fontWeight: 'bold' }}>→</Text>
      </Box>
      <Box style={{ flex: 1, background: '#F5F3FF', borderRadius: 14, border: '1px solid #DDD6FE', padding: 24, flexDirection: 'column', gap: 12, justifyContent: 'center' }}>
        <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#7C3AED' }}>有了统一协议</Text>
        <Text style={{ fontSize: 44, fontWeight: 'bold', color: '#16A34A' }}>M + N</Text>
        <Text style={{ fontSize: 18, color: '#1E1B4B' }}>各自实现一次协议，两两即可互通，适配成本线性化</Text>
      </Box>
    </Box>

    <Box style={{ marginTop: 24, flexDirection: 'row', gap: 18 }}>
      <Box style={{ flex: 1, background: '#EFF6FF', borderRadius: 10, padding: '14px 24px', border: '1px solid #BFDBFE' }}>
        <Text style={{ fontSize: 18, color: '#1E1B4B' }}><span style={{ fontWeight: 'bold', color: '#2563EB' }}>Anthropic 2024.11</span> 发布 MCP 开放协议</Text>
      </Box>
      <Box style={{ flex: 1, background: '#EFF6FF', borderRadius: 10, padding: '14px 24px', border: '1px solid #BFDBFE' }}>
        <Text style={{ fontSize: 18, color: '#1E1B4B' }}>类比：<span style={{ fontWeight: 'bold', color: '#2563EB' }}>USB 统一外设接口</span>，插上就能用</Text>
      </Box>
    </Box>
  </Box>
</Slide>
