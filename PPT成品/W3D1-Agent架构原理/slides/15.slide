<Slide style={{ width: 1280, height: 720, padding: 60, background: '#FFFFFF', fontFamily: 'Microsoft YaHei', position: 'relative' }}>
  <Box style={{ position: 'absolute', top: 24, left: 60, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
    <Box style={{ width: 8, height: 24, background: '#7C3AED', borderRadius: 4 }} />
    <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W3D1</Text>
  </Box>
  <Text style={{ position: 'absolute', bottom: 24, right: 60, fontSize: 14, color: '#64748B' }}>15 / 18</Text>

  <Box style={{ flexDirection: 'column', height: '100%' }}>
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B' }}>场景适配：该不该上 Agent</Text>
    <Box style={{ width: '100%', height: 1, background: '#E5E7EB', marginTop: 16, marginBottom: 24 }} />

    <Text style={{ fontSize: 20, color: '#64748B' }}>决策三问，依次往下走，能停在前面就不往后走</Text>

    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14, marginTop: 24, flex: 1 }}>
      <Box style={{ flex: 1, background: '#F5F3FF', borderRadius: 14, border: '1px solid #DDD6FE', padding: 24, flexDirection: 'column', gap: 10 }}>
        <Box style={{ width: 28, height: 28, background: '#7C3AED', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
          <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#FFFFFF' }}>1</Text>
        </Box>
        <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E1B4B' }}>单 Agent 能不能解决？</Text>
        <Text style={{ fontSize: 16, color: '#64748B' }}>一个模型加好提示词就能搞定，就别加架构</Text>
      </Box>
      <Text style={{ fontSize: 30, color: '#7C3AED', fontWeight: 'bold' }}>→</Text>
      <Box style={{ flex: 1, background: '#EFF6FF', borderRadius: 14, border: '1px solid #BFDBFE', padding: 24, flexDirection: 'column', gap: 10 }}>
        <Box style={{ width: 28, height: 28, background: '#7C3AED', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
          <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#FFFFFF' }}>2</Text>
        </Box>
        <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E1B4B' }}>要不要 Agent？</Text>
        <Text style={{ fontSize: 16, color: '#64748B' }}>需要多步执行、用工具、对结果负责时才上</Text>
      </Box>
      <Text style={{ fontSize: 30, color: '#7C3AED', fontWeight: 'bold' }}>→</Text>
      <Box style={{ flex: 1, background: '#F5F3FF', borderRadius: 14, border: '1px solid #DDD6FE', padding: 24, flexDirection: 'column', gap: 10 }}>
        <Box style={{ width: 28, height: 28, background: '#7C3AED', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
          <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#FFFFFF' }}>3</Text>
        </Box>
        <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E1B4B' }}>要不要多个？</Text>
        <Text style={{ fontSize: 16, color: '#64748B' }}>确有分工需求再拆 Multi-Agent</Text>
      </Box>
    </Box>
  </Box>
</Slide>
