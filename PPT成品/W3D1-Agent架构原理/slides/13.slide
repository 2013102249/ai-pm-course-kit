<Slide style={{ width: 1280, height: 720, padding: 60, background: '#FFFFFF', fontFamily: 'Microsoft YaHei', position: 'relative' }}>
  <Box style={{ position: 'absolute', top: 24, left: 60, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
    <Box style={{ width: 8, height: 24, background: '#7C3AED', borderRadius: 4 }} />
    <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W3D1</Text>
  </Box>
  <Text style={{ position: 'absolute', bottom: 24, right: 60, fontSize: 14, color: '#64748B' }}>13 / 18</Text>

  <Box style={{ flexDirection: 'column', height: '100%' }}>
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B' }}>产品经理的新杠杆</Text>
    <Box style={{ width: '100%', height: 1, background: '#E5E7EB', marginTop: 16, marginBottom: 24 }} />

    <Box style={{ flexDirection: 'column', gap: 16, flex: 1 }}>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 20, background: '#F5F3FF', borderRadius: 12, padding: '20px 24px' }}>
        <Box style={{ width: 28, height: 28, background: '#7C3AED', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
          <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#FFFFFF' }}>1</Text>
        </Box>
        <Box style={{ flexDirection: 'column', gap: 4 }}>
          <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#1E1B4B' }}>工具接入成本下降</Text>
          <Text style={{ fontSize: 17, color: '#64748B' }}>协议统一后，接一个新工具不再是重复工程</Text>
        </Box>
      </Box>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 20, background: '#EFF6FF', borderRadius: 12, padding: '20px 24px' }}>
        <Box style={{ width: 28, height: 28, background: '#7C3AED', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
          <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#FFFFFF' }}>2</Text>
        </Box>
        <Box style={{ flexDirection: 'column', gap: 4 }}>
          <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#1E1B4B' }}>工具生态成为选型考量</Text>
          <Text style={{ fontSize: 17, color: '#64748B' }}>选模型/选 Agent 平台时，把「工具面」纳入评估</Text>
        </Box>
      </Box>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 20, background: '#F5F3FF', borderRadius: 12, padding: '20px 24px' }}>
        <Box style={{ width: 28, height: 28, background: '#7C3AED', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
          <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#FFFFFF' }}>3</Text>
        </Box>
        <Box style={{ flexDirection: 'column', gap: 4 }}>
          <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#1E1B4B' }}>A2A 一句前瞻</Text>
          <Text style={{ fontSize: 17, color: '#64748B' }}>Agent 与 Agent 之间的互联协议，正在走同一条路</Text>
        </Box>
      </Box>
    </Box>

    <Box style={{ marginTop: 22, background: 'linear-gradient(135deg, #4C1D95 0%, #7C3AED 100%)', borderRadius: 12, padding: '16px 28px' }}>
      <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#FFFFFF' }}>工具侧 MCP，Agent 互联侧 A2A</Text>
    </Box>
  </Box>
</Slide>
