<Slide style={{ width: 1280, height: 720, padding: 60, background: '#FFFFFF', fontFamily: 'Microsoft YaHei', position: 'relative' }}>
  <Box style={{ position: 'absolute', top: 24, left: 60, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
    <Box style={{ width: 8, height: 24, background: '#7C3AED', borderRadius: 4 }} />
    <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W3D1</Text>
  </Box>
  <Text style={{ position: 'absolute', bottom: 24, right: 60, fontSize: 14, color: '#64748B' }}>14 / 18</Text>

  <Box style={{ flexDirection: 'column', height: '100%' }}>
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B' }}>Multi-Agent：复杂度黑洞</Text>
    <Box style={{ width: '100%', height: 1, background: '#E5E7EB', marginTop: 16, marginBottom: 24 }} />

    <Box style={{ background: '#F5F3FF', borderRadius: 10, padding: '14px 24px' }}>
      <Text style={{ fontSize: 17, color: '#64748B' }}>本页配合交互式架构图（Agent Tab）投屏讲解</Text>
    </Box>

    <Box style={{ flexDirection: 'row', gap: 18, marginTop: 26, flex: 1 }}>
      <Box style={{ flex: 1, background: '#7C3AED', borderRadius: 12, padding: 20, flexDirection: 'column', gap: 8 }}>
        <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#FFFFFF' }}>分工形态</Text>
        <Text style={{ fontSize: 16, color: '#FFFFFF', opacity: 0.85 }}>多个 Agent 各管一段，互相交接</Text>
      </Box>
      <Box style={{ flex: 1, background: '#FFFFFF', borderRadius: 12, border: '1px solid #DDD6FE', padding: 20, flexDirection: 'column', gap: 8 }}>
        <Text style={{ fontSize: 17, color: '#7C3AED', fontWeight: 'bold' }}>隐藏成本一</Text>
        <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1E1B4B' }}>协议</Text>
        <Text style={{ fontSize: 16, color: '#64748B' }}>Agent 之间怎么沟通，又是一层设计</Text>
      </Box>
      <Box style={{ flex: 1, background: '#FFFFFF', borderRadius: 12, border: '1px solid #DDD6FE', padding: 20, flexDirection: 'column', gap: 8 }}>
        <Text style={{ fontSize: 17, color: '#7C3AED', fontWeight: 'bold' }}>隐藏成本二</Text>
        <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1E1B4B' }}>损耗</Text>
        <Text style={{ fontSize: 16, color: '#64748B' }}>每次交接都可能丢信息、花 token</Text>
      </Box>
      <Box style={{ flex: 1, background: '#FFFFFF', borderRadius: 12, border: '1px solid #DDD6FE', padding: 20, flexDirection: 'column', gap: 8 }}>
        <Text style={{ fontSize: 17, color: '#7C3AED', fontWeight: 'bold' }}>隐藏成本三</Text>
        <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1E1B4B' }}>失败传播</Text>
        <Text style={{ fontSize: 16, color: '#64748B' }}>一个环节出错，层层放大</Text>
      </Box>
    </Box>
  </Box>
</Slide>
