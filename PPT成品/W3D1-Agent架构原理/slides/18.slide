<Slide style={{ width: 1280, height: 720, padding: 60, background: '#FFFFFF', fontFamily: 'Microsoft YaHei', position: 'relative' }}>
  <Box style={{ position: 'absolute', top: 24, left: 60, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
    <Box style={{ width: 8, height: 24, background: '#7C3AED', borderRadius: 4 }} />
    <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W3D1</Text>
  </Box>
  <Text style={{ position: 'absolute', bottom: 24, right: 60, fontSize: 14, color: '#64748B' }}>18 / 18</Text>

  <Box style={{ flexDirection: 'column', height: '100%' }}>
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B' }}>小结与作业</Text>
    <Box style={{ width: '100%', height: 1, background: '#E5E7EB', marginTop: 16, marginBottom: 22 }} />

    <Box style={{ flexDirection: 'row', gap: 28, flex: 1 }}>
      <Box style={{ flex: 1.25, flexDirection: 'column', gap: 16 }}>
        <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#7C3AED' }}>三句话收束</Text>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14, background: '#F5F3FF', borderRadius: 10, padding: '12px 18px' }}>
          <Box style={{ width: 28, height: 28, background: '#7C3AED', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
            <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#FFFFFF' }}>1</Text>
          </Box>
          <Text style={{ fontSize: 18, color: '#1E1B4B' }}>Agent = 长着四肢的大模型</Text>
        </Box>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14, background: '#EFF6FF', borderRadius: 10, padding: '12px 18px' }}>
          <Box style={{ width: 28, height: 28, background: '#7C3AED', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
            <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#FFFFFF' }}>2</Text>
          </Box>
          <Text style={{ fontSize: 18, color: '#1E1B4B' }}>工具侧 MCP，Agent 互联侧 A2A</Text>
        </Box>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14, background: '#F5F3FF', borderRadius: 10, padding: '12px 18px' }}>
          <Box style={{ width: 28, height: 28, background: '#7C3AED', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
            <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#FFFFFF' }}>3</Text>
          </Box>
          <Text style={{ fontSize: 18, color: '#1E1B4B' }}>该不该上 Agent，先过决策三问</Text>
        </Box>

        <Box style={{ marginTop: 8, background: '#FFFFFF', borderRadius: 12, border: '1px solid #DDD6FE', padding: 18, flexDirection: 'column', gap: 8 }}>
          <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#7C3AED' }}>作业（周五评审用）</Text>
          <Text style={{ fontSize: 17, color: '#1E1B4B' }}>① 完善今天的架构草图，形成完整架构图</Text>
          <Text style={{ fontSize: 17, color: '#1E1B4B' }}>② 抄录本课金句，写一句自己的理解</Text>
        </Box>
        <Text style={{ fontSize: 16, color: '#64748B' }}>预告：W3D2 Agent 产品设计与工作流实操</Text>
      </Box>

      <Box style={{ flex: 0.9, background: '#F5F3FF', borderRadius: 14, padding: 14, flexDirection: 'column', alignItems: 'center', justifyContent: 'center', gap: 10 }}>
        <Image src="assets/agent-four-elements.svg" style={{ width: '100%', height: 300, objectFit: 'contain' }} />
        <Text style={{ fontSize: 15, color: '#64748B' }}>带着这张图回家，把它画进主项目</Text>
      </Box>
    </Box>
  </Box>
</Slide>
