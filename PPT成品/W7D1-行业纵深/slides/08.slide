<Slide style={{ width: 1280, height: 720, padding: 60, background: '#FFFFFF', fontFamily: "'Microsoft YaHei', 'PingFang SC', sans-serif", position: 'relative' }}>
  <Box style={{ position: 'absolute', top: 24, left: 60, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
    <Box style={{ width: 8, height: 24, background: '#7C3AED', borderRadius: 4 }} />
    <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W7D1</Text>
  </Box>
  <Box style={{ position: 'absolute', bottom: 24, right: 60 }}>
    <Text style={{ fontSize: 14, color: '#64748B' }}>08 / 12</Text>
  </Box>
  <Box>
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B' }}>分组规则与角色分工</Text>
    <Box style={{ width: '100%', height: 1, background: '#E5E7EB', marginTop: 16 }} />
  </Box>
  <Box style={{ marginTop: 28, flexDirection: 'row', gap: 24 }}>
    <Box style={{ width: 640, background: '#F5F3FF', borderRadius: 14, padding: '26px 30px' }}>
      <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#7C3AED' }}>按六大赛道分组</Text>
      <Box style={{ flexDirection: 'row', alignItems: 'flex-end', gap: 14, marginTop: 16 }}>
        <Text style={{ fontSize: 48, fontWeight: 'bold', color: '#2563EB' }}>4–8 人</Text>
        <Text style={{ fontSize: 18, color: '#1E1B4B', paddingBottom: 8 }}>每组人数</Text>
      </Box>
      <Box style={{ background: '#FFFFFF', border: '1px solid #DDD6FE', borderRadius: 10, padding: '14px 20px', marginTop: 20 }}>
        <Text style={{ fontSize: 18, color: '#1E1B4B', lineHeight: 1.5 }}>不足 4 人 → <span style={{ fontWeight: 'bold' }}>并入备选赛道组</span></Text>
      </Box>
    </Box>
    <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #E5E7EB', borderRadius: 14, padding: '26px 30px' }}>
      <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#7C3AED' }}>每组三个角色</Text>
      <Box style={{ marginTop: 18, gap: 14 }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14 }}>
          <Box style={{ width: 28, height: 28, background: '#7C3AED', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
            <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#FFFFFF' }}>1</Text>
          </Box>
          <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1E1B4B' }}>组长</Text>
        </Box>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14 }}>
          <Box style={{ width: 28, height: 28, background: '#7C3AED', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
            <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#FFFFFF' }}>2</Text>
          </Box>
          <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1E1B4B' }}>记录员</Text>
        </Box>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14 }}>
          <Box style={{ width: 28, height: 28, background: '#7C3AED', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
            <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#FFFFFF' }}>3</Text>
          </Box>
          <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1E1B4B' }}>计时员</Text>
        </Box>
      </Box>
    </Box>
  </Box>
</Slide>
