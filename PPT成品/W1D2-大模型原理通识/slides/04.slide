<Slide style={{ width: 1280, height: 720, padding: 60, background: '#FFFFFF' }}>
    <Box style={{ position: 'absolute', top: 24, left: 60, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
        <Box style={{ width: 8, height: 24, background: '#7C3AED', borderRadius: 4 }} />
        <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W1D2</Text>
    </Box>
    <Text style={{ fontSize: 14, color: '#64748B', position: 'absolute', right: 60, bottom: 34 }}>04 / 16</Text>
    <Box style={{ gap: 18 }}>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B' }}>核心类比：超级接话员</Text>
        <Box style={{ width: '100%', height: 1, background: '#E5E7EB' }} />
    </Box>
    <Box style={{ flex: 1, flexDirection: 'row', gap: 28, alignItems: 'center' }}>
        <Box style={{ width: 380, height: 420, background: '#7C3AED', borderRadius: 16, padding: 36, justifyContent: 'center', gap: 18 }}>
            <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#FFFFFF' }}>超级接话员</Text>
            <Text style={{ fontSize: 18, color: 'rgba(255,255,255,0.85)', lineHeight: 1.6 }}>他读过全世界所有的书，<br />但没人教过他回答问题。</Text>
            <Box style={{ width: 48, height: 4, background: 'rgba(255,255,255,0.5)', borderRadius: 2 }} />
            <Text style={{ fontSize: 16, color: 'rgba(255,255,255,0.75)', lineHeight: 1.6 }}>大模型就是这个角色：<br />满腹经纶，却只会接着往下说。</Text>
        </Box>
        <Box style={{ flex: 1, gap: 20 }}>
            <Box style={{ background: '#F5F3FF', borderRadius: 12, padding: '22px 26px', gap: 8 }}>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1E1B4B' }}>他会的：接话</Text>
                <Text style={{ fontSize: 17, color: '#4A4560' }}>读过海量文本，语言规律与世界知识都在脑子里</Text>
            </Box>
            <Box style={{ background: '#F5F3FF', borderRadius: 12, padding: '22px 26px', gap: 8 }}>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1E1B4B' }}>他不会的：回答问题</Text>
                <Text style={{ fontSize: 17, color: '#4A4560' }}>没人教过他「怎么好好回答」，只会顺着说下去</Text>
            </Box>
            <Box style={{ background: '#FFFFFF', border: '1.5px solid #7C3AED', borderRadius: 12, padding: '22px 26px', gap: 8 }}>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#7C3AED' }}>你问：「你们的退款政策是什么？」</Text>
                <Text style={{ fontSize: 17, color: '#1E1B4B' }}>他没学过这条政策，但会<span style={{ fontWeight: 'bold' }}>自信地编一个</span>——这就是幻觉的来源</Text>
            </Box>
        </Box>
    </Box>
</Slide>
