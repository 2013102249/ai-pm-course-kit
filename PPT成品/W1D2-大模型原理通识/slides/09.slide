<Slide style={{ width: 1280, height: 720, padding: 60, background: '#FFFFFF' }}>
    <Box style={{ position: 'absolute', top: 24, left: 60, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
        <Box style={{ width: 8, height: 24, background: '#7C3AED', borderRadius: 4 }} />
        <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W1D2</Text>
    </Box>
    <Text style={{ fontSize: 14, color: '#64748B', position: 'absolute', right: 60, bottom: 34 }}>09 / 16</Text>
    <Box style={{ gap: 18 }}>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B' }}>第一阶段：预训练 = 读书</Text>
        <Box style={{ width: '100%', height: 1, background: '#E5E7EB' }} />
    </Box>
    <Box style={{ flex: 1, justifyContent: 'center', gap: 22 }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 20, background: '#F5F3FF', borderRadius: 14, padding: '26px 30px' }}>
            <Box style={{ width: 28, height: 28, background: '#7C3AED', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
                <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>1</Text>
            </Box>
            <Box style={{ flex: 1, gap: 8 }}>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1E1B4B' }}>训练方式：遮住后半句，让它接着说</Text>
                <Text style={{ fontSize: 18, color: '#4A4560' }}>「今天天气真好，<span style={{ color: '#7C3AED', fontWeight: 'bold' }}>______</span>」——把海量文本都这样练接话</Text>
            </Box>
        </Box>
        <Box style={{ flexDirection: 'row', gap: 24 }}>
            <Box style={{ flex: 1, background: '#EFF6FF', borderRadius: 14, padding: '24px 28px', gap: 10 }}>
                <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#2563EB' }}>读书读出了什么</Text>
                <Text style={{ fontSize: 18, color: '#1E1B4B', lineHeight: 1.7 }}>学会了语言规律与世界知识，<br />上到唐诗宋词，下到网络热梗</Text>
            </Box>
            <Box style={{ flex: 1, background: '#FFFFFF', border: '1.5px solid #E5E7EB', borderRadius: 14, padding: '24px 28px', gap: 10 }}>
                <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#1E1B4B' }}>但读不出什么</Text>
                <Text style={{ fontSize: 18, color: '#4A4560', lineHeight: 1.7 }}>只会续写，不会「回答问题」——<br />你问它一句，它更想帮你把话说完</Text>
            </Box>
        </Box>
        <Box style={{ background: '#F5F3FF', borderRadius: 12, padding: '16px 24px' }}>
            <Text style={{ fontSize: 18, color: '#1E1B4B' }}>所以：只会接话的「读书人」，<span style={{ fontWeight: 'bold', color: '#7C3AED' }}>还不能直接上岗</span></Text>
        </Box>
    </Box>
</Slide>
