        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B' }}>Transformer：看全文再接话</Text>
        <Box style={{ width: '100%', height: 1, background: '#E5E7EB' }} />
    </Box>
    <Box style={{ flex: 1, flexDirection: 'row', gap: 28, alignItems: 'center' }}>
        <Box style={{ width: 360, gap: 20 }}>
            <Box style={{ background: '#F5F3FF', borderRadius: 14, padding: '26px 28px', gap: 10 }}>
                <Text style={{ fontSize: 40, fontWeight: 'bold', color: '#7C3AED' }}>2017</Text>
                <Text style={{ fontSize: 18, color: '#1E1B4B' }}>Google 提出 Transformer，<br />大模型的地基技术</Text>
            </Box>
            <Box style={{ background: '#EFF6FF', borderRadius: 14, padding: '26px 28px', gap: 10 }}>
                <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#2563EB' }}>自注意力</Text>
                <Text style={{ fontSize: 17, color: '#1E1B4B', lineHeight: 1.6 }}>接话之前，先把全文看一遍，<br />搞清楚每个词指的是谁</Text>
            </Box>
        </Box>
        <Box style={{ flex: 1, gap: 18 }}>
            <Box style={{ background: '#FFFFFF', border: '1.5px solid #E5E7EB', borderRadius: 14, padding: '28px 30px', gap: 14 }}>
                <Text style={{ fontSize: 15, color: '#64748B' }}>例句现场演示</Text>
                <Text style={{ fontSize: 24, color: '#1E1B4B', lineHeight: 1.6 }}>小明把书递给小刚，因为<span style={{ fontWeight: 'bold', color: '#7C3AED' }}>「他」</span>还要去开会。</Text>
                <Box style={{ height: 1, background: '#E5E7EB' }} />
                <Text style={{ fontSize: 18, color: '#4A4560', lineHeight: 1.7 }}>问：<span style={{ fontWeight: 'bold', color: '#7C3AED' }}>「他」</span>指的是谁？<br />模型不是瞎猜——它先回看全文，结合「递书」「去开会」的语境判断「他」是谁，再决定怎么接话。</Text>
            </Box>
            <Box style={{ background: '#F5F3FF', borderRadius: 12, padding: '16px 24px' }}>
                <Text style={{ fontSize: 17, color: '#1E1B4B' }}>本课只讲到这里：<span style={{ fontWeight: 'bold', color: '#7C3AED' }}>不碰任何公式</span>，记住「看全文再接话」就够了</Text>
            </Box>
        </Box>
    </Box>
