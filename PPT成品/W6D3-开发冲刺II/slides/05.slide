<Slide style={{ width: 1280, height: 720, padding: 60, background: '#FFFFFF', fontFamily: 'Microsoft YaHei', position: 'relative' }}>
  <Box style={{ position: 'absolute', top: 24, left: 60, flexDirection: 'row', alignItems: 'center', gap: 8 }}>
    <Box style={{ width: 8, height: 24, background: '#7C3AED', borderRadius: 4 }} />
    <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W6D3</Text>
  </Box>
  <Text style={{ position: 'absolute', bottom: 24, left: 60, fontSize: 14, color: '#64748B' }}>W6D3 · 开发冲刺 II</Text>
  <Text style={{ position: 'absolute', bottom: 24, right: 60, fontSize: 14, color: '#64748B' }}>05 / 8</Text>

  <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B' }}>分组互查规则</Text>
  <Box style={{ width: '100%', height: 1, background: '#E5E7EB', marginTop: 14, marginBottom: 24 }} />

  <Box style={{ flexDirection: 'row', gap: 32, width: '100%' }}>
    <Box style={{ flex: 1, flexDirection: 'column', gap: 20 }}>
      {[
        { n: '1', t: '跨项目配对', d: '2 人一组，检查别人的项目' },
        { n: '2', t: '一轮 30 分钟', d: '20 分钟演示 + 10 分钟记录' },
        { n: '3', t: '两轮互换角色', d: '每一轮都既演示也检查' },
        { n: '4', t: '只对项目不对人', d: '问题写进记录，不做评价' },
      ].map((item, idx) => (
        <Box key={idx} style={{ flexDirection: 'row', alignItems: 'flex-start', gap: 14 }}>
          <Box style={{ width: 28, height: 28, background: '#7C3AED', borderRadius: 6, alignItems: 'center', justifyContent: 'center', marginTop: 3 }}>
            <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FFFFFF' }}>{item.n}</Text>
          </Box>
          <Box style={{ flexDirection: 'column', gap: 4 }}>
            <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#1E1B4B' }}>{item.t}</Text>
            <Text style={{ fontSize: 17, color: '#64748B' }}>{item.d}</Text>
          </Box>
        </Box>
      ))}
    </Box>
    <Box style={{ width: 480, border: '1px solid #E5E7EB', borderRadius: 12, padding: 6, background: '#FFFFFF' }}>
      <Table
        style={{ width: '100%', height: 196 }}
        defaultTextStyle={{ fontSize: 17, textAlign: 'center', color: '#1E1B4B' }}
        defaultCellStyle={{
          border: { bottom: { width: 1, color: '#7C3AED' } },
          verticalAlign: 'middle',
        }}
        cells={[
          [
            { text: '轮次', textStyle: { bold: true, color: '#FFFFFF', fontSize: 16 }, cellStyle: { background: { color: '#7C3AED' } } },
            { text: '演示方', textStyle: { bold: true, color: '#FFFFFF', fontSize: 16 }, cellStyle: { background: { color: '#7C3AED' } } },
            { text: '检查方', textStyle: { bold: true, color: '#FFFFFF', fontSize: 16 }, cellStyle: { background: { color: '#7C3AED' } } },
            { text: '时长', textStyle: { bold: true, color: '#FFFFFF', fontSize: 16 }, cellStyle: { background: { color: '#7C3AED' } } },
          ],
          [
            { text: '第一轮', textStyle: { bold: true, color: '#7C3AED' } },
            'A',
            'B',
            '30 分钟',
          ],
          [
            { text: '第二轮', textStyle: { bold: true, color: '#7C3AED' }, cellStyle: { background: { color: '#F5F3FF' } } },
            { text: 'B', cellStyle: { background: { color: '#F5F3FF' } } },
            { text: 'A', cellStyle: { background: { color: '#F5F3FF' } } },
            { text: '30 分钟', cellStyle: { background: { color: '#F5F3FF' } } },
          ],
        ]}
      />
      <Text style={{ marginTop: 14, fontSize: 16, color: '#64748B', textAlign: 'center' }}>配对名单现场投屏公布，落位 2 分钟</Text>
    </Box>
  </Box>
</Slide>
