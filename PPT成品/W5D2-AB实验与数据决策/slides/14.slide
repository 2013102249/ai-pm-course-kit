        <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#1E1B4B' }}>灰度观察</Text>
        <Text style={{ fontSize: 16, color: '#64748B', lineHeight: 1.6 }}>弱点：小流量样本少、波动大，只能看方向</Text>
      </Box>
      <Box style={{ flex: 1, background: '#EFF6FF', borderRadius: 12, padding: 22, flexDirection: 'column', justifyContent: 'center', gap: 10 }}>
        <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#1E1B4B' }}>访谈三角验证</Text>
        <Text style={{ fontSize: 16, color: '#64748B', lineHeight: 1.6 }}>弱点：样本少、主观性强，能解释不能量化</Text>
