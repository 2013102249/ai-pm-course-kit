  <Text style={{ position: 'absolute', bottom: 32, right: 60, fontSize: 14, color: '#64748B' }}>14 / 16</Text>
  <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#1E1B4B' }}>从数据到决策：三道闸 + 无实验条件怎么办</Text>
  <Box style={{ width: '100%', height: 1, background: '#E5E7EB', marginTop: 16 }} />
  <Box style={{ flexDirection: 'column', flex: 1, marginTop: 22, gap: 16 }}>
