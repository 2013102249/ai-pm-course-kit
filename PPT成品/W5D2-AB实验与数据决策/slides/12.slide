            bottom: { width: 1, color: '#E5E7EB' },
          },
        }}
        cells={[
          [
            { text: '分组', textStyle: { fontSize: 18, fontWeight: 'bold', color: '#FFFFFF' }, cellStyle: { background: { color: '#7C3AED' } } },
            { text: 'A 组', textStyle: { fontSize: 18, fontWeight: 'bold', color: '#FFFFFF' }, cellStyle: { background: { color: '#7C3AED' } } },
            { text: 'B 组', textStyle: { fontSize: 18, fontWeight: 'bold', color: '#FFFFFF' }, cellStyle: { background: { color: '#7C3AED' } } },
          ],
          [
            { text: '整体', cellStyle: { background: { color: '#F5F3FF' } } },
            { text: '5.0%', cellStyle: { background: { color: '#F5F3FF' } } },
