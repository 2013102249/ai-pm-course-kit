          [
            { text: 'Android', cellStyle: { background: { color: '#EFF6FF' } } },
            { text: '3%', textStyle: { fontSize: 18, fontWeight: 'bold', color: '#16A34A' }, cellStyle: { background: { color: '#EFF6FF' } } },
            { text: '2.5%', cellStyle: { background: { color: '#EFF6FF' } } },
          ],
        ]}
      />
      <Text style={{ fontSize: 15, color: '#64748B', marginTop: 14, textAlign: 'center' }}>绿色 = 该组转化率更高</Text>
