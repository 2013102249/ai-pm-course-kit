  <Box style={{ width: '100%', height: 1, background: '#E5E7EB', marginTop: 18 }} />
  <Box style={{ flexDirection: 'row', flex: 1, marginTop: 28, gap: 24, alignItems: 'center' }}>
    <Box style={{ width: 620, border: '1px solid #E5E7EB', borderRadius: 12, background: '#FFFFFF', padding: 16 }}>
      <Table
        style={{ width: '100%', height: 248 }}
        defaultTextStyle={{ fontSize: 18, textAlign: 'center', color: '#1E1B4B', fontFamily: 'Menlo, Monaco, monospace' }}
        defaultCellStyle={{
          border: {
