<Slide style={{ width: 1280, height: 720, padding: 60, background: '#FFFFFF', fontFamily: 'Microsoft YaHei' }}>
  <Box style={{ position: 'absolute', top: 24, left: 60, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
    <Box style={{ width: 8, height: 24, background: '#7C3AED', borderRadius: 2 }} />
    <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W7D2</Text>
  </Box>
  <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B' }}>数据呈现三原则</Text>
  <Box style={{ width: '100%', height: 1, background: '#E5E7EB', marginTop: 16 }} />
  <Box style={{ flexDirection: 'column', gap: 16, marginTop: 24 }}>
    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 22, background: '#F5F3FF', borderRadius: 12, height: 92, paddingLeft: 30, paddingRight: 30 }}>
      <Box style={{ width: 28, height: 28, background: '#7C3AED', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FFFFFF' }}>1</Text>
      </Box>
      <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E1B4B', width: 230 }}>对比才有意义</Text>
      <Text style={{ flex: 1, fontSize: 18, color: '#64748B' }}>基准值 → 结果值，先给基准再给结果</Text>
    </Box>
    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 22, background: '#F5F3FF', borderRadius: 12, height: 92, paddingLeft: 30, paddingRight: 30 }}>
      <Box style={{ width: 28, height: 28, background: '#7C3AED', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FFFFFF' }}>2</Text>
      </Box>
      <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E1B4B', width: 230 }}>图表选型</Text>
      <Text style={{ flex: 1, fontSize: 18, color: '#64748B' }}>一图一结论：趋势折线 / 对比条形 / 构成堆叠，禁 3D</Text>
    </Box>
    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 22, background: '#F5F3FF', borderRadius: 12, height: 92, paddingLeft: 30, paddingRight: 30 }}>
      <Box style={{ width: 28, height: 28, background: '#7C3AED', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FFFFFF' }}>3</Text>
      </Box>
      <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E1B4B', width: 230 }}>标注来源</Text>
      <Text style={{ flex: 1, fontSize: 18, color: '#64748B' }}>每个数字都可被追问来源</Text>
    </Box>
  </Box>
  <Box style={{ background: '#7C3AED', borderRadius: 10, marginTop: 24, height: 80, alignItems: 'center', justifyContent: 'center' }}>
    <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#FFFFFF' }}>没有基准的数字是广告，有来源的数字才是证据</Text>
  </Box>
  <Box style={{ position: 'absolute', bottom: 24, right: 60 }}>
    <Text style={{ fontSize: 14, color: '#64748B' }}>13 / 16</Text>
  </Box>
</Slide>
