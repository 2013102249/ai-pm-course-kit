      <Text style={{ fontSize: 16, color: 'rgba(255,255,255,0.9)' }}>写决策</Text>
    </Box>
    <Box style={{ flex: 1, background: '#F5F3FF', borderRadius: 12, flexDirection: 'row', alignItems: 'center', justifyContent: 'center', gap: 10 }}>
      <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#7C3AED' }}>R</Text>
