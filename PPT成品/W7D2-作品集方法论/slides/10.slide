  </Box>
  <Box style={{ flexDirection: 'row', gap: 24, marginTop: 20, height: 210 }}>
    <Box style={{ flex: 1, background: '#FEF2F2', borderRadius: 14, padding: 24 }}>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
        <Box style={{ width: 32, height: 32, borderRadius: 16, background: '#DC2626', alignItems: 'center', justifyContent: 'center' }}>
