        </Box>
        <Box style={{ flexDirection: 'row', gap: 18 }}>
            <Box style={{ flex: 1, background: '#F5F3FF', borderRadius: 12, padding: '24px 24px', gap: 8, alignItems: 'center' }}>
                <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E1B4B' }}>汇报人</Text>
                <Text style={{ fontSize: 16, color: '#64748B' }}>用三段结构讲 3 分钟</Text>
            </Box>
            <Box style={{ flex: 1, background: '#EFF6FF', borderRadius: 12, padding: '24px 24px', gap: 8, alignItems: 'center' }}>
                <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E1B4B' }}>上级扮演者</Text>
                <Text style={{ fontSize: 16, color: '#64748B' }}>听结论、挑数字、要请求</Text>
            </Box>
            <Box style={{ flex: 1, background: '#F5F3FF', borderRadius: 12, padding: '24px 24px', gap: 8, alignItems: 'center' }}>
                <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E1B4B' }}>观察员</Text>
                <Text style={{ fontSize: 16, color: '#64748B' }}>按三维互评表记录打分</Text>
