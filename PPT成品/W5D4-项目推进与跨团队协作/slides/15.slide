<Slide style={{ width: 1280, height: 720, padding: 60, background: '#FFFFFF' }}>
    <Box style={{ position: 'absolute', top: 24, left: 60, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
        <Box style={{ width: 8, height: 24, background: '#7C3AED', borderRadius: 4 }} />
        <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W5D4</Text>
    </Box>
    <Box style={{ position: 'absolute', bottom: 24, right: 60 }}>
        <Text style={{ fontSize: 14, color: '#64748B' }}>15 / 16</Text>
    </Box>
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B', lineHeight: 1.2 }}>汇报演练：三人组规则</Text>
    <Box style={{ height: 1, background: '#E5E7EB', marginTop: 16 }} />
    <Box style={{ flex: 1, justifyContent: 'center', gap: 24 }}>
        <Box style={{ background: '#F5F3FF', borderRadius: 10, padding: '14px 26px', alignItems: 'center' }}>
