        <Box style={{ flexDirection: 'row', gap: 18 }}>
            <Box style={{ flex: 1, background: '#7C3AED', borderRadius: 10, padding: '16px 26px', alignItems: 'center' }}>
                <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#FFFFFF' }}>时间盒：每人 3 分钟，轮转进行</Text>
            </Box>
            <Box style={{ flex: 1, background: '#EFF6FF', border: '1px solid #2563EB', borderRadius: 10, padding: '16px 26px', alignItems: 'center' }}>
