        <Box style={{ width: 1160, height: 1, background: '#E5E7EB' }} />
    </Box>
    <Box style={{ position: 'relative', marginTop: 24, flexDirection: 'row', gap: 36 }}>
        <Box style={{ width: 620, gap: 14 }}>
            <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#7C3AED' }}>五项产出（按导学案模板逐项填写）</Text>
            {['aha 时刻假设', '激活路径', '前 1000 用户冷启动计划', '留存抓手', '裂变机制评估'].map((item, idx) => (
                <Box key={idx} style={{ flexDirection: 'row', alignItems: 'center', gap: 16, padding: '13px 22px', background: '#F5F3FF', borderRadius: 10 }}>
                    <Box style={{ width: 28, height: 28, background: '#7C3AED', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
                        <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#FFFFFF' }}>{idx + 1}</Text>
                    </Box>
                    <Text style={{ fontSize: 19, color: '#1E1B4B' }}>{item}</Text>
                </Box>
            ))}
        </Box>
        <Box style={{ flex: 1, gap: 18 }}>
            <Box style={{ padding: '24px 26px', background: '#EFF6FF', borderRadius: 14, gap: 14 }}>
                <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#2563EB' }}>时间盒：15 + 7 + 3 分钟</Text>
                <Box style={{ flexDirection: 'row', gap: 12 }}>
                    <Box style={{ flex: 1, padding: '14px 10px', background: '#FFFFFF', borderRadius: 10, alignItems: 'center', gap: 4 }}>
                        <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#7C3AED' }}>15</Text>
                        <Text style={{ fontSize: 14, color: '#64748B', textAlign: 'center' }}>分钟填写方案</Text>
                    </Box>
                    <Box style={{ flex: 1, padding: '14px 10px', background: '#FFFFFF', borderRadius: 10, alignItems: 'center', gap: 4 }}>
                        <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#7C3AED' }}>7</Text>
                        <Text style={{ fontSize: 14, color: '#64748B', textAlign: 'center' }}>分钟两人互评</Text>
                    </Box>
                    <Box style={{ flex: 1, padding: '14px 10px', background: '#FFFFFF', borderRadius: 10, alignItems: 'center', gap: 4 }}>
                        <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#7C3AED' }}>3</Text>
                        <Text style={{ fontSize: 14, color: '#64748B', textAlign: 'center' }}>分钟巡场追问与展示</Text>
                    </Box>
