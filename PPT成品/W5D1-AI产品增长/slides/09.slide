<Slide style={{ width: 1280, height: 720, padding: 60, background: '#FFFFFF', fontFamily: 'Microsoft YaHei' }}>
    <Box style={{ position: 'absolute', top: 24, left: 60, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
        <Box style={{ width: 8, height: 24, background: '#7C3AED', borderRadius: 2 }} />
        <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W5D1</Text>
    </Box>
    <Box style={{ position: 'absolute', right: 60, bottom: 40 }}>
        <Text style={{ fontSize: 14, color: '#64748B' }}>09 / 16</Text>
    </Box>
    <Box style={{ position: 'relative', gap: 18 }}>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B' }}>留存：aha 时刻的反复重现</Text>
        <Box style={{ width: 1160, height: 1, background: '#E5E7EB' }} />
    </Box>
    <Box style={{ position: 'relative', marginTop: 28, flexDirection: 'row', gap: 36 }}>
        <Box style={{ width: 640, gap: 20 }}>
            <Text style={{ fontSize: 19, color: '#1E1B4B' }}>留存的本质，是让用户每一次使用都再次体验到核心价值。三个抓手：</Text>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16, padding: '20px 24px', background: '#F5F3FF', borderRadius: 12, borderLeft: '5px solid #7C3AED' }}>
                <Box style={{ width: 28, height: 28, background: '#7C3AED', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#FFFFFF' }}>1</Text>
                </Box>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1E1B4B' }}>历史可积累</Text>
                <Text style={{ fontSize: 16, color: '#64748B' }}>历史产出越用越有价值</Text>
            </Box>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16, padding: '20px 24px', background: '#EFF6FF', borderRadius: 12, borderLeft: '5px solid #2563EB' }}>
                <Box style={{ width: 28, height: 28, background: '#2563EB', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#FFFFFF' }}>2</Text>
                </Box>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1E1B4B' }}>越用越准</Text>
                <Text style={{ fontSize: 16, color: '#64748B' }}>个性化随使用持续增值</Text>
            </Box>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16, padding: '20px 24px', background: '#F5F3FF', borderRadius: 12, borderLeft: '5px solid #7C3AED' }}>
                <Box style={{ width: 28, height: 28, background: '#7C3AED', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#FFFFFF' }}>3</Text>
                </Box>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1E1B4B' }}>嵌入工作流</Text>
                <Text style={{ fontSize: 16, color: '#64748B' }}>成为用户既有流程的默认工具</Text>
            </Box>
        </Box>
        <Box style={{ flex: 1, padding: '36px 32px', background: '#7C3AED', borderRadius: 16, justifyContent: 'center', gap: 16 }}>
            <Text style={{ fontSize: 16, color: 'rgba(255,255,255,0.7)' }}>本课最重要的一句话</Text>
            <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#FFFFFF', lineHeight: 1.4 }}>「留存只看 DAU」<br />是错误习惯</Text>
            <Text style={{ fontSize: 16, color: 'rgba(255,255,255,0.8)' }}>推送只能把人拉回来一次，<br />拉不回第二次。</Text>
        </Box>
    </Box>
</Slide>
