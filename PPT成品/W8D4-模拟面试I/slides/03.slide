<Slide style={{ width: 1280, height: 720, padding: 60, background: '#FFFFFF' }}>
  <Box style={{ position: 'absolute', top: 24, left: 60, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
    <Box style={{ width: 8, height: 24, background: '#7C3AED', borderRadius: 2 }} />
    <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W8D4</Text>
  </Box>
  <Box style={{ position: 'absolute', right: 60, bottom: 26 }}>
    <Text style={{ fontSize: 14, color: '#64748B' }}>03 / 6</Text>
  </Box>
  <Box style={{ flexDirection: 'column', height: '100%', gap: 14 }}>
    <Box style={{ flexDirection: 'column', gap: 14 }}>
      <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#1E1B4B' }}>评分四维与三档</Text>
      <Box style={{ width: '100%', height: 1, background: '#E5E7EB' }} />
    </Box>
    <Box style={{ flexDirection: 'row', gap: 24, flex: 1 }}>
      <Box style={{ flex: 1.15, flexDirection: 'column', gap: 12 }}>
        <Box style={{ background: '#F5F3FF', borderRadius: 10, padding: '14px 20px', flexDirection: 'row', alignItems: 'center', gap: 16 }}>
          <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#1E1B4B', width: 76 }}>内容</Text>
          <Text style={{ fontSize: 40, fontWeight: 'bold', color: '#7C3AED', width: 104 }}><span>40</span><span style={{ fontSize: 18 }}> 分</span></Text>
          <Text style={{ fontSize: 18, color: '#64748B', flex: 1 }}>二档判据：要点都在，但没有案例与数据支撑</Text>
        </Box>
        <Box style={{ background: '#FFFFFF', border: '1px solid #E5E7EB', borderRadius: 10, padding: '14px 20px', flexDirection: 'row', alignItems: 'center', gap: 16 }}>
          <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#1E1B4B', width: 76 }}>结构</Text>
          <Text style={{ fontSize: 40, fontWeight: 'bold', color: '#7C3AED', width: 104 }}><span>30</span><span style={{ fontSize: 18 }}> 分</span></Text>
          <Text style={{ fontSize: 18, color: '#64748B', flex: 1 }}>二档判据：有框架，但层次乱、抓不住重点</Text>
        </Box>
        <Box style={{ background: '#F5F3FF', borderRadius: 10, padding: '14px 20px', flexDirection: 'row', alignItems: 'center', gap: 16 }}>
          <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#1E1B4B', width: 76 }}>表达</Text>
          <Text style={{ fontSize: 40, fontWeight: 'bold', color: '#7C3AED', width: 104 }}><span>20</span><span style={{ fontSize: 18 }}> 分</span></Text>
          <Text style={{ fontSize: 18, color: '#64748B', flex: 1 }}>二档判据：说得清，但节奏不稳、带口头禅</Text>
        </Box>
        <Box style={{ background: '#FFFFFF', border: '1px solid #E5E7EB', borderRadius: 10, padding: '14px 20px', flexDirection: 'row', alignItems: 'center', gap: 16 }}>
          <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#1E1B4B', width: 76 }}>气场</Text>
          <Text style={{ fontSize: 40, fontWeight: 'bold', color: '#7C3AED', width: 104 }}><span>10</span><span style={{ fontSize: 18 }}> 分</span></Text>
          <Text style={{ fontSize: 18, color: '#64748B', flex: 1 }}>二档判据：人镇定，但眼神躲闪、音量偏平</Text>
        </Box>
        <Box style={{ background: '#EFF6FF', borderRadius: 10, padding: '14px 20px', marginTop: 4, alignItems: 'center' }}>
          <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#2563EB' }}>面试官当场只给 1 条「最该改」</Text>
        </Box>
      </Box>
      <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #E5E7EB', borderRadius: 12, padding: 16, flexDirection: 'column', alignItems: 'center', justifyContent: 'center', gap: 10 }}>
        <Image src="assets/mock-interview-scorecard.svg" style={{ width: 456, height: 395, objectFit: 'contain' }} />
        <Text style={{ fontSize: 14, color: '#64748B' }}>模拟面试评分表 · 投屏版样式</Text>
      </Box>
    </Box>
  </Box>
</Slide>
