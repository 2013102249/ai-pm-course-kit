<Slide style={{ width: 1280, height: 720, padding: 60, background: '#FFFFFF' }}>
  <Box style={{ position: 'absolute', top: 24, left: 60, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
    <Box style={{ width: 8, height: 24, background: '#7C3AED', borderRadius: 2 }} />
    <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W8D4</Text>
  </Box>
  <Box style={{ position: 'absolute', right: 60, bottom: 26 }}>
    <Text style={{ fontSize: 14, color: '#64748B' }}>04 / 6</Text>
  </Box>
  <Box style={{ flexDirection: 'column', height: '100%', gap: 16 }}>
    <Box style={{ flexDirection: 'column', gap: 14 }}>
      <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#1E1B4B' }}>压力面怎么配合</Text>
      <Box style={{ width: '100%', height: 1, background: '#E5E7EB' }} />
    </Box>
    <Box style={{ flexDirection: 'column', gap: 10 }}>
      <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1E1B4B' }}>面试官四手段（预告）</Text>
      <Box style={{ flexDirection: 'row', gap: 12 }}>
        <Box style={{ flex: 1, background: '#F5F3FF', borderRadius: 10, padding: 18, alignItems: 'center', justifyContent: 'center' }}>
          <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#7C3AED' }}>打断</Text>
        </Box>
        <Box style={{ flex: 1.2, background: '#F5F3FF', borderRadius: 10, padding: 18, alignItems: 'center', justifyContent: 'center' }}>
          <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#7C3AED' }}>质疑数据</Text>
        </Box>
        <Box style={{ flex: 1.2, background: '#F5F3FF', borderRadius: 10, padding: 18, alignItems: 'center', justifyContent: 'center' }}>
          <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#7C3AED' }}>连环追问</Text>
        </Box>
        <Box style={{ flex: 1.2, background: '#F5F3FF', borderRadius: 10, padding: 18, alignItems: 'center', justifyContent: 'center' }}>
          <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#7C3AED' }}>沉默施压</Text>
        </Box>
      </Box>
    </Box>
    <Box style={{ flexDirection: 'column', gap: 10 }}>
      <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1E1B4B' }}>学员应对四句</Text>
      <Box style={{ flexDirection: 'row', gap: 12 }}>
        <Box style={{ flex: 1, background: '#EFF6FF', borderRadius: 10, padding: 16, alignItems: 'center', justifyContent: 'center' }}>
          <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#2563EB' }}>停一秒再接</Text>
        </Box>
        <Box style={{ flex: 1.1, background: '#EFF6FF', borderRadius: 10, padding: 16, alignItems: 'center', justifyContent: 'center' }}>
          <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#2563EB' }}>守口径不改口</Text>
        </Box>
        <Box style={{ flex: 1.1, background: '#EFF6FF', borderRadius: 10, padding: 16, alignItems: 'center', justifyContent: 'center' }}>
          <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#2563EB' }}>不会就给框架</Text>
        </Box>
        <Box style={{ flex: 1.3, background: '#EFF6FF', borderRadius: 10, padding: 16, alignItems: 'center', justifyContent: 'center' }}>
          <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#2563EB' }}>沉默 5 秒主动接话</Text>
        </Box>
      </Box>
    </Box>
    <Box style={{ border: '2px solid #2563EB', background: '#EFF6FF', borderRadius: 10, padding: '14px 20px', alignItems: 'center' }}>
      <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#1E1B4B' }}>红线承诺：<span style={{ color: '#2563EB' }}>施压不等于羞辱</span></Text>
    </Box>
    <Box style={{ background: 'linear-gradient(135deg, #4C1D95 0%, #7C3AED 100%)', borderRadius: 12, padding: 20, alignItems: 'center', justifyContent: 'center', flex: 1 }}>
      <Text style={{ fontSize: 30, fontWeight: 'bold', color: '#FFFFFF' }}>今天只有一件事——被完整地「面」一次</Text>
    </Box>
  </Box>
</Slide>
