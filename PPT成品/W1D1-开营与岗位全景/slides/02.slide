            <Text style={{ fontSize: 14, color: '#64748B' }}>产品 / 测试 / 研发管理</Text>
        </Box>
        <Box style={{ flex: 1, height: 88, background: '#EFF6FF', borderRadius: 12, padding: '0 24px', flexDirection: 'column', justifyContent: 'center', gap: 2 }}>
            <Text style={{ fontSize: 28, fontWeight: 'bold', color: '#2563EB' }}>18 个</Text>
