    <Box style={{ flexDirection: 'row', gap: 16, marginTop: 22 }}>
        <Box style={{ flex: 1, height: 112, borderLeft: '4px solid #7C3AED', background: '#F5F3FF', borderRadius: 12, padding: '16px 22px', flexDirection: 'column', gap: 6 }}>
            <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#1E1B4B' }}>教育科技公司 · 科技部产品负责人</Text>
