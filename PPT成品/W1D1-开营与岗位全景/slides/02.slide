    <Box style={{ flexDirection: 'row', gap: 16, marginTop: 26 }}>
        <Box style={{ flex: 1, height: 88, background: '#F5F3FF', borderRadius: 12, padding: '0 24px', flexDirection: 'column', justifyContent: 'center', gap: 2 }}>
