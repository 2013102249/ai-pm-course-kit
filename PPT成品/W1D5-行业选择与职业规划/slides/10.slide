<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: 60, fontFamily: 'Microsoft YaHei', position: 'relative' }}>
  <Box style={{ position: 'absolute', top: 24, left: 60, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
    <Box style={{ width: 8, height: 24, background: '#7C3AED', borderRadius: 4 }} />
    <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W1D5</Text>
  </Box>
  <Text style={{ position: 'absolute', bottom: 30, right: 60, fontSize: 14, color: '#64748B' }}>10 / 16</Text>
  <Box style={{ flexDirection: 'column', width: '100%', height: '100%' }}>
    <Box style={{ flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'space-between', width: '100%' }}>
      <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B', lineHeight: 1.2 }}>案例复盘：A 得 12 分，B 得 1 分</Text>
      <Text style={{ fontSize: 17, color: '#64748B' }}>用三标准当场给导入案例打分</Text>
    </Box>
    <Box style={{ width: '100%', height: 1, background: '#E5E7EB', marginTop: 18 }} />
    <Box style={{ flexDirection: 'row', gap: 24, marginTop: 24, width: '100%', flex: 1, alignItems: 'center' }}>
      <Box style={{ width: 500, flexDirection: 'column', gap: 18 }}>
        <Box style={{ background: '#F5F3FF', borderRadius: 12, padding: '20px 28px', width: '100%', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
          <Box style={{ flexDirection: 'column', gap: 6 }}>
            <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#7C3AED' }}>A · 深耕教育</Text>
            <Text style={{ fontSize: 15, color: '#64748B' }}>三标准逐项打分的合计得分</Text>
          </Box>
          <Text style={{ fontSize: 52, fontWeight: 'bold', color: '#7C3AED' }}>12 分</Text>
        </Box>
        <Box style={{ background: '#FFFFFF', border: '1px solid #E5E7EB', borderRadius: 12, padding: '20px 28px', width: '100%', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
          <Box style={{ flexDirection: 'column', gap: 6 }}>
            <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1E1B4B' }}>B · 海投全行业</Text>
            <Text style={{ fontSize: 15, color: '#64748B' }}>同样的三标准，同样的算法</Text>
          </Box>
          <Text style={{ fontSize: 52, fontWeight: 'bold', color: '#64748B' }}>1 分</Text>
        </Box>
        <Box style={{ background: '#2563EB', borderRadius: 12, padding: '16px 24px', width: '100%', alignItems: 'center' }}>
          <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#FFFFFF' }}>先上车，再换座</Text>
        </Box>
      </Box>
      <Image src="assets/track-criteria.svg" style={{ width: 620, height: 362, borderRadius: 12 }} />
    </Box>
  </Box>
</Slide>
