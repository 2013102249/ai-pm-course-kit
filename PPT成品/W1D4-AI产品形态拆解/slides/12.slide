        <Box style={{ height: 1, background: '#E5E7EB', marginTop: 18 }} />
    </Box>
    <Text style={{ fontSize: 20, color: '#64748B', marginBottom: 28 }}>ima（腾讯出品）：知识库问答形态的代表产品，把散落文档组织成可问答的知识库</Text>
    <Box style={{ flexDirection: 'row', alignItems: 'center', justifyContent: 'center', gap: 18, marginBottom: 32 }}>
