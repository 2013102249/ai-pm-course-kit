<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: 60 }}>
    <Box style={{ position: 'absolute', top: 24, left: 60, flexDirection: 'row', alignItems: 'center', gap: 8 }}>
        <Box style={{ width: 8, height: 24, background: '#7C3AED', borderRadius: 4 }} />
        <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W1D4</Text>
    </Box>
    <Text style={{ position: 'absolute', bottom: 26, right: 60, fontSize: 14, color: '#64748B' }}>18 / 20</Text>
    <Box style={{ marginBottom: 20 }}>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B' }}>快问快答：商业模式匹配</Text>
        <Box style={{ height: 1, background: '#E5E7EB', marginTop: 18 }} />
    </Box>
    <Box style={{ flexDirection: 'row', gap: 28, flex: 1 }}>
        <Box style={{ width: 300, background: '#4C1D95', borderRadius: 12, alignItems: 'center', justifyContent: 'center', gap: 8 }}>
            <Text style={{ fontSize: 110, fontWeight: 'bold', color: '#FFFFFF' }}>5</Text>
            <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#FFFFFF' }}>个场景</Text>
            <Text style={{ fontSize: 16, color: 'rgba(255,255,255,0.75)' }}>逐题出现，限时快答</Text>
        </Box>
        <Box style={{ flex: 1, justifyContent: 'center', gap: 22 }}>
            <Box style={{ flexDirection: 'row', alignItems: 'flex-start', gap: 18 }}>
                <Box style={{ width: 28, height: 28, background: '#7C3AED', borderRadius: 6, alignItems: 'center', justifyContent: 'center', marginTop: 4 }}>
                    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FFFFFF' }}>1</Text>
                </Box>
                <Text style={{ fontSize: 20, color: '#1E1B4B', lineHeight: 1.6 }}>听场景，判断它属于六大形态中的哪一种</Text>
            </Box>
            <Box style={{ flexDirection: 'row', alignItems: 'flex-start', gap: 18 }}>
                <Box style={{ width: 28, height: 28, background: '#7C3AED', borderRadius: 6, alignItems: 'center', justifyContent: 'center', marginTop: 4 }}>
                    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FFFFFF' }}>2</Text>
                </Box>
                <Text style={{ fontSize: 20, color: '#1E1B4B', lineHeight: 1.6 }}>给出匹配的商业模式：订阅、按量、席位、按任务……</Text>
            </Box>
            <Box style={{ flexDirection: 'row', alignItems: 'flex-start', gap: 18 }}>
                <Box style={{ width: 28, height: 28, background: '#7C3AED', borderRadius: 6, alignItems: 'center', justifyContent: 'center', marginTop: 4 }}>
                    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FFFFFF' }}>3</Text>
                </Box>
                <Text style={{ fontSize: 20, color: '#1E1B4B', lineHeight: 1.6 }}>补一条理由——理由比答案更能看出你懂没懂</Text>
            </Box>
            <Box style={{ background: '#EFF6FF', borderRadius: 12, padding: '16px 22px', marginTop: 8 }}>
                <Text style={{ fontSize: 18, color: '#1D4ED8', fontWeight: 'bold' }}>答题三件套：形态 + 商业模式 + 一条理由</Text>
