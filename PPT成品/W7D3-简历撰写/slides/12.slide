<Slide style={{ width: 1280, height: 720, padding: 60, background: '#FFFFFF', fontFamily: 'Microsoft YaHei' }}>
    <Box style={{ position: 'absolute', top: 24, left: 60, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
        <Box style={{ width: 8, height: 24, background: '#7C3AED', borderRadius: 4 }} />
        <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W7D3</Text>
    </Box>
    <Text style={{ position: 'absolute', bottom: 28, right: 60, fontSize: 14, color: '#64748B' }}>12 / 18</Text>
    <Text style={{ position: 'absolute', bottom: 28, left: 60, fontSize: 14, color: '#64748B' }}>教学示例 · 数字为虚构演示</Text>
    <Box style={{ width: '100%', flexDirection: 'column', gap: 16, marginBottom: 20 }}>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B' }}>批改 III：职责式改结果式</Text>
        <Box style={{ width: '100%', height: 1, background: '#E5E7EB' }} />
    </Box>
    <Box style={{ width: '100%', flexDirection: 'column', gap: 18, height: 450 }}>
        <Box style={{ background: '#FEF2F2', border: '1px solid #DC2626', borderRadius: 12, padding: 22, flexDirection: 'column', gap: 8 }}>
            <Text style={{ fontSize: 20, color: '#DC2626', textDecoration: 'line-through' }}><span style={{ textDecoration: 'line-through' }}>「负责运营公众号。」</span></Text>
            <Text style={{ fontSize: 18, color: '#64748B' }}>职责式写法：只说明「我在这个岗位上」，没说清做了什么、做成了什么。</Text>
        </Box>
        <Box style={{ flex: 1, background: '#F5F3FF', borderRadius: 12, padding: 22, flexDirection: 'column', gap: 10 }}>
            <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#7C3AED' }}>改写：背景 + 动作 + 结果</Text>
            <Box style={{ flexDirection: 'column', gap: 8, marginTop: 4 }}>
                <Text style={{ fontSize: 19, color: '#1E1B4B', lineHeight: 1.55 }}><span style={{ fontWeight: 'bold', color: '#2563EB' }}>背景：</span>面向转行人群的 AI 产品学习公众号（冷启动）</Text>
                <Text style={{ fontSize: 19, color: '#1E1B4B', lineHeight: 1.55 }}><span style={{ fontWeight: 'bold', color: '#2563EB' }}>动作：</span>每周产出 1 篇产品拆解长文，连续更新 12 周；建立选题库与读者反馈群</Text>
                <Text style={{ fontSize: 19, color: '#1E1B4B', lineHeight: 1.55 }}><span style={{ fontWeight: 'bold', color: '#16A34A' }}>结果：</span>累计读者 4000+，单篇最高转发 500+，后台咨询转化报名 80 人</Text>
            </Box>
        </Box>
        <Box style={{ background: '#EFF6FF', borderRadius: 12, padding: '14px 22px' }}>
            <Text style={{ fontSize: 18, color: '#2563EB' }}>改写用的数据不是编的：去你的 W6 交付物里翻——测试记录、指标截图、用户反馈都在那里。</Text>
        </Box>
    </Box>
