<Slide style={{ width: 1280, height: 720, padding: 60, background: '#FFFFFF', fontFamily: 'Microsoft YaHei' }}>
    <Box style={{ position: 'absolute', top: 24, left: 60, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
        <Box style={{ width: 8, height: 24, background: '#7C3AED', borderRadius: 4 }} />
        <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W7D3</Text>
    </Box>
    <Text style={{ position: 'absolute', bottom: 28, right: 60, fontSize: 14, color: '#64748B' }}>10 / 18</Text>
    <Text style={{ position: 'absolute', bottom: 28, left: 60, fontSize: 14, color: '#64748B' }}>教学示例 · 数字为虚构演示</Text>
    <Box style={{ width: '100%', flexDirection: 'column', gap: 16, marginBottom: 20 }}>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B' }}>批改 I：项目经历反例</Text>
        <Box style={{ width: '100%', height: 1, background: '#E5E7EB' }} />
    </Box>
    <Box style={{ width: '100%', flexDirection: 'column', gap: 18, height: 450 }}>
        <Box style={{ background: '#FEF2F2', border: '1px solid #DC2626', borderRadius: 12, padding: 22, flexDirection: 'column', gap: 10 }}>
            <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E1B4B' }}>原句</Text>
            <Text style={{ fontSize: 20, color: '#DC2626', textDecoration: 'line-through' }}><span style={{ textDecoration: 'line-through' }}>「参与 XX 项目，负责部分工作，配合完成上线。」</span></Text>
            <Box style={{ flexDirection: 'row', gap: 12, marginTop: 4 }}>
                <Box style={{ background: '#FFFFFF', border: '1px solid #DC2626', borderRadius: 8, padding: '4px 14px' }}><Text style={{ fontSize: 16, fontWeight: 'bold', color: '#DC2626' }}>参与</Text></Box>
                <Box style={{ background: '#FFFFFF', border: '1px solid #DC2626', borderRadius: 8, padding: '4px 14px' }}><Text style={{ fontSize: 16, fontWeight: 'bold', color: '#DC2626' }}>负责</Text></Box>
                <Box style={{ background: '#FFFFFF', border: '1px solid #DC2626', borderRadius: 8, padding: '4px 14px' }}><Text style={{ fontSize: 16, fontWeight: 'bold', color: '#DC2626' }}>配合</Text></Box>
                <Box style={{ background: '#FFFFFF', border: '1px solid #DC2626', borderRadius: 8, padding: '4px 14px' }}><Text style={{ fontSize: 16, fontWeight: 'bold', color: '#DC2626' }}>完成</Text></Box>
                <Text style={{ fontSize: 16, color: '#64748B', marginLeft: 8 }}>← 四个免责动词：出了成绩算大家的，出了问题算别人的</Text>
            </Box>
        </Box>
        <Box style={{ flex: 1, background: '#F5F3FF', borderRadius: 12, padding: 22, flexDirection: 'column', gap: 10 }}>
            <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#7C3AED' }}>公式改写：背景 + 动作两条 + 数据结果</Text>
            <Box style={{ flexDirection: 'column', gap: 8, marginTop: 4 }}>
                <Text style={{ fontSize: 19, color: '#1E1B4B', lineHeight: 1.55 }}><span style={{ fontWeight: 'bold', color: '#2563EB' }}>背景：</span>XX 智能客服项目（企业内部工具，服务日均 3000 次咨询）</Text>
                <Text style={{ fontSize: 19, color: '#1E1B4B', lineHeight: 1.55 }}><span style={{ fontWeight: 'bold', color: '#2563EB' }}>动作 1：</span>搭建知识库标签体系，覆盖 200+ 高频问题</Text>
                <Text style={{ fontSize: 19, color: '#1E1B4B', lineHeight: 1.55 }}><span style={{ fontWeight: 'bold', color: '#2563EB' }}>动作 2：</span>主导两轮用户测试，根据反馈迭代 3 版话术</Text>
                <Text style={{ fontSize: 19, color: '#1E1B4B', lineHeight: 1.55 }}><span style={{ fontWeight: 'bold', color: '#16A34A' }}>结果：</span>高频问题自助解决率从 58% 提升到 82%</Text>
            </Box>
        </Box>
    </Box>
</Slide>
