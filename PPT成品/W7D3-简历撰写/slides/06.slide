            <Box style={{ background: '#F5F3FF', borderRadius: 14, padding: 16, justifyContent: 'center', alignItems: 'center' }}>
                <Image src="assets/resume-structure.svg" style={{ width: 398, height: 262, objectFit: 'contain' }} />
            </Box>
            <Box style={{ background: '#7C3AED', borderRadius: 10, padding: '10px 18px', alignSelf: 'flex-start' }}>
                <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FFFFFF' }}>当前段落：头部定位 · 核心技能</Text>
            </Box>
        </Box>
        <Box style={{ flex: 1, height: '100%', flexDirection: 'column', justifyContent: 'space-between' }}>
            <Box style={{ background: '#F5F3FF', borderRadius: 12, padding: 24, flexDirection: 'column', gap: 8 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
                    <Box style={{ width: 28, height: 28, background: '#7C3AED', borderRadius: 6, justifyContent: 'center', alignItems: 'center' }}>
                        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FFFFFF' }}>1</Text>
                    </Box>
                    <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E1B4B' }}>定位一行</Text>
                </Box>
                <Text style={{ fontSize: 19, color: '#1E1B4B', lineHeight: 1.6 }}>一行写清：<span style={{ fontWeight: 'bold', color: '#7C3AED' }}>人 + 事 + 数 + 目标</span>，谁来、做过什么、做到什么程度、接下来想去哪。</Text>
            </Box>
            <Box style={{ background: '#EFF6FF', borderRadius: 12, padding: 24, flexDirection: 'column', gap: 8 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
                    <Box style={{ width: 28, height: 28, background: '#2563EB', borderRadius: 6, justifyContent: 'center', alignItems: 'center' }}>
                        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FFFFFF' }}>2</Text>
                    </Box>
                    <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E1B4B' }}>核心技能 4–6 条</Text>
                </Box>
                <Text style={{ fontSize: 19, color: '#1E1B4B', lineHeight: 1.6 }}>从目标岗位 JD 倒推：JD 要什么能力，就写什么证据，不写凑数技能。</Text>
            </Box>
            <Box style={{ border: '1px solid #DC2626', borderRadius: 12, padding: 24, flexDirection: 'column', gap: 8 }}>
