<Slide style={{ width: 1280, height: 720, padding: 60, background: '#FFFFFF', fontFamily: 'Microsoft YaHei' }}>
    <Box style={{ position: 'absolute', top: 24, left: 60, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
        <Box style={{ width: 8, height: 24, background: '#7C3AED', borderRadius: 4 }} />
        <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W7D3</Text>
    </Box>
    <Text style={{ position: 'absolute', bottom: 28, right: 60, fontSize: 14, color: '#64748B' }}>13 / 18</Text>
    <Box style={{ width: '100%', flexDirection: 'column', gap: 16, marginBottom: 24 }}>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B' }}>数据的三条纪律</Text>
        <Box style={{ width: '100%', height: 1, background: '#E5E7EB' }} />
    </Box>
    <Box style={{ width: '100%', flexDirection: 'column', gap: 18, height: 450 }}>
        <Box style={{ flex: 1, background: '#F5F3FF', borderRadius: 12, padding: '0 26px', flexDirection: 'row', alignItems: 'center', gap: 22 }}>
            <Box style={{ width: 28, height: 28, background: '#7C3AED', borderRadius: 6, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FFFFFF' }}>1</Text>
            </Box>
            <Text style={{ width: 200, fontSize: 22, fontWeight: 'bold', color: '#1E1B4B' }}>真实</Text>
            <Text style={{ flex: 1, fontSize: 19, color: '#1E1B4B', lineHeight: 1.6 }}>每个数字都有出处：来自 W6 交付物、测试记录或真实运营数据，不估算不美化。</Text>
        </Box>
        <Box style={{ flex: 1, background: '#EFF6FF', borderRadius: 12, padding: '0 26px', flexDirection: 'row', alignItems: 'center', gap: 22 }}>
            <Box style={{ width: 28, height: 28, background: '#2563EB', borderRadius: 6, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FFFFFF' }}>2</Text>
            </Box>
            <Text style={{ width: 200, fontSize: 22, fontWeight: 'bold', color: '#1E1B4B' }}>口径可解释</Text>
            <Text style={{ flex: 1, fontSize: 19, color: '#1E1B4B', lineHeight: 1.6 }}>分子分母是什么、样本量多大、统计周期多长，一句话能说清楚。</Text>
        </Box>
        <Box style={{ flex: 1, background: '#F5F3FF', borderRadius: 12, padding: '0 26px', flexDirection: 'row', alignItems: 'center', gap: 22 }}>
            <Box style={{ width: 28, height: 28, background: '#7C3AED', borderRadius: 6, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FFFFFF' }}>3</Text>
            </Box>
            <Text style={{ width: 200, fontSize: 22, fontWeight: 'bold', color: '#1E1B4B' }}>经得起追问三层</Text>
            <Text style={{ flex: 1, fontSize: 19, color: '#1E1B4B', lineHeight: 1.6 }}>数字哪来的 → 口径怎么定的 → 和谁比、变化为什么发生，三层都能接住。</Text>
        </Box>
        <Box style={{ background: '#FEF2F2', border: '1px solid #DC2626', borderRadius: 12, padding: '16px 26px' }}>
            <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#DC2626' }}>答不上来的数字，宁可删。</Text>
        </Box>
    </Box>
</Slide>
