<Slide style={{ width: 1280, height: 720, padding: 60, background: '#FFFFFF', fontFamily: 'Microsoft YaHei' }}>
    <Box style={{ position: 'absolute', top: 24, left: 60, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
        <Box style={{ width: 8, height: 24, background: '#7C3AED', borderRadius: 4 }} />
        <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W7D3</Text>
    </Box>
    <Text style={{ position: 'absolute', bottom: 28, right: 60, fontSize: 14, color: '#64748B' }}>17 / 18</Text>
    <Box style={{ width: '100%', flexDirection: 'column', gap: 16, marginBottom: 20 }}>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B' }}>工作坊：简历写作 18 分钟</Text>
        <Box style={{ width: '100%', height: 1, background: '#E5E7EB' }} />
    </Box>
    <Box style={{ width: '100%', height: 455, flexDirection: 'row', gap: 26 }}>
        <Box style={{ width: 600, height: '100%', flexDirection: 'column', gap: 14 }}>
            <Box style={{ background: '#7C3AED', borderRadius: 12, padding: '12px 20px', flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#FFFFFF' }}>常驻计时 · 全程 18 分钟</Text>
                <Text style={{ fontSize: 28, fontWeight: 'bold', color: '#FFFFFF' }}>18:00</Text>
            </Box>
            <Table
                style={{ width: '100%', height: 300 }}
                defaultTextStyle={{ fontSize: 17, textAlign: 'left', color: '#1E1B4B' }}
                defaultCellStyle={{
                    border: {
                        left: { width: 1, color: '#E5E7EB' },
                        right: { width: 1, color: '#E5E7EB' },
                        top: { width: 1, color: '#E5E7EB' },
                        bottom: { width: 1, color: '#E5E7EB' },
                    },
                }}
                cells={[
                    [
                        { text: '环节', textStyle: { bold: true, color: '#FFFFFF', fontSize: 17 }, cellStyle: { background: { color: '#7C3AED' } } },
                        { text: '任务', textStyle: { bold: true, color: '#FFFFFF', fontSize: 17 }, cellStyle: { background: { color: '#7C3AED' } } },
                        { text: '时长', textStyle: { bold: true, color: '#FFFFFF', fontSize: 17 }, cellStyle: { background: { color: '#7C3AED' } } },
                    ],
                    [
                        { text: '定位', cellStyle: { background: { color: '#FFFFFF' } } },
                        { text: '一行写人 + 事 + 数 + 目标', cellStyle: { background: { color: '#FFFFFF' } } },
                        { text: '5 min', textStyle: { bold: true, color: '#7C3AED' }, cellStyle: { background: { color: '#FFFFFF' } } },
                    ],
                    [
                        { text: '技能', cellStyle: { background: { color: '#F5F3FF' } } },
                        { text: '从 JD 倒推 4–6 条', cellStyle: { background: { color: '#F5F3FF' } } },
                        { text: '5 min', textStyle: { bold: true, color: '#7C3AED' }, cellStyle: { background: { color: '#F5F3FF' } } },
                    ],
                    [
                        { text: '项目 · 段一', cellStyle: { background: { color: '#FFFFFF' } } },
                        { text: '主项目按公式写四句', cellStyle: { background: { color: '#FFFFFF' } } },
                        { text: '4 min', textStyle: { bold: true, color: '#7C3AED' }, cellStyle: { background: { color: '#FFFFFF' } } },
                    ],
                    [
                        { text: '项目 · 段二', cellStyle: { background: { color: '#F5F3FF' } } },
                        { text: '第二段项目按公式写', cellStyle: { background: { color: '#F5F3FF' } } },
                        { text: '4 min', textStyle: { bold: true, color: '#7C3AED' }, cellStyle: { background: { color: '#F5F3FF' } } },
                    ],
                ]}
            />
            <Text style={{ fontSize: 16, color: '#64748B' }}>写作过程以导学案为载体，屏幕计时全程可见，到点即停笔。</Text>
        </Box>
        <Box style={{ flex: 1, height: '100%', background: '#EFF6FF', borderRadius: 14, padding: 24, flexDirection: 'column', gap: 12 }}>
            <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E1B4B' }}>写完互查 5 项</Text>
            {[
                '定位一行含人、事、数、目标',
                '技能 4–6 条，能对应到 JD',
                '项目按公式：背景 + 动作 + 结果',
                '每个数字答得上三层追问',
                '无座右铭、无无支撑形容词',
            ].map((item, idx) => (
                <Box key={idx} style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
                    <Box style={{ width: 26, height: 26, background: '#2563EB', borderRadius: 6, justifyContent: 'center', alignItems: 'center' }}>
                        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>{idx + 1}</Text>
                    </Box>
                    <Text style={{ flex: 1, fontSize: 18, color: '#1E1B4B' }}>{item}</Text>
                </Box>
            ))}
        </Box>
    </Box>
</Slide>
