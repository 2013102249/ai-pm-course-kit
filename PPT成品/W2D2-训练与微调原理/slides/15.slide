  <Box style={{ flexDirection: 'row', gap: 20 }}>
    <Box style={{ flexDirection: 'column', gap: 20, flex: 1 }}>
      <Box style={{ height: 168, background: '#F5F3FF', borderRadius: 14, padding: 24, justifyContent: 'center', gap: 10 }}>
        <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E1B4B' }}>场景一 · 售后政策</Text>
        <Text style={{ fontSize: 17, color: '#64748B', lineHeight: 1.5 }}>每月更新的售后政策问答，答案要跟上新政策</Text>
