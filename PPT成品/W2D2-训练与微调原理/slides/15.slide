        <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E1B4B' }}>场景三 · 品牌口吻</Text>
        <Text style={{ fontSize: 17, color: '#64748B', lineHeight: 1.5 }}>让模型的说话方式稳定贴合品牌人设</Text>
      </Box>
    </Box>
    <Box style={{ flexDirection: 'column', gap: 20, flex: 1 }}>
      <Box style={{ height: 168, background: '#F5F3FF', borderRadius: 14, padding: 24, justifyContent: 'center', gap: 10 }}>
        <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E1B4B' }}>场景二 · JSON 输出</Text>
        <Text style={{ fontSize: 17, color: '#64748B', lineHeight: 1.5 }}>下游系统要求严格的 JSON 格式输出</Text>
