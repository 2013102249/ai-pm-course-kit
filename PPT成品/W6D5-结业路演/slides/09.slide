                <Text style={{ fontSize: 24, color: 'rgba(255,255,255,0.6)' }}>获奖组名</Text>
            </Box>
        </Box>
        <Box style={{ flex: 1, flexDirection: 'column', gap: 10 }}>
            <Text style={{ fontSize: 16, color: 'rgba(255,255,255,0.75)' }}>最佳成长奖</Text>
            <Box style={{ height: 170, border: '2px dashed rgba(255,255,255,0.45)', borderRadius: 12, alignItems: 'center', justifyContent: 'center' }}>
                <Text style={{ fontSize: 24, color: 'rgba(255,255,255,0.6)' }}>获奖组名</Text>
            </Box>
        </Box>
        <Box style={{ flex: 1, flexDirection: 'column', gap: 10 }}>
            <Text style={{ fontSize: 16, color: 'rgba(255,255,255,0.75)' }}>最佳答辩奖</Text>
            <Box style={{ height: 170, border: '2px dashed rgba(255,255,255,0.45)', borderRadius: 12, alignItems: 'center', justifyContent: 'center' }}>
                <Text style={{ fontSize: 24, color: 'rgba(255,255,255,0.6)' }}>获奖组名</Text>
            </Box>
        </Box>
    </Box>
    <Box style={{ marginTop: 26, height: 110, border: '2px dashed rgba(255,255,255,0.45)', borderRadius: 12, padding: '20px 28px', flexDirection: 'column', gap: 8 }}>
