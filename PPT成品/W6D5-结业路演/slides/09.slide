    <Box style={{ marginTop: 30, flexDirection: 'row', gap: 24 }}>
        <Box style={{ flex: 1, flexDirection: 'column', gap: 10 }}>
            <Text style={{ fontSize: 16, color: 'rgba(255,255,255,0.75)' }}>最佳产品奖</Text>
