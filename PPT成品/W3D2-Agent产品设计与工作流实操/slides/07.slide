<Slide style={{ width: 1280, height: 720, padding: 60, background: '#FFFFFF', position: 'relative' }}>
  <Box style={{ position: 'absolute', top: 24, left: 60, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
    <Box style={{ width: 8, height: 24, background: '#7C3AED', borderRadius: 4 }} />
    <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W3D2</Text>
  </Box>
  <Text style={{ position: 'absolute', right: 60, bottom: 26, fontSize: 14, color: '#64748B' }}>07 / 16</Text>
  <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B' }}>人机接管点：三种类型</Text>
  <Box style={{ width: '100%', height: 1, background: '#E5E7EB', marginTop: 16, marginBottom: 24 }} />
  <Box style={{ flexDirection: 'row', gap: 24, width: '100%' }}>
    <Box style={{ width: 640, alignItems: 'center' }}>
      <Image src="assets/workflow-orchestration.svg" style={{ width: 640, height: 373, objectFit: 'contain' }} />
      <Text style={{ fontSize: 14, color: '#64748B', marginTop: 8 }}>接管点标注在流程图上：事前审批 · 事后兜底</Text>
    </Box>
    <Box style={{ flex: 1, flexDirection: 'column', gap: 16 }}>
      <Box style={{ background: '#F5F3FF', borderRadius: 12, padding: '22px 24px', width: '100%' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12, marginBottom: 8 }}>
          <Box style={{ width: 28, height: 28, background: '#7C3AED', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
            <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>1</Text>
          </Box>
          <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E1B4B' }}>审批型</Text>
          <Box style={{ background: '#7C3AED', borderRadius: 12, padding: '2px 14px' }}>
            <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#FFFFFF' }}>事前</Text>
          </Box>
        </Box>
        <Text style={{ fontSize: 17, color: '#64748B' }}>高风险操作执行前，先人工审批再放行</Text>
      </Box>
      <Box style={{ background: '#EFF6FF', borderRadius: 12, padding: '22px 24px', width: '100%' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12, marginBottom: 8 }}>
          <Box style={{ width: 28, height: 28, background: '#2563EB', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
            <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>2</Text>
          </Box>
          <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E1B4B' }}>纠错型</Text>
          <Box style={{ background: '#2563EB', borderRadius: 12, padding: '2px 14px' }}>
            <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#FFFFFF' }}>事中</Text>
          </Box>
        </Box>
        <Text style={{ fontSize: 17, color: '#64748B' }}>执行过程中发现偏差，人工介入纠正</Text>
      </Box>
      <Box style={{ background: '#F5F3FF', borderRadius: 12, padding: '22px 24px', width: '100%' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12, marginBottom: 8 }}>
          <Box style={{ width: 28, height: 28, background: '#7C3AED', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
            <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>3</Text>
          </Box>
          <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E1B4B' }}>兜底型</Text>
          <Box style={{ background: '#7C3AED', borderRadius: 12, padding: '2px 14px' }}>
            <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#FFFFFF' }}>事后</Text>
          </Box>
        </Box>
        <Text style={{ fontSize: 17, color: '#64748B' }}>失败走完兜底链仍无解，最终转人工</Text>
      </Box>
    </Box>
  </Box>
  <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14, background: '#F5F3FF', borderRadius: 12, padding: '16px 28px', width: '100%', marginTop: 22 }}>
