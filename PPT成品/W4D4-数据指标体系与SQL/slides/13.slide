<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: 60, position: 'relative' }}>
  <Box style={{ position: 'absolute', top: 24, left: 60, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
    <Box style={{ width: 8, height: 24, background: '#7C3AED', borderRadius: 4 }} />
    <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W4D4</Text>
  </Box>
  <Box style={{ position: 'absolute', bottom: 20, right: 60 }}>
    <Text style={{ fontSize: 14, color: '#64748B' }}>13 / 18</Text>
  </Box>
  <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B' }}>护栏指标：防止把指标做歪</Text>
  <Box style={{ width: '100%', height: 1, background: '#E5E7EB', marginTop: 18, marginBottom: 26 }} />
  <Box style={{ flexDirection: 'row', gap: 24, width: '100%', alignItems: 'flex-start' }}>
    <Box style={{ width: 576, flexDirection: 'column', gap: 14 }}>
      <Box style={{ background: '#FFFFFF', border: '1px solid #E5E7EB', borderRadius: 10, padding: '14px 22px' }}>
        <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#1E1B4B' }}>北极星盯采纳 <span style={{ color: '#7C3AED' }}>↔</span> 护栏盯重试率</Text>
        <Text style={{ fontSize: 17, color: '#64748B', marginTop: 6, lineHeight: 1.5 }}>采纳率涨了五个点、重试次数翻倍 = 单次质量其实在降</Text>
      </Box>
      <Box style={{ background: '#FFFFFF', border: '1px solid #E5E7EB', borderRadius: 10, padding: '14px 22px' }}>
        <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#1E1B4B' }}>北极星盯增长 <span style={{ color: '#7C3AED' }}>↔</span> 护栏盯幻觉率 + 单次成本</Text>
        <Text style={{ fontSize: 17, color: '#64748B', marginTop: 6, lineHeight: 1.5 }}>新用户涌入若让幻觉率和成本失控，增长就是烧钱买口碑恶化</Text>
      </Box>
      <Box style={{ background: '#FFFFFF', border: '1px solid #E5E7EB', borderRadius: 10, padding: '14px 22px' }}>
        <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#1E1B4B' }}>北极星盯留存 <span style={{ color: '#7C3AED' }}>↔</span> 护栏盯推送退订率</Text>
        <Text style={{ fontSize: 17, color: '#64748B', marginTop: 6, lineHeight: 1.5 }}>留存如果是靠弹窗弹回来的，退订率会先告诉你真相</Text>
      </Box>
    </Box>
    <Box style={{ width: 560, flexDirection: 'column' }}>
      <Box style={{ width: 560, height: 336, borderRadius: 8, border: '1px solid #E5E7EB', overflow: 'hidden' }}>
        <Image src="assets/metrics-system.svg" style={{ width: 560, height: 336, objectFit: 'contain' }} />
      </Box>
      <Box style={{ width: 560, background: '#F5F3FF', border: '2px solid #7C3AED', borderRadius: 8, padding: '12px 18px', marginTop: 12, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
        <Box style={{ width: 10, height: 10, background: '#7C3AED', borderRadius: 5 }} />
        <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#7C3AED' }}>护栏亮起：重试率 · 单次成本 · 幻觉率抽检 · 推送退订率</Text>
      </Box>
    </Box>
  </Box>
  <Box style={{ width: '100%', background: 'linear-gradient(135deg, #4C1D95 0%, #7C3AED 100%)', borderRadius: 10, padding: '18px 28px', marginTop: 22 }}>
    <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#FFFFFF' }}>北极星决定船往哪开，护栏防止把船开翻</Text>
  </Box>
</Slide>
