<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: 60, position: 'relative' }}>
  <Box style={{ position: 'absolute', top: 24, left: 60, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
    <Box style={{ width: 8, height: 24, background: '#7C3AED', borderRadius: 4 }} />
    <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W4D4</Text>
  </Box>
  <Box style={{ position: 'absolute', bottom: 20, right: 60 }}>
    <Text style={{ fontSize: 14, color: '#64748B' }}>14 / 18</Text>
  </Box>
  <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B' }}>SQL：AI 产品经理的硬技能</Text>
  <Box style={{ width: '100%', height: 1, background: '#E5E7EB', marginTop: 18, marginBottom: 26 }} />
  <Box style={{ flexDirection: 'row', gap: 24, width: '100%', alignItems: 'flex-start' }}>
    <Box style={{ width: 470, flexDirection: 'column', gap: 14 }}>
      <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#7C3AED' }}>为什么必须会</Text>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14, background: '#F5F3FF', borderRadius: 10, padding: '14px 20px' }}>
        <Box style={{ width: 28, height: 28, background: '#7C3AED', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
          <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>1</Text>
        </Box>
        <Text style={{ fontSize: 19, color: '#1E1B4B', flex: 1 }}>不排队：取数不用等数据同学排期</Text>
      </Box>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14, background: '#F5F3FF', borderRadius: 10, padding: '14px 20px' }}>
        <Box style={{ width: 28, height: 28, background: '#7C3AED', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
          <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>2</Text>
        </Box>
        <Text style={{ fontSize: 19, color: '#1E1B4B', flex: 1 }}>不被糊弄：数字怎么算出来的，自己看得懂</Text>
      </Box>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14, background: '#F5F3FF', borderRadius: 10, padding: '14px 20px' }}>
        <Box style={{ width: 28, height: 28, background: '#7C3AED', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
          <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>3</Text>
        </Box>
        <Text style={{ fontSize: 19, color: '#1E1B4B', flex: 1 }}>会讲故事：亲手跑出来的数据才有说服力</Text>
      </Box>
    </Box>
    <Box style={{ flex: 1, flexDirection: 'column', gap: 12 }}>
      <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#2563EB' }}>「小笔」数据集：一个 AI 写作助手的模拟数据</Text>
      <Box style={{ background: '#EFF6FF', borderRadius: 10, padding: '14px 20px' }}>
        <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#1E1B4B' }}>users 用户表（8 个用户）</Text>
        <Text style={{ fontSize: 16, color: '#1E1B4B', fontFamily: 'Menlo, monospace', marginTop: 8, lineHeight: 1.6 }}>user_id · channel 获客渠道 · register_date 注册日期</Text>
      </Box>
      <Box style={{ background: '#F5F3FF', borderRadius: 10, padding: '14px 20px' }}>
        <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#1E1B4B' }}>gen_records 生成记录表（13 条记录）</Text>
        <Text style={{ fontSize: 16, color: '#1E1B4B', fontFamily: 'Menlo, monospace', marginTop: 8, lineHeight: 1.6 }}>gen_id · user_id · gen_date · is_accepted 是否采纳 · tokens · cost_yuan 成本</Text>
      </Box>
      <Text style={{ fontSize: 16, color: '#64748B' }}>两张表靠 user_id 关联，今天所有练习和课后十题都用它</Text>
    </Box>
  </Box>
  <Box style={{ width: '100%', background: '#1E1B4B', borderRadius: 10, padding: '16px 26px', marginTop: 24 }}>
    <Text style={{ fontSize: 18, color: '#FFFFFF', fontFamily: 'Menlo, monospace' }}>SELECT * FROM users;  <span style={{ color: '#A5B4FC' }}>-- 返回 8 行即环境就绪，未就绪举手找助教</span></Text>
  </Box>
