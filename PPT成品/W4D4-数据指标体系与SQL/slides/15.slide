<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: 60, position: 'relative' }}>
  <Box style={{ position: 'absolute', top: 24, left: 60, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
    <Box style={{ width: 8, height: 24, background: '#7C3AED', borderRadius: 4 }} />
    <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W4D4</Text>
  </Box>
  <Box style={{ position: 'absolute', bottom: 20, right: 60 }}>
    <Text style={{ fontSize: 14, color: '#64748B' }}>15 / 18</Text>
  </Box>
  <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B' }}>第一关 SELECT + 第二关 WHERE</Text>
  <Box style={{ width: '100%', height: 1, background: '#E5E7EB', marginTop: 18, marginBottom: 24 }} />
  <Text style={{ fontSize: 18, color: '#64748B' }}>本页投屏 SQL 环境逐条演示</Text>
  <Box style={{ flexDirection: 'row', gap: 24, marginTop: 22, width: '100%' }}>
    <Box style={{ flex: 1, background: '#F5F3FF', borderRadius: 12, padding: '20px 26px' }}>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
        <Box style={{ background: '#7C3AED', borderRadius: 6, padding: '4px 12px' }}>
          <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF', fontFamily: 'Menlo, monospace' }}>SELECT</Text>
        </Box>
        <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1E1B4B' }}>管列——要哪些列</Text>
      </Box>
      <Box style={{ background: '#1E1B4B', borderRadius: 8, padding: '12px 18px', marginTop: 14 }}>
        <Text style={{ fontSize: 16, color: '#FFFFFF', fontFamily: 'Menlo, monospace' }}>SELECT gen_id, is_accepted, cost_yuan<br />FROM gen_records;</Text>
      </Box>
    </Box>
    <Box style={{ flex: 1, background: '#EFF6FF', borderRadius: 12, padding: '20px 26px' }}>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
        <Box style={{ background: '#2563EB', borderRadius: 6, padding: '4px 12px' }}>
          <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF', fontFamily: 'Menlo, monospace' }}>WHERE</Text>
        </Box>
        <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1E1B4B' }}>管行——留哪些行</Text>
      </Box>
      <Box style={{ background: '#1E1B4B', borderRadius: 8, padding: '12px 18px', marginTop: 14 }}>
        <Text style={{ fontSize: 16, color: '#FFFFFF', fontFamily: 'Menlo, monospace' }}>WHERE gen_date = '2026-09-03'<br />AND is_accepted = 0;</Text>
      </Box>
    </Box>
  </Box>
  <Box style={{ flexDirection: 'row', gap: 24, marginTop: 22, width: '100%' }}>
    <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #E5E7EB', borderRadius: 10, padding: '14px 22px' }}>
      <Text style={{ fontSize: 18, color: '#1E1B4B' }}>条件用 <span style={{ fontFamily: 'Menlo, monospace', fontWeight: 'bold' }}>= / AND</span> 连接；日期等文本值要加<span style={{ fontWeight: 'bold', color: '#7C3AED' }}>单引号</span>；SELECT 后面是列，WHERE 后面是条件</Text>
    </Box>
    <Box style={{ width: 400, background: '#F5F3FF', borderRadius: 10, padding: '14px 22px' }}>
      <Text style={{ fontSize: 18, color: '#1E1B4B' }}>学员练习 1（<span style={{ fontWeight: 'bold', color: '#7C3AED' }}>3 分钟</span>）：筛出指定日期的生成记录</Text>
    </Box>
  </Box>
</Slide>
