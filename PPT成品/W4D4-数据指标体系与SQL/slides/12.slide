<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: 60, position: 'relative' }}>
  <Box style={{ position: 'absolute', top: 24, left: 60, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
    <Box style={{ width: 8, height: 24, background: '#7C3AED', borderRadius: 4 }} />
    <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W4D4</Text>
  </Box>
  <Box style={{ position: 'absolute', bottom: 20, right: 60 }}>
    <Text style={{ fontSize: 14, color: '#64748B' }}>12 / 18</Text>
  </Box>
  <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16, width: '100%' }}>
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B' }}>案例对比：DAU vs 采纳型北极星</Text>
    <Box style={{ background: '#7C3AED', borderRadius: 11, padding: '4px 14px' }}>
      <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#FFFFFF' }}>教学示例</Text>
    </Box>
  </Box>
  <Box style={{ width: '100%', height: 1, background: '#E5E7EB', marginTop: 18, marginBottom: 26 }} />
  <Box style={{ width: '100%', border: '1px solid #E5E7EB', borderRadius: 12, overflow: 'hidden' }}>
    <Table
      style={{ width: '100%', height: 316 }}
      defaultTextStyle={{ fontSize: 17, textAlign: 'left', color: '#1E1B4B' }}
      defaultCellStyle={{
        border: {
          left: { width: 1, color: '#E5E7EB' },
          right: { width: 1, color: '#E5E7EB' },
          top: { width: 1, color: '#E5E7EB' },
          bottom: { width: 1, color: '#E5E7EB' },
        },
        padding: '10px 18px',
      }}
      cells={[
        [
          { text: '三标准', textStyle: { bold: true, color: '#FFFFFF', fontSize: 17 }, cellStyle: { background: { color: '#7C3AED' } } },
          { text: 'DAU（反面教材）', textStyle: { bold: true, color: '#FFFFFF', fontSize: 17 }, cellStyle: { background: { color: '#7C3AED' } } },
          { text: '每周生成并被采纳 ≥3 次的用户数（正例）', textStyle: { bold: true, color: '#FFFFFF', fontSize: 17 }, cellStyle: { background: { color: '#7C3AED' } } },
        ],
        [
          { text: '绑价值', textStyle: { bold: true } },
          { text: '不绑：打开 App 不等于得到价值，AI 产品打开后甩手走的比例不低', cellStyle: { background: { color: '#FFFFFF' } } },
          { text: '绑：被采纳即用户拿到了核心价值', cellStyle: { background: { color: '#F5F3FF' } } },
        ],
        [
          { text: '可影响', textStyle: { bold: true }, cellStyle: { background: { color: '#F5F3FF' } } },
          { text: '太可影响：推送、签到、每日抽奖都能推高，太容易被廉价手段影响反而失真', cellStyle: { background: { color: '#F5F3FF' } } },
          { text: '团队动作能直接推动：提升生成质量与采纳', cellStyle: { background: { color: '#FFFFFF' } } },
        ],
        [
          { text: '可拆解', textStyle: { bold: true } },
          { text: '不可拆：和采纳率、留存都不挂钩，跌了查不出原因', cellStyle: { background: { color: '#FFFFFF' } } },
          { text: '可拆：生成量、采纳率、习惯用户，出问题能定位到环节', cellStyle: { background: { color: '#F5F3FF' } } },
        ],
      ]}
    />
  </Box>
  <Box style={{ width: '100%', background: '#EFF6FF', borderRadius: 10, padding: '16px 24px', marginTop: 24 }}>
    <Text style={{ fontSize: 19, color: '#1E1B4B' }}>北极星改成「每周采纳 ≥3 次」后，团队动作立刻从<span style={{ fontWeight: 'bold' }}>拉新</span>转向<span style={{ fontWeight: 'bold', color: '#2563EB' }}>留存</span>——新用户采纳率上不去，这个数字就不动；拉来一堆不采纳的用户，数字反而被稀释（教学示例，非真实公司数据）</Text>
  </Box>
</Slide>
