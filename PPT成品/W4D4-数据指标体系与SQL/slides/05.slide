<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: 60, position: 'relative' }}>
  <Box style={{ position: 'absolute', top: 24, left: 60, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
    <Box style={{ width: 8, height: 24, background: '#7C3AED', borderRadius: 4 }} />
    <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W4D4</Text>
  </Box>
  <Box style={{ position: 'absolute', bottom: 20, right: 60 }}>
    <Text style={{ fontSize: 14, color: '#64748B' }}>05 / 18</Text>
  </Box>
  <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B' }}>指标体系三层结构</Text>
  <Box style={{ width: '100%', height: 1, background: '#E5E7EB', marginTop: 18, marginBottom: 28 }} />
  <Box style={{ flexDirection: 'row', gap: 24, width: '100%', alignItems: 'flex-start' }}>
    <Box style={{ width: 576, flexDirection: 'column', gap: 16 }}>
      <Box style={{ background: '#F5F3FF', borderRadius: 12, padding: '18px 24px' }}>
        <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#7C3AED' }}>第一层 · 北极星（1 个）</Text>
        <Text style={{ fontSize: 17, color: '#1E1B4B', marginTop: 8, lineHeight: 1.5 }}>全公司所有争论拿不定主意时，抬头看的那一个数</Text>
      </Box>
      <Box style={{ background: '#EFF6FF', borderRadius: 12, padding: '18px 24px' }}>
        <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#2563EB' }}>第二层 · 一级指标（支撑分解）</Text>
        <Text style={{ fontSize: 17, color: '#1E1B4B', marginTop: 8, lineHeight: 1.5 }}>把北极星拆成几块，出问题能定位到环节</Text>
      </Box>
      <Box style={{ background: '#F5F3FF', borderRadius: 12, padding: '18px 24px' }}>
        <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#7C3AED' }}>第三层 · 护栏指标（防做歪）</Text>
        <Text style={{ fontSize: 17, color: '#1E1B4B', marginTop: 8, lineHeight: 1.5 }}>约束指标，防止北极星被「歪」着做上去</Text>
      </Box>
      <Text style={{ fontSize: 16, color: '#64748B', marginTop: 6 }}>下课每人都会有一张自己的图——先记结构，再填内容</Text>
    </Box>
    <Box style={{ width: 560, flexDirection: 'column' }}>
      <Box style={{ width: 560, height: 336, borderRadius: 8, border: '1px solid #E5E7EB', overflow: 'hidden' }}>
        <Image src="assets/metrics-system.svg" style={{ width: 560, height: 336, objectFit: 'contain' }} />
      </Box>
      <Box style={{ width: 560, background: '#F5F3FF', borderRadius: 8, padding: '12px 18px', marginTop: 12 }}>
        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#5B21B6' }}>先记结构：最上一个数 · 中间五个格子 · 最下一条护栏</Text>
