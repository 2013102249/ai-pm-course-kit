<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: 60, position: 'relative' }}>
  <Box style={{ position: 'absolute', top: 24, left: 60, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
    <Box style={{ width: 8, height: 24, background: '#7C3AED', borderRadius: 4 }} />
    <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W4D4</Text>
  </Box>
  <Box style={{ position: 'absolute', bottom: 20, right: 60 }}>
    <Text style={{ fontSize: 14, color: '#64748B' }}>04 / 18</Text>
  </Box>
  <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B' }}>从「有多少人用」到「用得值不值」</Text>
  <Box style={{ width: '100%', height: 1, background: '#E5E7EB', marginTop: 18, marginBottom: 30 }} />
  <Box style={{ flexDirection: 'row', gap: 28, width: '100%' }}>
    <Box style={{ width: 460, background: '#EFF6FF', borderRadius: 12, padding: '26px 30px' }}>
      <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E1B4B' }}>传统指标 = 流量视角</Text>
      <Text style={{ fontSize: 19, color: '#1E1B4B', marginTop: 16, lineHeight: 1.6 }}>回答的是「来了多少人」：<br />DAU、MAU、新增用户……<br />看 DAU 够吗？不够——它不告诉你「用得值不值」。</Text>
    </Box>
    <Box style={{ flex: 1, background: '#F5F3FF', borderRadius: 12, padding: '26px 30px' }}>
      <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#5B21B6' }}>AI 产品多了关键一步：生成 → 采纳</Text>
      <Text style={{ fontSize: 19, color: '#1E1B4B', marginTop: 16, lineHeight: 1.6 }}>用户来了，把生成结果扔掉一半，<br />这个产品在用户心里其实已经死了。<br />AI 指标回答的是「用得值不值」。</Text>
    </Box>
  </Box>
  <Box style={{ width: '100%', background: '#FFFFFF', border: '1px solid #E5E7EB', borderRadius: 12, padding: '24px 32px', marginTop: 30, flexDirection: 'row', alignItems: 'center', justifyContent: 'center', gap: 20 }}>
    <Box style={{ background: '#EFF6FF', borderRadius: 10, padding: '14px 30px' }}>
      <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#2563EB' }}>生成</Text>
    </Box>
    <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#94A3B8' }}>→</Text>
    <Box style={{ background: '#7C3AED', borderRadius: 10, padding: '14px 30px' }}>
      <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#FFFFFF' }}>采纳（关键一步）</Text>
    </Box>
    <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#94A3B8' }}>→</Text>
    <Box style={{ background: '#EFF6FF', borderRadius: 10, padding: '14px 30px' }}>
      <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#2563EB' }}>留存</Text>
    </Box>
  </Box>
</Slide>
