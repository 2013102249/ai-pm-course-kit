<Slide style={{ width: 1280, height: 720, padding: '60px 60px', background: '#FFFFFF' }}>
  <Box style={{ position: 'absolute', top: 24, left: 60, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
    <Box style={{ width: 8, height: 24, background: '#7C3AED', borderRadius: 2 }} />
    <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W4D5</Text>
  </Box>
  <Box style={{ position: 'absolute', bottom: 26, right: 60 }}>
    <Text style={{ fontSize: 14, color: '#64748B' }}>05 / 10</Text>
  </Box>
  <Box style={{ flexDirection: 'column', gap: 18, marginBottom: 22 }}>
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B' }}>四维评分标准</Text>
    <Box style={{ width: '100%', height: 1, background: '#E5E7EB' }} />
  </Box>
  <Box style={{ flex: 1, flexDirection: 'column', gap: 18 }}>
    <Box style={{ width: 1160, border: '1px solid #E5E7EB', borderRadius: 12, overflow: 'hidden' }}>
      <Table
        style={{ width: '100%', height: 356 }}
        defaultTextStyle={{ fontSize: 15, textAlign: 'left', color: '#1E1B4B', lineHeight: 1.4 }}
        defaultCellStyle={{
          padding: '10px 16px',
          border: {
            left: { width: 1, color: '#E5E7EB' },
            right: { width: 1, color: '#E5E7EB' },
            top: { width: 1, color: '#E5E7EB' },
            bottom: { width: 1, color: '#E5E7EB' },
          },
        }}
        cells={[
          [
            { text: '维度', textStyle: { bold: true, color: '#FFFFFF', fontSize: 16 }, cellStyle: { background: { color: '#7C3AED' } } },
            { text: '2 分及以下', textStyle: { bold: true, color: '#FFFFFF', fontSize: 16 }, cellStyle: { background: { color: '#7C3AED' } } },
            { text: '3 分', textStyle: { bold: true, color: '#FFFFFF', fontSize: 16 }, cellStyle: { background: { color: '#7C3AED' } } },
            { text: '4–5 分', textStyle: { bold: true, color: '#FFFFFF', fontSize: 16 }, cellStyle: { background: { color: '#7C3AED' } } },
          ],
          [
            { text: '目标清晰度', textStyle: { bold: true, fontSize: 16 } },
            { text: '说不清目标用户 / 场景，或「所有人都能用」' },
            { text: '用户与场景明确，但指标无目标值' },
            { text: '用户、场景、指标、目标值齐全且能说明取舍' },
          ],
          [
            { text: '方案完整性', textStyle: { bold: true, fontSize: 16 }, cellStyle: { background: { color: '#F1EBFD' } } },
            { text: '核心链路讲不清，或缺评测 / 兜底 / 指标任一章', cellStyle: { background: { color: '#F1EBFD' } } },
            { text: '十章齐全但评测 / 兜底不可执行', cellStyle: { background: { color: '#F1EBFD' } } },
            { text: '链路清楚，评测可执行、兜底覆盖 P0、估时有依据', cellStyle: { background: { color: '#F1EBFD' } } },
          ],
          [
            { text: '数据支撑', textStyle: { bold: true, fontSize: 16 } },
            { text: '关键结论无数据，或引不出原始记录' },
            { text: '有引用但样本低于底线（访谈 <5 或问卷 <30）' },
            { text: '≥5 访谈 + ≥30 问卷，关键结论可回溯到原声 / 原表' },
          ],
          [
            { text: '风险识别', textStyle: { bold: true, fontSize: 16 }, cellStyle: { background: { color: '#F1EBFD' } } },
            { text: '无风险章或只写「有风险」', cellStyle: { background: { color: '#F1EBFD' } } },
            { text: '列了风险但无应对', cellStyle: { background: { color: '#F1EBFD' } } },
            { text: '风险分级（P0 / P1），P0 全部有兜底与触发条件', cellStyle: { background: { color: '#F1EBFD' } } },
          ],
        ]}
      />
    </Box>
    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14, background: '#F5F3FF', borderRadius: 12, padding: '14px 22px' }}>
      <Box style={{ width: 28, height: 28, background: '#7C3AED', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
        <Text style={{ fontSize: 14, color: '#FFFFFF', fontWeight: 'bold' }}>!</Text>
      </Box>
      <Text style={{ fontSize: 18, color: '#1E1B4B' }}>四个维度各 <span style={{ color: '#2563EB', fontWeight: 'bold' }}>0–5 分</span>；打分前先对档位表。示例：指标无目标值，最高判 <span style={{ color: '#2563EB', fontWeight: 'bold' }}>3 分</span></Text>
    </Box>
  </Box>
</Slide>
