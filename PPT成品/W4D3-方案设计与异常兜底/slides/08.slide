<Slide style={{ width: 1280, height: 720, padding: 60, background: '#FFFFFF', fontFamily: "'Microsoft YaHei', sans-serif", position: 'relative' }}>
  <Box style={{ position: 'absolute', top: 24, left: 60, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
    <Box style={{ width: 8, height: 24, background: '#7C3AED', borderRadius: 4 }} />
    <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W4D3</Text>
  </Box>
  <Box style={{ position: 'absolute', bottom: 30, right: 60 }}>
    <Text style={{ fontSize: 14, color: '#64748B' }}>08 / 16</Text>
  </Box>
  <Box style={{ flexDirection: 'column', gap: 20, height: '100%' }}>
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B' }}>画图三条纪律</Text>
    <Box style={{ width: '100%', height: 1, background: '#E5E7EB' }} />
    <Box style={{ flexDirection: 'column', gap: 22, paddingTop: 8 }}>
      <Box style={{ flexDirection: 'row', alignItems: 'center', background: '#F5F3FF', borderRadius: 12, padding: '26px 34px', width: '100%', gap: 30 }}>
        <Text style={{ fontSize: 44, fontWeight: 'bold', color: '#7C3AED', width: 70 }}>1</Text>
        <Box style={{ width: 1, height: 48, background: '#E5E7EB' }} />
        <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#1E1B4B' }}>每个状态标超时值</Text>
        <Text style={{ fontSize: 16, color: '#64748B', marginLeft: 'auto' }}>没有超时值的状态会永远卡住</Text>
      </Box>
      <Box style={{ flexDirection: 'row', alignItems: 'center', background: '#EFF6FF', borderRadius: 12, padding: '26px 34px', width: '100%', gap: 30 }}>
        <Text style={{ fontSize: 44, fontWeight: 'bold', color: '#2563EB', width: 70 }}>2</Text>
        <Box style={{ width: 1, height: 48, background: '#E5E7EB' }} />
        <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#1E1B4B' }}>每个异常有出口</Text>
        <Text style={{ fontSize: 16, color: '#64748B', marginLeft: 'auto' }}>异常不是终点，必须给出路</Text>
      </Box>
      <Box style={{ flexDirection: 'row', alignItems: 'center', background: '#F5F3FF', borderRadius: 12, padding: '26px 34px', width: '100%', gap: 30 }}>
        <Text style={{ fontSize: 44, fontWeight: 'bold', color: '#7C3AED', width: 70 }}>3</Text>
        <Box style={{ width: 1, height: 48, background: '#E5E7EB' }} />
        <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#1E1B4B' }}>恢复指回具体状态</Text>
        <Text style={{ fontSize: 16, color: '#64748B', marginLeft: 'auto' }}>不能只画一个模糊的「恢复」</Text>
      </Box>
    </Box>
  </Box>
</Slide>
