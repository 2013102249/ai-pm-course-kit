<Slide style={{ width: 1280, height: 720, padding: 60, background: '#FFFFFF', fontFamily: "'Microsoft YaHei', sans-serif", position: 'relative' }}>
  <Box style={{ position: 'absolute', top: 24, left: 60, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
    <Box style={{ width: 8, height: 24, background: '#7C3AED', borderRadius: 4 }} />
    <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W4D3</Text>
  </Box>
  <Box style={{ position: 'absolute', bottom: 30, right: 60 }}>
    <Text style={{ fontSize: 14, color: '#64748B' }}>10 / 16</Text>
  </Box>
  <Box style={{ flexDirection: 'column', gap: 18, height: '100%' }}>
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B' }}>第一件 · 降级　+　第二件 · 澄清</Text>
    <Box style={{ width: '100%', height: 1, background: '#E5E7EB' }} />
    <Box style={{ flexDirection: 'row', gap: 24, flex: 1 }}>
      <Box style={{ flex: 1, background: '#F5F3FF', borderRadius: 12, padding: '22px 26px', flexDirection: 'column', gap: 14 }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
          <Box style={{ width: 10, height: 30, background: '#7C3AED', borderRadius: 4 }} />
          <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#7C3AED' }}>降级</Text>
        </Box>
        <Text style={{ fontSize: 16, color: '#64748B' }}>触发条件</Text>
        <Text style={{ fontSize: 18, color: '#1E1B4B', lineHeight: 1.7 }}>超时 <span style={{ fontWeight: 'bold' }}>&gt;10 秒</span> / 连续失败 <span style={{ fontWeight: 'bold' }}>≥2 次</span> / 敏感词拦截</Text>
        <Text style={{ fontSize: 16, color: '#64748B' }}>产品动作</Text>
        <Text style={{ fontSize: 18, color: '#1E1B4B', lineHeight: 1.7 }}>规则话术 + 缓存答案</Text>
      </Box>
      <Box style={{ flex: 1, background: '#EFF6FF', borderRadius: 12, padding: '22px 26px', flexDirection: 'column', gap: 14 }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
          <Box style={{ width: 10, height: 30, background: '#2563EB', borderRadius: 4 }} />
          <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#2563EB' }}>澄清</Text>
        </Box>
        <Text style={{ fontSize: 16, color: '#64748B' }}>触发条件</Text>
        <Text style={{ fontSize: 18, color: '#1E1B4B', lineHeight: 1.7 }}>置信度 <span style={{ fontWeight: 'bold' }}>&lt;0.6</span></Text>
        <Text style={{ fontSize: 16, color: '#64748B' }}>产品动作</Text>
        <Text style={{ fontSize: 18, color: '#1E1B4B', lineHeight: 1.7 }}>追问 1 次必带选项</Text>
      </Box>
    </Box>
    <Box style={{ background: '#F5F3FF', borderRadius: 10, padding: '14px 24px', flexDirection: 'row', alignItems: 'center', gap: 18 }}>
      <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#7C3AED' }}>文案示例逐句拆</Text>
      <Text style={{ fontSize: 17, color: '#1E1B4B' }}>认账 <span style={{ color: '#7C3AED', fontWeight: 'bold' }}>→</span> 给预期 <span style={{ color: '#7C3AED', fontWeight: 'bold' }}>→</span> 给出路</Text>
    </Box>
  </Box>
</Slide>
