      </Box>
      <Box style={{ flex: 1, flexDirection: 'column', gap: 12, paddingTop: 4 }}>
        <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#7C3AED' }}>四连问</Text>
        <Box style={{ background: '#F5F3FF', borderRadius: 10, padding: '10px 18px', flexDirection: 'row', alignItems: 'center', gap: 14 }}>
          <Box style={{ width: 26, height: 26, background: '#7C3AED', borderRadius: 5, alignItems: 'center', justifyContent: 'center' }}><Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>1</Text></Box>
          <Text style={{ fontSize: 19, color: '#1E1B4B' }}>能理解吗</Text>
        </Box>
        <Box style={{ background: '#F5F3FF', borderRadius: 10, padding: '10px 18px', flexDirection: 'row', alignItems: 'center', gap: 14 }}>
          <Box style={{ width: 26, height: 26, background: '#7C3AED', borderRadius: 5, alignItems: 'center', justifyContent: 'center' }}><Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>2</Text></Box>
          <Text style={{ fontSize: 19, color: '#1E1B4B' }}>能答吗</Text>
        </Box>
        <Box style={{ background: '#F5F3FF', borderRadius: 10, padding: '10px 18px', flexDirection: 'row', alignItems: 'center', gap: 14 }}>
          <Box style={{ width: 26, height: 26, background: '#7C3AED', borderRadius: 5, alignItems: 'center', justifyContent: 'center' }}><Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>3</Text></Box>
          <Text style={{ fontSize: 19, color: '#1E1B4B' }}>答得出吗</Text>
        </Box>
        <Box style={{ background: '#F5F3FF', borderRadius: 10, padding: '10px 18px', flexDirection: 'row', alignItems: 'center', gap: 14 }}>
          <Box style={{ width: 26, height: 26, background: '#7C3AED', borderRadius: 5, alignItems: 'center', justifyContent: 'center' }}><Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>4</Text></Box>
