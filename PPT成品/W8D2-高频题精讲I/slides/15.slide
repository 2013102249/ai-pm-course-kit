<Slide style={{ width: 1280, height: 720, padding: 60, background: '#FFFFFF', fontFamily: 'Microsoft YaHei' }}>
    <Box style={{ position: 'absolute', top: 24, left: 60, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
        <Box style={{ width: 8, height: 24, background: '#7C3AED', borderRadius: 4 }} />
        <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W8D2</Text>
    </Box>
    <Box style={{ position: 'absolute', bottom: 26, right: 60 }}>
        <Text style={{ fontSize: 14, color: '#64748B' }}>15 / 20</Text>
    </Box>
    <Box style={{ flexDirection: 'column' }}>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B' }}>六步逐步：方案 / 指标 / 风险</Text>
        <Box style={{ width: '100%', height: 1, background: '#E5E7EB', marginTop: 16 }} />
        <Box style={{ flexDirection: 'row', gap: 28, marginTop: 24, alignItems: 'flex-start' }}>
            <Box style={{ flex: 1, flexDirection: 'column', gap: 16 }}>
                <Box style={{ background: '#F5F3FF', borderRadius: 12, padding: '18px 22px' }}>
                    <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#7C3AED' }}>④ 方案</Text>
                    <Text style={{ fontSize: 15, color: '#1E1B4B', marginTop: 6 }}>与痛点一一对应，不堆功能</Text>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#1E1B4B', marginTop: 4 }}>跑偏：功能堆砌、与痛点脱节</Text>
                </Box>
                <Box style={{ background: '#F5F3FF', borderRadius: 12, padding: '18px 22px' }}>
                    <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#7C3AED' }}>⑤ 指标</Text>
                    <Text style={{ fontSize: 15, color: '#1E1B4B', marginTop: 6 }}>可量化、可验收的成功标准</Text>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#1E1B4B', marginTop: 4 }}>跑偏：说「提升用户体验」</Text>
                </Box>
                <Box style={{ background: '#F5F3FF', borderRadius: 12, padding: '18px 22px' }}>
                    <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#7C3AED' }}>⑥ 风险</Text>
                    <Text style={{ fontSize: 15, color: '#1E1B4B', marginTop: 6 }}>技术风险 + 合规风险 + 应对</Text>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#1E1B4B', marginTop: 4 }}>跑偏：整步漏掉、只提技术</Text>
                </Box>
            </Box>
            <Image src="assets/scenario-six-steps.svg" style={{ width: 620, height: 362 }} />
        </Box>
    </Box>
</Slide>
