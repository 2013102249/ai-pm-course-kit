<Slide style={{ width: 1280, height: 720, padding: 60, background: '#FFFFFF', fontFamily: 'Microsoft YaHei' }}>
    <Box style={{ position: 'absolute', top: 24, left: 60, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
        <Box style={{ width: 8, height: 24, background: '#7C3AED', borderRadius: 4 }} />
        <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W8D2</Text>
    </Box>
    <Box style={{ position: 'absolute', bottom: 26, right: 60 }}>
        <Text style={{ fontSize: 14, color: '#64748B' }}>14 / 20</Text>
    </Box>
    <Box style={{ flexDirection: 'column' }}>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B' }}>六步逐步：人群 / 场景 / 痛点</Text>
        <Box style={{ width: '100%', height: 1, background: '#E5E7EB', marginTop: 16 }} />
        <Box style={{ flexDirection: 'row', gap: 28, marginTop: 24, alignItems: 'flex-start' }}>
            <Image src="assets/scenario-six-steps.svg" style={{ width: 620, height: 362 }} />
            <Box style={{ flex: 1, flexDirection: 'column', gap: 16 }}>
                <Box style={{ background: '#F5F3FF', borderRadius: 12, padding: '18px 22px' }}>
                    <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#7C3AED' }}>① 人群</Text>
                    <Text style={{ fontSize: 15, color: '#1E1B4B', marginTop: 6 }}>产出：一类可命名、可触达的人</Text>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#1E1B4B', marginTop: 4 }}>跑偏：说「所有人」「有需要的人」</Text>
                </Box>
                <Box style={{ background: '#F5F3FF', borderRadius: 12, padding: '18px 22px' }}>
                    <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#7C3AED' }}>② 场景</Text>
                    <Text style={{ fontSize: 15, color: '#1E1B4B', marginTop: 6 }}>产出：时间、地点、频次的真实情境</Text>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#1E1B4B', marginTop: 4 }}>跑偏：只讲情境、不讲频次</Text>
                </Box>
                <Box style={{ background: '#F5F3FF', borderRadius: 12, padding: '18px 22px' }}>
                    <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#7C3AED' }}>③ 痛点</Text>
                    <Text style={{ fontSize: 15, color: '#1E1B4B', marginTop: 6 }}>产出：真实问题 + 后果</Text>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#1E1B4B', marginTop: 4 }}>跑偏：痛点靠猜、与人群错位</Text>
                </Box>
            </Box>
        </Box>
    </Box>
</Slide>
