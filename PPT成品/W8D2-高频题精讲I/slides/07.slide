<Slide style={{ width: 1280, height: 720, padding: 60, background: '#FFFFFF', fontFamily: 'Microsoft YaHei' }}>
    <Box style={{ position: 'absolute', top: 24, left: 60, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
        <Box style={{ width: 8, height: 24, background: '#7C3AED', borderRadius: 4 }} />
        <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W8D2</Text>
    </Box>
    <Box style={{ position: 'absolute', bottom: 26, right: 60 }}>
        <Text style={{ fontSize: 14, color: '#64748B' }}>07 / 20</Text>
    </Box>
    <Box style={{ flexDirection: 'column' }}>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B' }}>第一问：数据怎么来的</Text>
        <Box style={{ width: '100%', height: 1, background: '#E5E7EB', marginTop: 16 }} />
        <Text style={{ fontSize: 19, color: '#64748B', marginTop: 22 }}>防御 = 数据三件套</Text>
        <Box style={{ flexDirection: 'row', gap: 20, marginTop: 16 }}>
            <Box style={{ flex: 1, background: '#F5F3FF', borderRadius: 12, padding: '20px 24px', alignItems: 'center' }}>
                <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#7C3AED' }}>来源</Text>
                <Text style={{ fontSize: 16, color: '#1E1B4B', marginTop: 6, textAlign: 'center' }}>从哪个后台、什么埋点</Text>
            </Box>
            <Box style={{ flex: 1, background: '#F5F3FF', borderRadius: 12, padding: '20px 24px', alignItems: 'center' }}>
                <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#7C3AED' }}>口径</Text>
                <Text style={{ fontSize: 16, color: '#1E1B4B', marginTop: 6, textAlign: 'center' }}>分子分母怎么算</Text>
            </Box>
            <Box style={{ flex: 1, background: '#F5F3FF', borderRadius: 12, padding: '20px 24px', alignItems: 'center' }}>
                <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#7C3AED' }}>基线</Text>
                <Text style={{ fontSize: 16, color: '#1E1B4B', marginTop: 6, textAlign: 'center' }}>跟谁比、比多久</Text>
            </Box>
        </Box>
        <Box style={{ flexDirection: 'row', gap: 24, marginTop: 28, alignItems: 'stretch' }}>
            <Box style={{ flex: 1.4, background: '#EFF6FF', borderRadius: 12, padding: '26px 30px', border: '1px solid #BFDBFE' }}>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#2563EB' }}>示范说法 · 完整数字版</Text>
                <Text style={{ fontSize: 18, color: '#1E1B4B', lineHeight: 1.7, marginTop: 14 }}>
                    「上线 4 周后，周活跃用户从 <span style={{ fontWeight: 'bold' }}>1,200</span> 增长到 <span style={{ fontWeight: 'bold' }}>1,560</span>；来源是埋点后台，口径是周活跃用户数，基线是上线前一个月的周均值。」
                </Text>
            </Box>
            <Box style={{ flex: 1, background: '#F8FAFC', borderRadius: 12, padding: '26px 30px', border: '1px solid #E5E7EB' }}>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#64748B' }}>反例</Text>
                <Text style={{ fontSize: 18, color: '#64748B', lineHeight: 1.7, marginTop: 14 }}>「我们数据挺好的，涨了很多。」</Text>
                <Text style={{ fontSize: 16, color: '#64748B', marginTop: 14 }}>没有数字、没有来源，等于没答。</Text>
            </Box>
        </Box>
    </Box>
</Slide>
