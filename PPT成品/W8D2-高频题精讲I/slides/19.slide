<Slide style={{ width: 1280, height: 720, padding: 60, background: '#FFFFFF', fontFamily: 'Microsoft YaHei' }}>
    <Box style={{ position: 'absolute', top: 24, left: 60, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
        <Box style={{ width: 8, height: 24, background: '#7C3AED', borderRadius: 4 }} />
        <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W8D2</Text>
    </Box>
    <Box style={{ position: 'absolute', bottom: 26, right: 60 }}>
        <Text style={{ fontSize: 14, color: '#64748B' }}>19 / 20</Text>
    </Box>
    <Box style={{ flexDirection: 'column' }}>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B' }}>现场演练</Text>
        <Box style={{ width: '100%', height: 1, background: '#E5E7EB', marginTop: 16 }} />
        <Box style={{ flexDirection: 'row', gap: 40, marginTop: 36, alignItems: 'stretch' }}>
            <Box style={{ flex: 1, flexDirection: 'column', gap: 18 }}>
                <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E1B4B' }}>演练规则</Text>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16, background: '#F5F3FF', borderRadius: 12, padding: '20px 24px' }}>
                    <Box style={{ width: 28, height: 28, background: '#7C3AED', borderRadius: 6, justifyContent: 'center', alignItems: 'center' }}><Text style={{ fontSize: 14, fontWeight: 'bold', color: '#FFFFFF' }}>1</Text></Box>
                    <Text style={{ fontSize: 19, color: '#1E1B4B' }}>2 人各抽 1 题，轮流作答</Text>
                </Box>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16, background: '#F5F3FF', borderRadius: 12, padding: '20px 24px' }}>
                    <Box style={{ width: 28, height: 28, background: '#7C3AED', borderRadius: 6, justifyContent: 'center', alignItems: 'center' }}><Text style={{ fontSize: 14, fontWeight: 'bold', color: '#FFFFFF' }}>2</Text></Box>
                    <Text style={{ fontSize: 19, color: '#1E1B4B' }}>对方追问 2 层，必须接住</Text>
                </Box>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16, background: '#F5F3FF', borderRadius: 12, padding: '20px 24px' }}>
                    <Box style={{ width: 28, height: 28, background: '#7C3AED', borderRadius: 6, justifyContent: 'center', alignItems: 'center' }}><Text style={{ fontSize: 14, fontWeight: 'bold', color: '#FFFFFF' }}>3</Text></Box>
                    <Text style={{ fontSize: 19, color: '#1E1B4B' }}>全班点评，讲师收口</Text>
                </Box>
            </Box>
            <Box style={{ width: 520, flexDirection: 'column' }}>
                <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E1B4B', marginBottom: 18 }}>计分板</Text>
                <Box style={{ border: '1px solid #DDD2F7', borderRadius: 12, overflow: 'hidden' }}>
                    <Table
                        style={{ width: '100%', height: 264 }}
                        defaultTextStyle={{ fontSize: 18, textAlign: 'center', color: '#1E1B4B' }}
                        defaultCellStyle={{
                            border: {
                                left: { width: 1, color: '#E5E7EB' },
                                right: { width: 1, color: '#E5E7EB' },
                                top: { width: 1, color: '#E5E7EB' },
                                bottom: { width: 1, color: '#E5E7EB' },
                            },
                        }}
                        cells={[
                            [
                                { text: '计分项', textStyle: { bold: true, color: '#FFFFFF', fontSize: 18 }, cellStyle: { background: { color: '#7C3AED' } } },
                                { text: '分值', textStyle: { bold: true, color: '#FFFFFF', fontSize: 18 }, cellStyle: { background: { color: '#7C3AED' } } },
                            ],
                            [{ text: '框架（六步走全）' }, { text: '50 分', textStyle: { bold: true, color: '#7C3AED' } }],
                            [{ text: '内容（证据链扎实）', cellStyle: { background: { color: '#F5F3FF' } } }, { text: '50 分', textStyle: { bold: true, color: '#2563EB' }, cellStyle: { background: { color: '#F5F3FF' } } }],
                            [{ text: '合计', cellStyle: { background: { color: '#EFF6FF' } } }, { text: '100 分', textStyle: { bold: true }, cellStyle: { background: { color: '#EFF6FF' } } }],
                        ]}
                    />
                </Box>
                <Text style={{ fontSize: 15, color: '#64748B', marginTop: 14 }}>作答过程离开 PPT，聚焦现场</Text>
            </Box>
        </Box>
    </Box>
</Slide>
