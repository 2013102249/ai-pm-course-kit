            <Box style={{ flex: 1, background: '#EFF6FF', borderRadius: 14, padding: 30, flexDirection: 'column', gap: 14 }}>
                <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#2563EB' }}>模式四 · API 调用</Text>
                <Text style={{ fontSize: 18, color: '#1E1B4B', lineHeight: 1.6 }}><span style={{ fontWeight: 'bold' }}>怎么收费：</span>按 token 千次批发价，量大折扣大</Text>
                <Text style={{ fontSize: 18, color: '#1E1B4B', lineHeight: 1.6 }}><span style={{ fontWeight: 'bold' }}>适合：</span>平台型公司、开发者生态</Text>
                <Text style={{ fontSize: 18, color: '#16A34A', lineHeight: 1.6 }}>优势：规模效应最强，替换成本高</Text>
