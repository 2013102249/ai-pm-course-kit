<Slide style={{ width: 1280, height: 720, padding: 60, background: '#FFFFFF', fontFamily: 'Microsoft YaHei', position: 'relative' }}>
    <Box style={{ position: 'absolute', top: 24, left: 60, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
        <Box style={{ width: 8, height: 24, background: '#7C3AED', borderRadius: 2 }} />
        <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W5D3</Text>
    </Box>
    <Text style={{ position: 'absolute', bottom: 24, right: 60, fontSize: 14, color: '#64748B' }}>10 / 18</Text>
    <Text style={{ position: 'absolute', bottom: 24, left: 60, fontSize: 14, color: '#64748B' }}>教学示例，以官网实时价格为准</Text>
    <Box style={{ flex: 1, flexDirection: 'column' }}>
        <Box style={{ flexDirection: 'column', gap: 18 }}>
            <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B' }}>成本侧：一个公式</Text>
            <Box style={{ width: '100%', height: 1, background: '#E5E7EB' }} />
        </Box>
        <Box style={{ flex: 1, flexDirection: 'column', justifyContent: 'center', gap: 32 }}>
            <Box style={{ flexDirection: 'row', alignItems: 'center', justifyContent: 'center', gap: 24 }}>
                <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B', letterSpacing: 1 }}>单次成本 =</Text>
                <Box style={{ background: '#F5F3FF', border: '2px solid #7C3AED', borderRadius: 12, padding: '22px 28px', flexDirection: 'column', gap: 8 }}>
                    <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#7C3AED' }}>输入部分</Text>
                    <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#1E1B4B', letterSpacing: 1 }}>输入 token ÷ 1000 × 输入单价</Text>
                </Box>
                <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B' }}>+</Text>
                <Box style={{ background: '#EFF6FF', border: '2px solid #2563EB', borderRadius: 12, padding: '22px 28px', flexDirection: 'column', gap: 8 }}>
                    <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#2563EB' }}>输出部分</Text>
                    <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#1E1B4B', letterSpacing: 1 }}>输出 token ÷ 1000 × 输出单价</Text>
                </Box>
            </Box>
            <Box style={{ flexDirection: 'row', justifyContent: 'center', gap: 20 }}>
                <Box style={{ background: '#7C3AED', borderRadius: 8, padding: '12px 24px' }}>
                    <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#FFFFFF' }}>输入单价和输出单价是两个数</Text>
                </Box>
                <Box style={{ background: '#F5F3FF', borderRadius: 8, padding: '12px 24px' }}>
                    <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#7C3AED' }}>输出通常比输入贵</Text>
                </Box>
            </Box>
        </Box>
    </Box>
</Slide>
