<Slide style={{ width: 1280, height: 720, padding: 60, background: '#FFFFFF', fontFamily: 'Microsoft YaHei', position: 'relative' }}>
    <Box style={{ position: 'absolute', top: 24, left: 60, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
        <Box style={{ width: 8, height: 24, background: '#7C3AED', borderRadius: 2 }} />
        <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W5D3</Text>
    </Box>
    <Text style={{ position: 'absolute', bottom: 24, right: 60, fontSize: 14, color: '#64748B' }}>13 / 18</Text>
    <Text style={{ position: 'absolute', bottom: 24, left: 60, fontSize: 14, color: '#64748B' }}>教学示例，以官网实时价格为准</Text>
    <Box style={{ flex: 1, flexDirection: 'column' }}>
        <Box style={{ flexDirection: 'column', gap: 18 }}>
            <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B' }}>当堂测：换组数字你还会算吗</Text>
            <Box style={{ width: '100%', height: 1, background: '#E5E7EB' }} />
        </Box>
        <Box style={{ flex: 1, flexDirection: 'column', justifyContent: 'center', gap: 20 }}>
            <Box style={{ background: '#F5F3FF', border: '2px solid #7C3AED', borderRadius: 12, padding: '24px 32px', flexDirection: 'column', gap: 10 }}>
                <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#7C3AED' }}>题目：这次对话的单次成本是多少？（1 分钟，算完举手）</Text>
                <Text style={{ fontSize: 28, fontWeight: 'bold', color: '#1E1B4B', letterSpacing: 2 }}>输入 500 token @ 0.01　·　输出 500 token @ 0.03</Text>
            </Box>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 24 }}>
                <Box style={{ background: '#F0FDF4', border: '2px solid #16A34A', borderRadius: 10, padding: '14px 28px' }}>
                    <Text style={{ fontSize: 30, fontWeight: 'bold', color: '#16A34A', letterSpacing: 2 }}>答案：0.02 元</Text>
                </Box>
                <Box style={{ background: '#EFF6FF', borderRadius: 10, padding: '14px 28px' }}>
                    <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#2563EB' }}>成本大头在输出</Text>
                </Box>
            </Box>
            <Box style={{ background: 'linear-gradient(135deg, #4C1D95 0%, #7C3AED 100%)', borderRadius: 12, padding: '26px 36px' }}>
                <Text style={{ fontSize: 28, fontWeight: 'bold', color: '#FFFFFF', lineHeight: 1.5 }}>「不懂 token 成本的产品经理，管不好 AI 产品的毛利」</Text>
