<Slide style={{ width: 1280, height: 720, padding: 60, background: '#FFFFFF' }}>
    <Box style={{ position: 'absolute', top: 24, left: 60, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
        <Box style={{ width: 8, height: 24, background: '#7C3AED', borderRadius: 4 }} />
        <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W2D3</Text>
    </Box>
    <Text style={{ position: 'absolute', bottom: 24, right: 60, fontSize: 14, color: '#64748B' }}>16 / 18</Text>
    <Box style={{ flexDirection: 'column', gap: 16 }}>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B' }}>谁来打分：人工 vs LLM-as-Judge</Text>
        <Box style={{ width: '100%', height: 1, background: '#E5E7EB' }} />
    </Box>
    <Box style={{ flexDirection: 'row', gap: 32, marginTop: 40, alignItems: 'stretch' }}>
        <Box style={{ width: 460, flexDirection: 'column', gap: 20 }}>
            <Box style={{ background: '#F5F3FF', borderRadius: 12, padding: 26, flexDirection: 'column', gap: 10 }}>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#7C3AED' }}>人工打分</Text>
                <Text style={{ fontSize: 17, color: '#1E1B4B', lineHeight: 1.6 }}>判断准、贴近真实体验，但慢而贵，50 条尚可、上千条扛不住。</Text>
            </Box>
            <Box style={{ background: '#EFF6FF', borderRadius: 12, padding: 26, flexDirection: 'column', gap: 10 }}>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#2563EB' }}>LLM-as-Judge</Text>
                <Text style={{ fontSize: 17, color: '#1E1B4B', lineHeight: 1.6 }}>打分快而便宜，能全量覆盖；但<span style={{ fontWeight: 'bold', color: '#2563EB' }}>裁判会偏</span>——位置偏好、长度偏好、自我偏好。</Text>
            </Box>
        </Box>
        <Box style={{ flex: 1, background: '#F5F3FF', borderRadius: 12, padding: 32, flexDirection: 'column', justifyContent: 'space-between' }}>
            <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E1B4B' }}>落地方案：混合打分</Text>
            <Box style={{ flexDirection: 'column', gap: 14 }}>
                <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#7C3AED' }}>全量 LLM 打分</Text>
                <Text style={{ fontSize: 17, color: '#1E1B4B', lineHeight: 1.6 }}>所有用例先由 LLM 按锚点标准打分，保证覆盖率与速度。</Text>
            </Box>
            <Box style={{ flexDirection: 'column', gap: 14 }}>
                <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#2563EB' }}>人工抽检 10%–20%</Text>
                <Text style={{ fontSize: 17, color: '#1E1B4B', lineHeight: 1.6 }}>定期抽样比对人工分与 LLM 分，校准偏差，修正评分标准。</Text>
            </Box>
        </Box>
    </Box>
</Slide>
