<Slide style={{ width: 1280, height: 720, padding: 60, background: '#FFFFFF' }}>
    <Box style={{ position: 'absolute', top: 24, left: 60, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
        <Box style={{ width: 8, height: 24, background: '#7C3AED', borderRadius: 4 }} />
        <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W2D3</Text>
    </Box>
    <Text style={{ position: 'absolute', bottom: 24, right: 60, fontSize: 14, color: '#64748B' }}>14 / 18</Text>
    <Box style={{ flexDirection: 'column', gap: 16 }}>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B' }}>归因破案：现象 → 假设 → 验证</Text>
        <Box style={{ width: '100%', height: 1, background: '#E5E7EB' }} />
    </Box>
    <Box style={{ marginTop: 20, background: '#F5F3FF', borderRadius: 10, padding: '14px 24px' }}>
        <Text style={{ fontSize: 17, color: '#64748B' }}>本页配合评估工具投屏讲解</Text>
    </Box>
    <Box style={{ flexDirection: 'row', gap: 16, marginTop: 32, height: 300 }}>
        <Box style={{ flex: 1, background: '#F5F3FF', borderRadius: 12, padding: 24, flexDirection: 'column', justifyContent: 'space-between' }}>
            <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1E1B4B' }}>逐一验证</Text>
            <Text style={{ fontSize: 17, color: '#1E1B4B', lineHeight: 1.6 }}>四类假设逐一验证，破案不跳步：每推翻一个假设，就排除一类原因。</Text>
        </Box>
        <Box style={{ flex: 1, background: '#EFF6FF', borderRadius: 12, padding: 24, flexDirection: 'column', justifyContent: 'space-between' }}>
            <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#2563EB' }}>主因：资料问题</Text>
            <Text style={{ fontSize: 17, color: '#1E1B4B', lineHeight: 1.6 }}>知识库里没有对应的权威资料，模型只能自由发挥——补资料即修复。</Text>
        </Box>
        <Box style={{ flex: 1, background: '#F5F3FF', borderRadius: 12, padding: 24, flexDirection: 'column', justifyContent: 'space-between' }}>
            <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1E1B4B' }}>次因：提示词问题</Text>
            <Text style={{ fontSize: 17, color: '#1E1B4B', lineHeight: 1.6 }}>提示词缺少约束导致答非所问，改提示词后复测验证。</Text>
        </Box>
        <Box style={{ flex: 1, background: '#EFF6FF', borderRadius: 12, padding: 24, flexDirection: 'column', justifyContent: 'space-between' }}>
            <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#2563EB' }}>模型能力不成立</Text>
            <Text style={{ fontSize: 17, color: '#1E1B4B', lineHeight: 1.6 }}>资料与提示词都排除后，才轮到怀疑模型能力——换模型再验。</Text>
        </Box>
    </Box>
    <Box style={{ marginTop: 28, background: '#F5F3FF', borderRadius: 10, padding: '14px 24px' }}>
        <Text style={{ fontSize: 17, color: '#1E1B4B' }}>结案动作：在<span style={{ fontWeight: 'bold', color: '#7C3AED' }}>备注栏写结案陈词</span>——现象、根因、修复动作一句话记录，方便复盘。现场切 badcase 开关，看统计读数联动。</Text>
    </Box>
</Slide>
