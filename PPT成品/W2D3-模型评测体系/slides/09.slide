                <Text style={{ fontSize: 44, fontWeight: 'bold', color: '#7C3AED', width: 90 }}>30</Text>
                <Box style={{ flexDirection: 'column', gap: 4 }}>
                    <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1E1B4B' }}>正例</Text>
                    <Text style={{ fontSize: 16, color: '#64748B' }}>常规场景，考察模型应答的基本盘</Text>
                </Box>
            </Box>
            <Box style={{ background: '#EFF6FF', borderRadius: 12, padding: '20px 28px', flexDirection: 'row', alignItems: 'center', gap: 20 }}>
                <Text style={{ fontSize: 44, fontWeight: 'bold', color: '#2563EB', width: 90 }}>10</Text>
                <Box style={{ flexDirection: 'column', gap: 4 }}>
                    <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1E1B4B' }}>负例</Text>
                    <Text style={{ fontSize: 16, color: '#64748B' }}>故意设坑，负例防翻车</Text>
