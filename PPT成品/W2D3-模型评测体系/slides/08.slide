<Slide style={{ width: 1280, height: 720, padding: 60, background: '#FFFFFF' }}>
    <Box style={{ position: 'absolute', top: 24, left: 60, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
        <Box style={{ width: 8, height: 24, background: '#7C3AED', borderRadius: 4 }} />
        <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W2D3</Text>
    </Box>
    <Text style={{ position: 'absolute', bottom: 24, right: 60, fontSize: 14, color: '#64748B' }}>08 / 18</Text>
    <Box style={{ flexDirection: 'column', gap: 16 }}>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B' }}>第一步：定场景、定维度</Text>
        <Box style={{ width: '100%', height: 1, background: '#E5E7EB' }} />
    </Box>
    <Box style={{ flexDirection: 'row', gap: 16, marginTop: 40 }}>
        <Box style={{ background: '#7C3AED', borderRadius: 10, padding: '12px 22px' }}>
            <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#FFFFFF' }}>默认五维</Text>
        </Box>
        <Text style={{ fontSize: 18, color: '#64748B', lineHeight: 1.6 }}>先框定要测的场景，再从默认维度起步做增删。</Text>
    </Box>
    <Box style={{ flexDirection: 'row', gap: 14, marginTop: 24, height: 200 }}>
        <Box style={{ flex: 1, background: '#F5F3FF', borderRadius: 12, padding: 20, flexDirection: 'column', justifyContent: 'center', alignItems: 'center', gap: 12 }}>
            <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#7C3AED' }}>准确性</Text>
            <Text style={{ fontSize: 15, color: '#64748B', textAlign: 'center' }}>答得对不对，有没有编造</Text>
        </Box>
        <Box style={{ flex: 1, background: '#EFF6FF', borderRadius: 12, padding: 20, flexDirection: 'column', justifyContent: 'center', alignItems: 'center', gap: 12 }}>
            <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#2563EB' }}>帮助性</Text>
            <Text style={{ fontSize: 15, color: '#64748B', textAlign: 'center' }}>有没有真的解决用户问题</Text>
        </Box>
        <Box style={{ flex: 1, background: '#F5F3FF', borderRadius: 12, padding: 20, flexDirection: 'column', justifyContent: 'center', alignItems: 'center', gap: 12 }}>
            <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#7C3AED' }}>安全性</Text>
            <Text style={{ fontSize: 15, color: '#64748B', textAlign: 'center' }}>有没有违规、越界与风险话术</Text>
        </Box>
        <Box style={{ flex: 1, background: '#EFF6FF', borderRadius: 12, padding: 20, flexDirection: 'column', justifyContent: 'center', alignItems: 'center', gap: 12 }}>
            <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#2563EB' }}>格式规范性</Text>
            <Text style={{ fontSize: 15, color: '#64748B', textAlign: 'center' }}>输出结构是否符合产品要求</Text>
        </Box>
        <Box style={{ flex: 1, background: '#F5F3FF', borderRadius: 12, padding: 20, flexDirection: 'column', justifyContent: 'center', alignItems: 'center', gap: 12 }}>
            <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#7C3AED' }}>响应体验</Text>
            <Text style={{ fontSize: 15, color: '#64748B', textAlign: 'center' }}>语气、节奏与交互感受</Text>
        </Box>
    </Box>
    <Box style={{ flexDirection: 'row', gap: 20, marginTop: 32 }}>
        <Box style={{ flex: 1, background: '#F5F3FF', borderRadius: 10, padding: '16px 24px', flexDirection: 'row', alignItems: 'center', gap: 12 }}>
            <Box style={{ width: 8, height: 8, borderRadius: 4, background: '#7C3AED' }} />
            <Text style={{ fontSize: 18, color: '#1E1B4B' }}>维度数量取 <span style={{ fontWeight: 'bold', color: '#7C3AED' }}>3–8 个</span>：少了测不全，多了评不动。</Text>
        </Box>
        <Box style={{ flex: 1, background: '#EFF6FF', borderRadius: 10, padding: '16px 24px', flexDirection: 'row', alignItems: 'center', gap: 12 }}>
            <Box style={{ width: 8, height: 8, borderRadius: 4, background: '#2563EB' }} />
            <Text style={{ fontSize: 18, color: '#1E1B4B' }}><span style={{ fontWeight: 'bold', color: '#2563EB' }}>可判断才算维度</span>：打分人意见不一致的维度，删掉。</Text>
        </Box>
    </Box>
</Slide>
