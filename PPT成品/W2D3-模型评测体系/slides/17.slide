        <Box style={{ flex: 1, background: '#F5F3FF', borderRadius: 12, padding: 24, flexDirection: 'column', justifyContent: 'space-between' }}>
            <Box style={{ width: 28, height: 28, borderRadius: 6, background: '#7C3AED', alignItems: 'center', justifyContent: 'center' }}>
                <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#FFFFFF' }}>3</Text>
            </Box>
            <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1E1B4B' }}>badcase 清单</Text>
            <Text style={{ fontSize: 16, color: '#64748B', lineHeight: 1.6 }}>逐条现象与归因，附用例编号</Text>
