    <Box style={{ flexDirection: 'row', gap: 16, marginTop: 32, height: 280 }}>
        <Box style={{ flex: 1, background: '#F5F3FF', borderRadius: 12, padding: 24, flexDirection: 'column', justifyContent: 'space-between' }}>
            <Box style={{ width: 28, height: 28, borderRadius: 6, background: '#7C3AED', alignItems: 'center', justifyContent: 'center' }}>
                <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#FFFFFF' }}>1</Text>
            </Box>
            <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1E1B4B' }}>任务信息</Text>
            <Text style={{ fontSize: 16, color: '#64748B', lineHeight: 1.6 }}>场景、模型版本、评测集版本号</Text>
        </Box>
        <Box style={{ flex: 1, background: '#EFF6FF', borderRadius: 12, padding: 24, flexDirection: 'column', justifyContent: 'space-between' }}>
            <Box style={{ width: 28, height: 28, borderRadius: 6, background: '#2563EB', alignItems: 'center', justifyContent: 'center' }}>
                <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#FFFFFF' }}>2</Text>
            </Box>
            <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1E1B4B' }}>各维度均分</Text>
