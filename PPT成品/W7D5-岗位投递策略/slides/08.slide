  <Box style={{ width: '100%', height: 1, background: '#E5E7EB', marginTop: 16 }} />
  <Box style={{ gap: 18, marginTop: 26, height: 356 }}>
    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 20, height: 106, background: '#F5F3FF', borderRadius: 12, padding: '0 30px' }}>
      <Box style={{ width: 28, height: 28, background: '#7C3AED', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>1</Text>
      </Box>
      <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E1B4B', width: 240 }}>称呼具体</Text>
      <Text style={{ fontSize: 18, color: '#1E1B4B', flex: 1 }}>带上对方的名字 / 岗位 / 公司，第一句就说明这不是群发</Text>
    </Box>
    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 20, height: 106, background: '#EFF6FF', borderRadius: 12, padding: '0 30px' }}>
      <Box style={{ width: 28, height: 28, background: '#2563EB', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>2</Text>
      </Box>
      <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E1B4B', width: 240 }}>一句价值主张</Text>
      <Text style={{ fontSize: 18, color: '#1E1B4B', flex: 1 }}>一句话说清你有什么、与这个岗位匹配在哪</Text>
    </Box>
    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 20, height: 106, background: '#F5F3FF', borderRadius: 12, padding: '0 30px' }}>
      <Box style={{ width: 28, height: 28, background: '#7C3AED', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>3</Text>
      </Box>
      <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E1B4B', width: 240 }}>一个钩子</Text>
      <Text style={{ fontSize: 18, color: '#1E1B4B', flex: 1 }}>给对方一个容易接的话头，让回复有抓手</Text>
