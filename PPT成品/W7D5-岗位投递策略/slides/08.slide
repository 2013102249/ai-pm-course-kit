  </Box>
  <Box style={{ marginTop: 24, height: 150, background: '#FFFFFF', border: '1.5px solid #7C3AED', borderRadius: 12, padding: '20px 30px' }}>
    <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#7C3AED' }}>三条检验标准：发出去之前自查</Text>
