      <Box style={{ marginTop: 16, background: '#FFFFFF', border: '1px solid #E5E7EB', borderRadius: 8, padding: 18, flex: 1 }}>
        <Text style={{ fontSize: 17, color: '#1E1B4B', lineHeight: 1.7 }}>「王老师您好，看到贵司在招 AI 产品经理（对话机器人方向）。我最近用 RAG 给客服知识库做过一版检索问答原型，关键链路踩过的坑都能展开聊。想请教您：这个岗位目前更看重冷启动数据，还是检索效果？」</Text>
      </Box>
    </Box>
    <Box style={{ flex: 1, gap: 14 }}>
      <Box style={{ flex: 1, background: '#FFFFFF', border: '1.5px solid #7C3AED', borderRadius: 10, padding: '14px 20px', justifyContent: 'center' }}>
