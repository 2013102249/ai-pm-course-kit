      </Box>
      <Box style={{ flex: 1, background: '#FFFFFF', border: '1.5px solid #7C3AED', borderRadius: 10, padding: '14px 20px', justifyContent: 'center' }}>
        <Text style={{ fontSize: 17, color: '#1E1B4B', lineHeight: 1.5 }}><span style={{ fontWeight: 'bold', color: '#7C3AED' }}>价值主张</span>：用作品说话——RAG 客服问答原型</Text>
      </Box>
      <Box style={{ flex: 1, background: '#FFFFFF', border: '1.5px solid #7C3AED', borderRadius: 10, padding: '14px 20px', justifyContent: 'center' }}>
