<Slide style={{ width: 1280, height: 720, padding: 60, background: '#FFFFFF', fontFamily: 'Microsoft YaHei' }}>
  <Box style={{ alignItems: 'center', marginTop: 6 }}>
    <Text style={{ fontSize: 40, fontWeight: 'bold', color: '#1E1B4B' }}>总结与作业</Text>
    <Box style={{ width: 64, height: 4, background: '#7C3AED', borderRadius: 2, marginTop: 18 }} />
  </Box>
  <Box style={{ flexDirection: 'row', gap: 28, marginTop: 36, height: 400 }}>
    <Box style={{ flex: 1, background: '#F5F3FF', borderRadius: 14, padding: 30 }}>
      <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#7C3AED' }}>三句话收束</Text>
      <Box style={{ marginTop: 22, gap: 20 }}>
        <Text style={{ fontSize: 19, color: '#1E1B4B', lineHeight: 1.55 }}><span style={{ fontWeight: 'bold' }}>渠道口诀：</span>内推 ＞ 猎头 ＞ 精准直投 ＞ 海投；脉脉做情报</Text>
        <Text style={{ fontSize: 19, color: '#1E1B4B', lineHeight: 1.55 }}><span style={{ fontWeight: 'bold' }}>三件套：</span>称呼具体 ＋ 价值主张 ＋ 钩子</Text>
        <Text style={{ fontSize: 19, color: '#1E1B4B', lineHeight: 1.55 }}><span style={{ fontWeight: 'bold' }}>漏斗周报：</span>五层数字，每周五自报，只跟自己比</Text>
      </Box>
    </Box>
    <Box style={{ flex: 1, background: '#4C1D95', borderRadius: 14, padding: 30 }}>
      <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#FFFFFF' }}>本周作业</Text>
      <Box style={{ marginTop: 22, gap: 20 }}>
        <Text style={{ fontSize: 19, color: '#FFFFFF', lineHeight: 1.55 }}>· 补足 <span style={{ fontWeight: 'bold' }}>≥50 家</span> 岗位清单</Text>
        <Text style={{ fontSize: 19, color: '#FFFFFF', lineHeight: 1.55 }}>· 首批 <span style={{ fontWeight: 'bold' }}>10 家</span> 本周内落地投递</Text>
        <Text style={{ fontSize: 19, color: '#FFFFFF', lineHeight: 1.55 }}>· <span style={{ fontWeight: 'bold' }}>周五周报</span>：自报五层数字</Text>
      </Box>
      <Box style={{ marginTop: 28, background: 'rgba(255,255,255,0.14)', borderRadius: 10, padding: '12px 18px' }}>
        <Text style={{ fontSize: 16, color: 'rgba(255,255,255,0.9)' }}>面试机会，从今天第一批投递开始</Text>
