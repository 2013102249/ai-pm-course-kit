<Slide style={{ width: 1280, height: 720, padding: 60, background: '#FFFFFF', fontFamily: "'Microsoft YaHei', sans-serif", position: 'relative' }}>
    <Box style={{ position: 'absolute', top: 24, left: 60, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
        <Box style={{ width: 8, height: 24, borderRadius: 2, background: '#7C3AED' }} />
        <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W3D4</Text>
    </Box>
    <Text style={{ position: 'absolute', bottom: 28, right: 60, fontSize: 14, color: '#64748B' }}>12 / 16</Text>

    <Box style={{ position: 'relative', zIndex: 1, height: '100%' }}>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B' }}>为什么单价低还会失控</Text>
        <Box style={{ height: 1, background: '#E5E7EB', marginTop: 18 }} />

        <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#7C3AED', marginTop: 24 }}>四个失控来源</Text>
        <Box style={{ flexDirection: 'row', gap: 14, marginTop: 12 }}>
            <Box style={{ flex: 1, background: '#F5F3FF', borderRadius: 10, padding: '18px 20px', alignItems: 'center' }}>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1E1B4B' }}>量大</Text>
            </Box>
            <Box style={{ flex: 1, background: '#F5F3FF', borderRadius: 10, padding: '18px 20px', alignItems: 'center' }}>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1E1B4B' }}>重试</Text>
            </Box>
            <Box style={{ flex: 1, background: '#F5F3FF', borderRadius: 10, padding: '18px 20px', alignItems: 'center' }}>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1E1B4B' }}>免费额度被薅</Text>
            </Box>
            <Box style={{ flex: 1, background: '#F5F3FF', borderRadius: 10, padding: '18px 20px', alignItems: 'center' }}>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1E1B4B' }}>缺护栏</Text>
            </Box>
        </Box>

        <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#2563EB', marginTop: 28 }}>隐性成本四项</Text>
        <Box style={{ flexDirection: 'row', gap: 14, marginTop: 12 }}>
            <Box style={{ flex: 1, background: '#EFF6FF', borderRadius: 10, padding: '24px 20px', alignItems: 'center' }}>
                <Box style={{ width: 28, height: 28, borderRadius: 6, background: '#2563EB', alignItems: 'center', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>1</Text>
                </Box>
                <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#2563EB', marginTop: 12 }}>审核</Text>
            </Box>
            <Box style={{ flex: 1, background: '#EFF6FF', borderRadius: 10, padding: '24px 20px', alignItems: 'center' }}>
                <Box style={{ width: 28, height: 28, borderRadius: 6, background: '#2563EB', alignItems: 'center', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>2</Text>
                </Box>
                <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#2563EB', marginTop: 12 }}>存储</Text>
            </Box>
            <Box style={{ flex: 1, background: '#EFF6FF', borderRadius: 10, padding: '24px 20px', alignItems: 'center' }}>
                <Box style={{ width: 28, height: 28, borderRadius: 6, background: '#2563EB', alignItems: 'center', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>3</Text>
                </Box>
                <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#2563EB', marginTop: 12 }}>并发</Text>
            </Box>
            <Box style={{ flex: 1, background: '#EFF6FF', borderRadius: 10, padding: '24px 20px', alignItems: 'center' }}>
                <Box style={{ width: 28, height: 28, borderRadius: 6, background: '#2563EB', alignItems: 'center', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>4</Text>
                </Box>
                <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#2563EB', marginTop: 12 }}>风控</Text>
            </Box>
        </Box>

        <Box style={{ background: '#F5F3FF', borderRadius: 10, padding: '18px 28px', marginTop: 28 }}>
            <Text style={{ fontSize: 20, color: '#1E1B4B', fontWeight: 'bold' }}>单价低 ≠ 总成本低：量 × 重试 × 隐性成本，叠起来才是真实账单</Text>
        </Box>
