    <Box style={{ position: 'relative', zIndex: 1, height: '100%' }}>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B' }}>导入案例：一次版权翻车事故</Text>
        <Box style={{ height: 1, background: '#E5E7EB', marginTop: 18 }} />

        <Box style={{ flexDirection: 'row', alignItems: 'stretch', gap: 16, marginTop: 60 }}>
            <Box style={{ flex: 1, background: '#F5F3FF', borderRadius: 12, padding: 32, height: 260 }}>
