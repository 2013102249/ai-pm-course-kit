                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>1</Text>
                </Box>
                <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E1B4B', marginTop: 24 }}>生成图被商用</Text>
                <Text style={{ fontSize: 18, color: '#64748B', marginTop: 12, lineHeight: 1.6 }}>某产品把 AI 生成的图片直接用于商业场景</Text>
            </Box>
            <Box style={{ justifyContent: 'center' }}>
                <Text style={{ fontSize: 28, color: '#7C3AED', fontWeight: 'bold' }}>→</Text>
            </Box>
            <Box style={{ flex: 1, background: '#F5F3FF', borderRadius: 12, padding: 32, height: 260 }}>
                <Box style={{ width: 28, height: 28, borderRadius: 6, background: '#7C3AED', alignItems: 'center', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>2</Text>
                </Box>
                <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E1B4B', marginTop: 24 }}>与插画师风格高度相似</Text>
                <Text style={{ fontSize: 18, color: '#64748B', marginTop: 12, lineHeight: 1.6 }}>被指出输出结果与某插画师作品风格雷同</Text>
            </Box>
            <Box style={{ justifyContent: 'center' }}>
                <Text style={{ fontSize: 28, color: '#7C3AED', fontWeight: 'bold' }}>→</Text>
            </Box>
            <Box style={{ flex: 1, background: '#F5F3FF', borderRadius: 12, padding: 32, height: 260 }}>
                <Box style={{ width: 28, height: 28, borderRadius: 6, background: '#7C3AED', alignItems: 'center', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>3</Text>
