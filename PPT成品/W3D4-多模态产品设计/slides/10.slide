<Slide style={{ width: 1280, height: 720, padding: 60, background: '#FFFFFF', fontFamily: "'Microsoft YaHei', sans-serif", position: 'relative' }}>
    <Box style={{ position: 'absolute', top: 24, left: 60, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
        <Box style={{ width: 8, height: 24, borderRadius: 2, background: '#7C3AED' }} />
        <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W3D4</Text>
    </Box>
    <Text style={{ position: 'absolute', bottom: 28, right: 60, fontSize: 14, color: '#64748B' }}>10 / 16</Text>

    <Box style={{ position: 'relative', zIndex: 1, height: '100%' }}>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B' }}>交互设计三要点</Text>
        <Box style={{ height: 1, background: '#E5E7EB', marginTop: 18 }} />

        <Box style={{ flexDirection: 'row', gap: 24, marginTop: 28, alignItems: 'center' }}>
            <Box style={{ width: 656, flexDirection: 'column', gap: 16 }}>
                <Box style={{ background: '#F5F3FF', borderRadius: 12, padding: '20px 28px' }}>
                    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14 }}>
                        <Box style={{ width: 28, height: 28, borderRadius: 6, background: '#7C3AED', alignItems: 'center', justifyContent: 'center' }}>
                            <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>1</Text>
                        </Box>
                        <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#7C3AED' }}>会等待</Text>
                    </Box>
                    <Text style={{ fontSize: 18, color: '#1E1B4B', marginTop: 10, lineHeight: 1.5 }}>进度提示 / 低保真预览 / 可取消 / 兜底方案</Text>
                </Box>
                <Box style={{ background: '#F5F3FF', borderRadius: 12, padding: '20px 28px' }}>
                    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14 }}>
                        <Box style={{ width: 28, height: 28, borderRadius: 6, background: '#7C3AED', alignItems: 'center', justifyContent: 'center' }}>
                            <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>2</Text>
                        </Box>
                        <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#7C3AED' }}>可微调</Text>
                    </Box>
                    <Text style={{ fontSize: 18, color: '#1E1B4B', marginTop: 10, lineHeight: 1.5 }}>描述 → 预览 → 微调 → 确认，让用户逐步逼近想要的结果</Text>
                </Box>
                <Box style={{ background: '#EFF6FF', borderRadius: 12, padding: '20px 28px' }}>
                    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14 }}>
                        <Box style={{ width: 28, height: 28, borderRadius: 6, background: '#2563EB', alignItems: 'center', justifyContent: 'center' }}>
                            <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>3</Text>
                        </Box>
                        <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#2563EB' }}>选对模态</Text>
                    </Box>
                    <Text style={{ fontSize: 18, color: '#1E1B4B', marginTop: 10, lineHeight: 1.5 }}>自然交互 + 降级路径，模态用不对就别硬上</Text>
                </Box>
            </Box>
            <Image src="assets/traditional-vs-ai.svg" style={{ width: 480, height: 293, borderRadius: 12, border: '1px solid #E5E7EB' }} />
        </Box>
    </Box>
</Slide>
