            <Box style={{ flex: 1, border: '1px solid #E5E7EB', borderRadius: 12, padding: 28 }}>
                <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#7C3AED' }}>平台</Text>
                <Box style={{ height: 2, background: '#F5F3FF', marginTop: 14 }} />
                <Text style={{ fontSize: 18, color: '#1E1B4B', marginTop: 16, lineHeight: 1.7 }}>提供了生成工具与分发入口，该承担什么？</Text>
