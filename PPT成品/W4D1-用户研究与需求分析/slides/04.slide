      <Box style={{ justifyContent: 'center' }}>
        <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#7C3AED' }}>→</Text>
      </Box>
      <Box style={{ width: 340, background: '#EFF6FF', borderRadius: 12, padding: 24, flexDirection: 'column', gap: 12, justifyContent: 'center' }}>
        <Text style={{ fontSize: 14, color: '#64748B' }}>真痛点</Text>
        <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E1B4B' }}>「买了的菜怎么消耗」</Text>
