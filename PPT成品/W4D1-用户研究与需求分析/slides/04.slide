        <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#7C3AED' }}>→</Text>
      </Box>
      <Box style={{ width: 200, background: '#F5F3FF', borderRadius: 12, padding: 24, flexDirection: 'column', gap: 12, justifyContent: 'center' }}>
        <Text style={{ fontSize: 14, color: '#64748B' }}>调研</Text>
        <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E1B4B' }}>访谈 <span style={{ color: '#7C3AED' }}>5</span> 人</Text>
