<Slide style={{ width: 1280, height: 720, padding: 60, background: '#FFFFFF' }}>
  <Box style={{ position: 'absolute', top: 24, left: 60, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
    <Box style={{ width: 8, height: 24, background: '#7C3AED', borderRadius: 4 }} />
    <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W5D5</Text>
  </Box>
  <Box style={{ position: 'absolute', bottom: 26, right: 60 }}>
    <Text style={{ fontSize: 14, color: '#64748B' }}>03 / 10</Text>
  </Box>
  <Box style={{ height: '100%', flexDirection: 'column', gap: 16 }}>
    <Text style={{ fontSize: 34, color: '#1E1B4B', fontWeight: 'bold' }}>评审规则与评分卡</Text>
    <Box style={{ width: '100%', height: 1, background: '#E5E7EB' }} />
    <Box style={{ flex: 1, flexDirection: 'row', gap: 28, marginTop: 8 }}>
      <Box style={{ width: 620, background: '#FFFFFF', border: '1px solid #E5E7EB', borderRadius: 12, padding: 10, alignItems: 'center', justifyContent: 'center' }}>
        <Image src="assets/midterm-scorecard.svg" style={{ width: 600, height: 375, objectFit: 'contain' }} />
      </Box>
      <Box style={{ flex: 1, flexDirection: 'column', gap: 10 }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', background: '#F5F3FF', borderRadius: 8, padding: '10px 18px' }}>
          <Text style={{ fontSize: 18, color: '#1E1B4B', fontWeight: 'bold' }}>问题真实度</Text>
          <Text style={{ fontSize: 16, color: '#64748B' }}>0–5 分</Text>
        </Box>
        <Box style={{ flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', background: '#EFF6FF', borderRadius: 8, padding: '10px 18px' }}>
          <Text style={{ fontSize: 18, color: '#1E1B4B', fontWeight: 'bold' }}>方案完整度</Text>
          <Text style={{ fontSize: 16, color: '#64748B' }}>0–5 分</Text>
        </Box>
        <Box style={{ flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', background: '#F5F3FF', borderRadius: 8, padding: '10px 18px' }}>
          <Text style={{ fontSize: 18, color: '#1E1B4B', fontWeight: 'bold' }}>数据支撑</Text>
          <Text style={{ fontSize: 16, color: '#64748B' }}>0–5 分</Text>
        </Box>
        <Box style={{ flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', background: '#EFF6FF', borderRadius: 8, padding: '10px 18px' }}>
          <Text style={{ fontSize: 18, color: '#1E1B4B', fontWeight: 'bold' }}>成本可信度</Text>
          <Text style={{ fontSize: 16, color: '#64748B' }}>0–5 分</Text>
        </Box>
        <Box style={{ flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', background: '#F5F3FF', borderRadius: 8, padding: '10px 18px' }}>
          <Text style={{ fontSize: 18, color: '#1E1B4B', fontWeight: 'bold' }}>风险预判</Text>
          <Text style={{ fontSize: 16, color: '#64748B' }}>0–5 分</Text>
        </Box>
        <Box style={{ background: '#7C3AED', borderRadius: 10, padding: '14px 20px', marginTop: 6 }}>
          <Text style={{ fontSize: 18, color: '#FFFFFF', fontWeight: 'bold', lineHeight: 1.5 }}>及格线：每维 ≥3 且总分 ≥18/25</Text>
        </Box>
        <Box style={{ background: '#7C3AED', borderRadius: 10, padding: '14px 20px' }}>
          <Text style={{ fontSize: 18, color: '#FFFFFF', fontWeight: 'bold', lineHeight: 1.5 }}>任一维 <span style={{ fontSize: 22 }}>&lt;3</span> 视为未过，不是只看总分</Text>
        </Box>
      </Box>
    </Box>
  </Box>
</Slide>
