  <Box style={{ height: '100%', flexDirection: 'column', gap: 14 }}>
    <Text style={{ fontSize: 34, color: '#1E1B4B', fontWeight: 'bold' }}>V3 Scope 决策规则</Text>
    <Box style={{ width: '100%', height: 1, background: '#E5E7EB' }} />
    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12, background: '#EFF6FF', border: '1px solid #BFDBFE', borderRadius: 10, padding: '12px 22px', marginTop: 4 }}>
      <Text style={{ fontSize: 19, color: '#1E1B4B' }}>判定依据 = <span style={{ fontWeight: 'bold', color: '#2563EB' }}>中期答辩数据</span> + <span style={{ fontWeight: 'bold', color: '#2563EB' }}>两周工时上限（约 80h）</span></Text>
