        <Text style={{ fontSize: 24, color: '#FFFFFF', fontWeight: 'bold', width: 130 }}>保留</Text>
        <Text style={{ fontSize: 18, color: 'rgba(255,255,255,0.85)' }}>数据过硬、工时放得下，直接进 V3 Scope</Text>
