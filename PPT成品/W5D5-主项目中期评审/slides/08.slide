<Slide style={{ width: 1280, height: 720, padding: 60, background: '#FFFFFF' }}>
  <Box style={{ position: 'absolute', top: 24, left: 60, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
    <Box style={{ width: 8, height: 24, background: '#7C3AED', borderRadius: 4 }} />
    <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W5D5</Text>
  </Box>
  <Box style={{ position: 'absolute', bottom: 26, right: 60 }}>
    <Text style={{ fontSize: 14, color: '#64748B' }}>08 / 10</Text>
  </Box>
  <Box style={{ height: '100%', flexDirection: 'column', gap: 14 }}>
    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16 }}>
      <Text style={{ fontSize: 34, color: '#1E1B4B', fontWeight: 'bold' }}>砍需求决策演示</Text>
      <Box style={{ background: '#EFF6FF', border: '1px solid #BFDBFE', borderRadius: 999, padding: '6px 16px' }}>
        <Text style={{ fontSize: 14, color: '#2563EB', fontWeight: 'bold' }}>教学示例</Text>
      </Box>
    </Box>
    <Box style={{ width: '100%', height: 1, background: '#E5E7EB' }} />
    <Text style={{ fontSize: 18, color: '#64748B', marginTop: 2 }}>「留学文书助手」三个功能怎么砍——每个决定至少两条依据（数据 / 竞争 / 工时）</Text>
    <Box style={{ flex: 1, flexDirection: 'row', gap: 20 }}>
      <Box style={{ flex: 1, flexDirection: 'column', background: '#F5F3FF', border: '1px solid #E9E4F8', borderRadius: 12, padding: 22, gap: 12 }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
          <Text style={{ fontSize: 22, color: '#1E1B4B', fontWeight: 'bold' }}>F1 改写</Text>
          <Box style={{ background: '#7C3AED', borderRadius: 6, padding: '4px 12px' }}>
            <Text style={{ fontSize: 15, color: '#FFFFFF', fontWeight: 'bold' }}>P0 保留</Text>
          </Box>
        </Box>
        <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 6 }}>
          <Text style={{ fontSize: 40, color: '#7C3AED', fontWeight: 'bold' }}>82%</Text>
          <Text style={{ fontSize: 16, color: '#64748B' }}>问卷</Text>
        </Box>
        <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 6 }}>
          <Text style={{ fontSize: 28, color: '#1E1B4B', fontWeight: 'bold' }}>12h</Text>
          <Text style={{ fontSize: 16, color: '#64748B' }}>两周工时</Text>
        </Box>
        <Text style={{ fontSize: 16, color: '#1E1B4B', lineHeight: 1.5 }}>数据硬、工时轻，完整保留</Text>
      </Box>
      <Box style={{ flex: 1, flexDirection: 'column', background: '#EFF6FF', border: '1px solid #BFDBFE', borderRadius: 12, padding: 22, gap: 12 }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
          <Text style={{ fontSize: 22, color: '#1E1B4B', fontWeight: 'bold' }}>F2 选校</Text>
          <Box style={{ background: '#2563EB', borderRadius: 6, padding: '4px 12px' }}>
            <Text style={{ fontSize: 15, color: '#FFFFFF', fontWeight: 'bold' }}>P1 有条件</Text>
          </Box>
        </Box>
        <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 8 }}>
          <Text style={{ fontSize: 28, color: '#64748B' }}>全量 28h 爆盘</Text>
          <Text style={{ fontSize: 22, color: '#2563EB' }}>→</Text>
          <Text style={{ fontSize: 40, color: '#2563EB', fontWeight: 'bold' }}>8h</Text>
          <Text style={{ fontSize: 16, color: '#64748B' }}>简化版</Text>
        </Box>
        <Box style={{ background: '#FFFFFF', borderRadius: 8, padding: '10px 14px' }}>
          <Text style={{ fontSize: 16, color: '#1E1B4B', fontWeight: 'bold' }}>检查点：W6D2 中午</Text>
          <Text style={{ fontSize: 15, color: '#64748B' }}>不过就降级，提前定好</Text>
        </Box>
      </Box>
      <Box style={{ flex: 1, flexDirection: 'column', background: '#F5F3FF', border: '1px solid #E9E4F8', borderRadius: 12, padding: 22, gap: 12 }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
          <Text style={{ fontSize: 22, color: '#1E1B4B', fontWeight: 'bold' }}>F3 简历</Text>
          <Box style={{ background: '#64748B', borderRadius: 6, padding: '4px 12px' }}>
            <Text style={{ fontSize: 15, color: '#FFFFFF', fontWeight: 'bold' }}>P2 砍进暂存池</Text>
          </Box>
        </Box>
        <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 6 }}>
          <Text style={{ fontSize: 40, color: '#64748B', fontWeight: 'bold' }}>9%</Text>
          <Text style={{ fontSize: 16, color: '#64748B' }}>问卷</Text>
        </Box>
        <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 6 }}>
          <Text style={{ fontSize: 28, color: '#1E1B4B', fontWeight: 'bold' }}>24h</Text>
          <Text style={{ fontSize: 16, color: '#64748B' }}>两周工时</Text>
        </Box>
        <Text style={{ fontSize: 16, color: '#1E1B4B', lineHeight: 1.5 }}>需求弱、竞品免费、工时重</Text>
      </Box>
    </Box>
    <Box style={{ flexDirection: 'row', alignItems: 'center', justifyContent: 'center', gap: 20, background: '#7C3AED', borderRadius: 12, padding: '14px 32' }}>
      <Text style={{ fontSize: 24, color: '#FFFFFF', fontWeight: 'bold' }}>三进二</Text>
      <Text style={{ fontSize: 18, color: 'rgba(255,255,255,0.9)' }}>F1 改写 + F2 选校进 V3 Scope，F3 简历进暂存池</Text>
    </Box>
  </Box>
</Slide>
