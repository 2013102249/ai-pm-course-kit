<Slide style={{ width: 1280, height: 720, padding: 60, background: '#FFFFFF' }}>
  <Box style={{ position: 'absolute', top: 24, left: 60, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
    <Box style={{ width: 8, height: 24, background: '#7C3AED', borderRadius: 4 }} />
    <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W5D5</Text>
  </Box>
  <Box style={{ position: 'absolute', bottom: 26, right: 60 }}>
    <Text style={{ fontSize: 14, color: '#64748B' }}>09 / 10</Text>
  </Box>
  <Box style={{ height: '100%', flexDirection: 'column', gap: 16 }}>
    <Text style={{ fontSize: 34, color: '#1E1B4B', fontWeight: 'bold' }}>Scope 清算任务卡</Text>
    <Box style={{ width: '100%', height: 1, background: '#E5E7EB' }} />
    <Box style={{ flex: 1, flexDirection: 'row', gap: 28, marginTop: 8 }}>
      <Box style={{ flex: 1, flexDirection: 'column', gap: 14 }}>
        <Box style={{ flex: 1, flexDirection: 'row', alignItems: 'center', gap: 22, background: '#F5F3FF', borderRadius: 12, padding: '0 26' }}>
          <Box style={{ width: 28, height: 28, background: '#7C3AED', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
            <Text style={{ fontSize: 16, color: '#FFFFFF', fontWeight: 'bold' }}>1</Text>
          </Box>
          <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 8 }}>
            <Text style={{ fontSize: 36, color: '#7C3AED', fontWeight: 'bold' }}>10</Text>
            <Text style={{ fontSize: 18, color: '#1E1B4B' }}>分钟</Text>
          </Box>
          <Box style={{ flexDirection: 'column', gap: 4 }}>
            <Text style={{ fontSize: 20, color: '#1E1B4B', fontWeight: 'bold' }}>各组填决策表</Text>
            <Text style={{ fontSize: 16, color: '#64748B' }}>功能 / 等级 / 判定依据 / 本周工时</Text>
          </Box>
        </Box>
        <Box style={{ flex: 1, flexDirection: 'row', alignItems: 'center', gap: 22, background: '#EFF6FF', borderRadius: 12, padding: '0 26' }}>
          <Box style={{ width: 28, height: 28, background: '#2563EB', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
            <Text style={{ fontSize: 16, color: '#FFFFFF', fontWeight: 'bold' }}>2</Text>
          </Box>
          <Box style={{ flexDirection: 'column', gap: 4 }}>
            <Text style={{ fontSize: 20, color: '#1E1B4B', fontWeight: 'bold' }}>砍掉项：书面理由必填</Text>
            <Text style={{ fontSize: 16, color: '#64748B' }}>对应哪条数据 / 竞争 / 工时依据</Text>
          </Box>
        </Box>
        <Box style={{ flex: 1, flexDirection: 'row', alignItems: 'center', gap: 22, background: '#F5F3FF', borderRadius: 12, padding: '0 26' }}>
          <Box style={{ width: 28, height: 28, background: '#7C3AED', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
            <Text style={{ fontSize: 16, color: '#FFFFFF', fontWeight: 'bold' }}>3</Text>
          </Box>
          <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 8 }}>
            <Text style={{ fontSize: 36, color: '#7C3AED', fontWeight: 'bold' }}>2×90</Text>
            <Text style={{ fontSize: 18, color: '#1E1B4B' }}>秒</Text>
          </Box>
          <Text style={{ fontSize: 20, color: '#1E1B4B', fontWeight: 'bold' }}>完成后 2 组各 90 秒过审</Text>
        </Box>
      </Box>
      <Box style={{ width: 420, background: '#F5F3FF', border: '1px solid #E9E4F8', borderRadius: 12, padding: 28, flexDirection: 'column', gap: 18 }}>
        <Text style={{ fontSize: 22, color: '#7C3AED', fontWeight: 'bold' }}>巡场三连问</Text>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14 }}>
          <Box style={{ width: 8, height: 8, background: '#7C3AED', borderRadius: 4 }} />
          <Text style={{ fontSize: 19, color: '#1E1B4B', fontWeight: 'bold' }}>工时上限摆了吗？</Text>
        </Box>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14 }}>
          <Box style={{ width: 8, height: 8, background: '#7C3AED', borderRadius: 4 }} />
          <Text style={{ fontSize: 19, color: '#1E1B4B', fontWeight: 'bold' }}>依据对应哪条数据？</Text>
        </Box>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14 }}>
          <Box style={{ width: 8, height: 8, background: '#7C3AED', borderRadius: 4 }} />
          <Text style={{ fontSize: 19, color: '#1E1B4B', fontWeight: 'bold' }}>P1 的检查点写了吗？</Text>
        </Box>
        <Box style={{ flex: 1 }} />
        <Text style={{ fontSize: 15, color: '#64748B', lineHeight: 1.6 }}>讲师巡场时按这三问逐组核对，答不上就当场补</Text>
      </Box>
    </Box>
  </Box>
</Slide>
