  <Box style={{ width: '100%', height: 1, background: '#E5E7EB', marginTop: 14, marginBottom: 22 }} />
  <Box style={{ flex: 1, flexDirection: 'row', gap: 28, alignItems: 'stretch' }}>
    <Box style={{ width: 480, flexDirection: 'column', gap: 14 }}>
      <Box style={{ background: '#F5F3FF', borderRadius: 12, padding: '16px 22px', flexDirection: 'row', gap: 14, alignItems: 'center' }}>
