        <Text style={{ fontSize: 18, color: '#1E1B4B', flex: 1 }}>「讲一次你最大的失败」</Text>
      </Box>
      <Box style={{ background: '#F5F3FF', borderRadius: 12, padding: '16px 22px', flexDirection: 'row', gap: 14, alignItems: 'center' }}>
        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#2563EB', width: 88 }}>考察本质</Text>
        <Text style={{ fontSize: 18, color: '#1E1B4B', flex: 1 }}>自省与稳定</Text>
      </Box>
      <Box style={{ background: '#F5F3FF', borderRadius: 12, padding: '16px 22px', flexDirection: 'row', gap: 14, alignItems: 'center' }}>
        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#2563EB', width: 88 }}>答题框架</Text>
        <Text style={{ fontSize: 18, color: '#1E1B4B', flex: 1 }}>STAR + 反思收尾</Text>
      </Box>
      <Box style={{ background: '#F5F3FF', borderRadius: 12, padding: '16px 22px', flexDirection: 'row', gap: 14, alignItems: 'center' }}>
        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#DC2626', width: 88 }}>高频失误</Text>
        <Text style={{ fontSize: 18, color: '#1E1B4B', flex: 1 }}>只讲事件没有反思</Text>
      </Box>
      <Box style={{ background: '#EFF6FF', borderRadius: 10, padding: '12px 20px', marginTop: 4 }}>
        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#2563EB' }}>项目真实度权重最高</Text>
      </Box>
    </Box>
    <Box style={{ flex: 1, flexDirection: 'column', justifyContent: 'center', gap: 12 }}>
