            { text: '5 分档表现', textStyle: { bold: true, color: '#FFFFFF' }, cellStyle: { background: { color: '#7C3AED' } } },
          ],
          [
            { text: '逻辑', textStyle: { bold: true } },
            { text: '说理有链条，结论有依据' },
          ],
          [
            { text: '项目真实', textStyle: { bold: true, color: '#7C3AED' }, cellStyle: { background: { color: '#F5F3FF' } } },
            { text: '细节经得起追问（权重最高）', textStyle: { bold: true, color: '#7C3AED' }, cellStyle: { background: { color: '#F5F3FF' } } },
