        style={{ width: '100%', height: 320 }}
        defaultTextStyle={{ fontSize: 16, color: '#1E1B4B', textAlign: 'left' }}
        defaultCellStyle={{
          border: {
            left: { width: 1, color: '#E5E7EB' },
            right: { width: 1, color: '#E5E7EB' },
            top: { width: 1, color: '#E5E7EB' },
            bottom: { width: 1, color: '#E5E7EB' },
          },
          padding: '8px 16px',
        }}
        cells={[
          [
