<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: 60 }}>
  <Box style={{ position: 'absolute', top: 24, left: 60, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
    <Box style={{ width: 8, height: 24, background: '#7C3AED', borderRadius: 4 }} />
    <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W8D1</Text>
  </Box>
  <Text style={{ position: 'absolute', right: 60, bottom: 28, fontSize: 14, color: '#64748B' }}>16 / 18</Text>
  <Box style={{ flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B', lineHeight: 1.2 }}>五维自评（课堂练习）</Text>
    <Box style={{ background: '#7C3AED', borderRadius: 20, padding: '8px 22px' }}>
      <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FFFFFF' }}>自评 3 分钟</Text>
    </Box>
  </Box>
  <Box style={{ width: '100%', height: 1, background: '#E5E7EB', marginTop: 14, marginBottom: 18 }} />
  <Text style={{ fontSize: 18, color: '#64748B' }}>每人按 1–5 分自评，圈出自己最低的维度</Text>
  <Box style={{ flex: 1, flexDirection: 'column', gap: 12, marginTop: 16, justifyContent: 'center' }}>
    {[
      { name: '逻辑' },
      { name: '项目真实' },
      { name: '技术' },
      { name: '数据' },
      { name: '表达' },
    ].map((item, idx) => (
      <Box key={idx} style={{ flexDirection: 'row', alignItems: 'center', gap: 24, background: idx % 2 === 0 ? '#F5F3FF' : '#EFF6FF', borderRadius: 10, padding: '12px 24px' }}>
        <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1E1B4B', width: 120 }}>{item.name}</Text>
        <Box style={{ flexDirection: 'row', gap: 14 }}>
          {[1, 2, 3, 4, 5].map((n) => (
            <Box key={n} style={{ width: 36, height: 36, background: '#FFFFFF', border: '1px solid #C9C2DE', borderRadius: 8, justifyContent: 'center', alignItems: 'center' }}>
              <Text style={{ fontSize: 15, color: '#64748B' }}>{n}</Text>
            </Box>
          ))}
        </Box>
      </Box>
    ))}
  </Box>
  <Text style={{ fontSize: 14, color: '#64748B', marginTop: 14 }}>示例框架，各公司自定</Text>
</Slide>
