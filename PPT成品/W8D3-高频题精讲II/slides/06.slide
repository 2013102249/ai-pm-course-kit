<Slide style={{ width: 1280, height: 720, padding: 60, background: 'linear-gradient(135deg, #4C1D95 0%, #7C3AED 100%)', fontFamily: "'Microsoft YaHei', 'PingFang SC', sans-serif", position: 'relative' }}>
  <Box style={{ flex: 1, justifyContent: 'center', alignItems: 'center', gap: 30 }}>
    <Text style={{ fontSize: 16, color: 'rgba(255,255,255,0.7)', letterSpacing: 6 }}>时间纪律：30 秒与 90 秒</Text>
    <Text style={{ fontSize: 52, fontWeight: 'bold', color: '#FFFFFF', textAlign: 'center' }}>把展开的主动权交给面试官</Text>
    <Box style={{ flexDirection: 'row', gap: 24, marginTop: 6 }}>
      <Box style={{ background: 'rgba(255,255,255,0.12)', border: '1px solid rgba(255,255,255,0.35)', borderRadius: 12, padding: '18px 32px' }}>
        <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#FFFFFF' }}>30 秒 = 结论 + 类比</Text>
      </Box>
      <Box style={{ background: 'rgba(255,255,255,0.12)', border: '1px solid rgba(255,255,255,0.35)', borderRadius: 12, padding: '18px 32px' }}>
        <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#FFFFFF' }}>90 秒 = 结论 + 展开 + 取舍</Text>
      </Box>
    </Box>
    <Text style={{ fontSize: 20, color: 'rgba(255,255,255,0.85)' }}>追问什么，展开什么</Text>
  </Box>
</Slide>
