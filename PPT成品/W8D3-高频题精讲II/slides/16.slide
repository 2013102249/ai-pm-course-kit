<Slide style={{ width: 1280, height: 720, padding: 60, background: '#FFFFFF', fontFamily: "'Microsoft YaHei', 'PingFang SC', sans-serif", position: 'relative' }}>
  <Box style={{ position: 'absolute', top: 24, left: 60, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
    <Box style={{ width: 8, height: 24, background: '#7C3AED', borderRadius: 4 }} />
    <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W8D3</Text>
  </Box>
  <Box style={{ position: 'absolute', bottom: 24, right: 60 }}>
    <Text style={{ fontSize: 14, color: '#64748B' }}>16 / 20</Text>
  </Box>
  <Box>
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B' }}>小说版 vs 结论先行版</Text>
    <Box style={{ width: '100%', height: 1, background: '#E5E7EB', marginTop: 16 }} />
  </Box>
  <Box style={{ flex: 1, flexDirection: 'row', gap: 28, marginTop: 22, alignItems: 'stretch' }}>
    <Box style={{ flex: 1, background: '#F8FAFC', border: '1px solid #E5E7EB', borderRadius: 12, padding: '28px 32px', gap: 14 }}>
      <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#64748B', letterSpacing: 2 }}>小说版</Text>
      <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E1B4B' }}>凌晨两点的 PRD 故事</Text>
      <Box style={{ gap: 10, marginTop: 4 }}>
        <Text style={{ fontSize: 18, color: '#64748B', lineHeight: 1.7 }}>「凌晨两点，我还在改第 7 版 PRD……」</Text>
        <Text style={{ fontSize: 18, color: '#64748B', lineHeight: 1.7 }}>铺垫情绪、渲染过程，讲了三分钟</Text>
        <Text style={{ fontSize: 18, color: '#64748B', lineHeight: 1.7 }}>结论藏在最后一句，面试官早已走神</Text>
      </Box>
    </Box>
    <Box style={{ flex: 1, background: '#F5F3FF', borderRadius: 12, padding: '28px 32px', gap: 14 }}>
      <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#7C3AED', letterSpacing: 2 }}>结论先行版</Text>
      <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E1B4B' }}>先 R 后 A，30 秒全是干货</Text>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14, marginTop: 4 }}>
        <Box style={{ background: '#7C3AED', borderRadius: 10, padding: '12px 26px' }}>
          <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#FFFFFF' }}>R 结果</Text>
        </Box>
        <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#7C3AED' }}>→</Text>
        <Box style={{ background: '#2563EB', borderRadius: 10, padding: '12px 26px' }}>
          <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#FFFFFF' }}>A 行动</Text>
        </Box>
      </Box>
      <Text style={{ fontSize: 18, color: '#64748B', lineHeight: 1.7 }}>先给结果，再讲动作，30 秒说完</Text>
    </Box>
