<Slide style={{ width: 1280, height: 720, padding: 60, background: '#FFFFFF', fontFamily: "'Microsoft YaHei', 'PingFang SC', sans-serif", position: 'relative' }}>
  <Box style={{ position: 'absolute', top: 24, left: 60, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
    <Box style={{ width: 8, height: 24, background: '#7C3AED', borderRadius: 4 }} />
    <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W8D3</Text>
  </Box>
  <Box style={{ position: 'absolute', bottom: 24, right: 60 }}>
    <Text style={{ fontSize: 14, color: '#64748B' }}>04 / 20</Text>
  </Box>
  <Box>
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B' }}>五大题型应答地图</Text>
    <Box style={{ width: '100%', height: 1, background: '#E5E7EB', marginTop: 16 }} />
  </Box>
  <Box style={{ flex: 1, flexDirection: 'row', alignItems: 'center', gap: 36, marginTop: 20 }}>
    <Box style={{ width: 280, gap: 22 }}>
      {['技术', '数据', '行为'].map((t, i) => (
        <Box key={i} style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
          <Box style={{ width: 14, height: 14, background: '#7C3AED', borderRadius: 7 }} />
          <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#1E1B4B' }}>{t}</Text>
          {i === 0 && <Text style={{ fontSize: 14, color: '#7C3AED', fontWeight: 'bold' }}>今天攻前三行</Text>}
        </Box>
      ))}
      {['反问', '压力'].map((t, i) => (
        <Box key={i} style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
          <Box style={{ width: 14, height: 14, background: '#CBD5E1', borderRadius: 7 }} />
          <Text style={{ fontSize: 24, color: '#64748B' }}>{t}</Text>
        </Box>
      ))}
      <Box style={{ background: '#F5F3FF', borderRadius: 10, padding: '14px 18px', marginTop: 8 }}>
        <Text style={{ fontSize: 16, color: '#7C3AED', fontWeight: 'bold', lineHeight: 1.5 }}>今天攻前三行：技术、数据、行为</Text>
      </Box>
    </Box>
    <Image src="assets/strategy-table.svg" style={{ flex: 1, height: 480, objectFit: 'contain' }} />
  </Box>
</Slide>
