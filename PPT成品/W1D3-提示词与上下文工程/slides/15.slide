<Slide style={{ width: 1280, height: 720, padding: 60, background: '#FFFFFF', fontFamily: 'Microsoft YaHei', position: 'relative' }}>
  <Box style={{ position: 'absolute', top: 24, left: 60, flexDirection: 'row', alignItems: 'center', gap: 8 }}>
    <Box style={{ width: 8, height: 24, background: '#7C3AED', borderRadius: 4 }} />
    <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W1D3</Text>
  </Box>
  <Text style={{ position: 'absolute', bottom: 24, right: 60, fontSize: 14, color: '#64748B' }}>15 / 18</Text>

  <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B' }}>组件详解：注入与工具</Text>
  <Box style={{ width: '100%', height: 1, background: '#E5E7EB', marginTop: 14, marginBottom: 24 }} />

  <Box style={{ flexDirection: 'row', gap: 32, width: '100%', flex: 1 }}>
    <Box style={{ flexDirection: 'column', gap: 18, width: 560, justifyContent: 'center' }}>
      <Box style={{ background: '#F5F3FF', borderRadius: 12, padding: '24px 28px' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
          <Box style={{ width: 28, height: 28, background: '#7C3AED', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
            <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>1</Text>
          </Box>
          <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#7C3AED' }}>资料注入 · 治「不知道」</Text>
        </Box>
        <Text style={{ fontSize: 18, color: '#1E1B4B', marginTop: 10, lineHeight: 1.6 }}>把政策、规范、产品资料放进上下文，模型回答才有依据</Text>
      </Box>
      <Box style={{ background: '#EFF6FF', borderRadius: 12, padding: '24px 28px' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
          <Box style={{ width: 28, height: 28, background: '#2563EB', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
            <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>2</Text>
          </Box>
          <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#2563EB' }}>工具描述 · 治「不会用」</Text>
        </Box>
        <Text style={{ fontSize: 18, color: '#1E1B4B', marginTop: 10, lineHeight: 1.6 }}>把工具的用途和参数写清楚，模型才知道什么时候调、怎么调</Text>
      </Box>
    </Box>
    <Box style={{ flexDirection: 'column', gap: 16, flex: 1, justifyContent: 'center' }}>
      <Image src="assets/context_four_components.svg" style={{ width: 540, height: 315, borderRadius: 12, border: '1px solid #E5E7EB' }} />
      <Box style={{ background: '#F5F3FF', borderRadius: 10, padding: '14px 22px' }}>
        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#7C3AED' }}>工具误调案例：描述重写之后</Text>
        <Text style={{ fontSize: 22, fontWeight: 'bold', marginTop: 6 }}>
          <span style={{ color: '#DC2626' }}>误调率 30%</span>
          <span style={{ color: '#64748B' }}> → </span>
          <span style={{ color: '#16A34A' }}>10%</span>
        </Text>
      </Box>
    </Box>
  </Box>
</Slide>
