<Slide style={{ width: 1280, height: 720, padding: 60, background: '#FFFFFF', position: 'relative' }}>
  <Box style={{ position: 'absolute', top: 24, left: 60, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
    <Box style={{ width: 8, height: 24, background: '#7C3AED', borderRadius: 4 }} />
    <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W3D5</Text>
  </Box>
  <Text style={{ position: 'absolute', bottom: 24, right: 60, fontSize: 14, color: '#64748B' }}>04 / 10</Text>

  <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B' }}>评审规则</Text>
  <Box style={{ width: '100%', height: 1, background: '#E5E7EB', marginTop: 14, marginBottom: 24 }} />

  <Box style={{ flexDirection: 'row', gap: 32, height: 420 }}>
    <Box style={{ width: 620, flexDirection: 'column', justifyContent: 'space-between' }}>
      <Box style={{ background: '#F5F3FF', borderRadius: 14, padding: 24, gap: 10 }}>
        <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1E1B4B' }}>每组 10 分钟，硬切不停表</Text>
        <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#1E1B4B', lineHeight: 1.5 }}>
          <span style={{ color: '#2563EB' }}>5 组</span> × <span style={{ color: '#2563EB' }}>10 分钟</span> ={'\n'}
          演示 <span style={{ color: '#2563EB' }}>3</span> + 质询 <span style={{ color: '#2563EB' }}>4</span> + 点评 <span style={{ color: '#2563EB' }}>3</span>
        </Text>
      </Box>
      <Box style={{ background: '#EFF6FF', borderRadius: 14, padding: '20px 24px', flexDirection: 'row', alignItems: 'center', gap: 14 }}>
        <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E1B4B' }}>每人 <span style={{ color: '#2563EB' }}>4 份</span>记录表</Text>
      </Box>
      <Box style={{ background: '#EFF6FF', borderRadius: 14, padding: '20px 24px', flexDirection: 'row', alignItems: 'center', gap: 14 }}>
        <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E1B4B' }}>对每组：<span style={{ color: '#2563EB' }}>1 条</span>追问 + <span style={{ color: '#2563EB' }}>1 条</span>建议，必填</Text>
      </Box>
      <Box style={{ background: '#7C3AED', borderRadius: 14, padding: 22, alignItems: 'center' }}>
        <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#FFFFFF' }}>全员满分 = 评审失败</Text>
      </Box>
    </Box>
    <Box style={{ flex: 1, flexDirection: 'column', alignItems: 'center', justifyContent: 'center', gap: 14 }}>
      <Box style={{ background: '#FFFFFF', border: '1.5px solid #E5E7EB', borderRadius: 14, padding: 16 }}>
        <Image src="assets/review-scorecard.svg" style={{ width: 420, height: 312, objectFit: 'contain' }} />
      </Box>
      <Text style={{ fontSize: 15, color: '#64748B' }}>评审三维评分卡（现场投屏讲解版式）</Text>
    </Box>
  </Box>
</Slide>
