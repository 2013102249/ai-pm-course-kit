          <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#64748B' }}>≤2 分</Text>
        </Box>
        <Text style={{ fontSize: 18, color: '#1E1B4B', lineHeight: 1.5 }}>无引导无兜底，演示依赖提前写死的输入</Text>
      </Box>
      <Box style={{ height: 104, background: '#FFFFFF', border: '1.5px solid #E5E7EB', borderRadius: 14, padding: 20, flexDirection: 'row', alignItems: 'center', gap: 18 }}>
