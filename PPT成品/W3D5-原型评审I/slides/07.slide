  <Box style={{ width: '100%', height: 1, background: '#E5E7EB', marginTop: 14, marginBottom: 24 }} />

  <Box style={{ flexDirection: 'row', gap: 32, height: 470 }}>
    <Box style={{ flex: 1, flexDirection: 'column', justifyContent: 'space-between' }}>
      <Box style={{ height: 120, background: '#F5F3FF', borderRadius: 14, padding: 20, gap: 10 }}>
