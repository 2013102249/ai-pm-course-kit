    <Box style={{ width: 570, height: 180, background: '#EFF6FF', borderRadius: 14, padding: 26, justifyContent: 'center', gap: 12 }}>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14 }}>
        <Box style={{ width: 28, height: 28, background: '#7C3AED', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
          <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>2</Text>
        </Box>
        <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E1B4B' }}>工作流只搭壳没跑通</Text>
      </Box>
      <Text style={{ fontSize: 17, color: '#64748B' }}>节点画得漂亮，但端到端一次都没真正执行过</Text>
