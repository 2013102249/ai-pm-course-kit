          <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>1</Text>
        </Box>
        <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E1B4B' }}>架构图画成了功能清单</Text>
      </Box>
