        <Box style={{ flex: 1, flexDirection: 'column', gap: 22 }}>
            <Box style={{ height: 150, background: '#FFFFFF', border: '1px solid #E5E7EB', borderLeft: '4px solid #7C3AED', borderRadius: 10, padding: 28, flexDirection: 'column', justifyContent: 'center', gap: 12 }}>
