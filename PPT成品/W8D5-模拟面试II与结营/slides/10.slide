            <Box style={{ height: 52, background: '#2563EB', alignItems: 'center', justifyContent: 'center' }}>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#FFFFFF' }}>卡 2 · 没底</Text>
