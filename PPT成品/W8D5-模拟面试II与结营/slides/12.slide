<Slide style={{ width: 1280, height: 720, padding: 60, position: 'relative', background: '#FFFFFF' }}>
    <Box style={{ position: 'absolute', top: 28, left: 60, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
        <Box style={{ width: 8, height: 24, background: '#7C3AED', borderRadius: 4 }} />
        <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W8D5</Text>
    </Box>
    <Text style={{ position: 'absolute', bottom: 24, right: 60, fontSize: 14, color: '#64748B' }}>12 / 14</Text>
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B' }}>背调与入职准备</Text>
    <Box style={{ marginTop: 16, width: '100%', height: 1, background: '#E5E7EB' }} />
    <Box style={{ marginTop: 20, width: '100%', height: 512, flexDirection: 'column', gap: 24 }}>
        <Box style={{ flexDirection: 'row', gap: 24, height: 244 }}>
            <Box style={{ flex: 1, background: '#F5F3FF', borderRadius: 12, padding: 26, flexDirection: 'column', gap: 14 }}>
                <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E1B4B' }}>背调范围与红线</Text>
                <Text style={{ fontSize: 16, color: '#64748B', lineHeight: 1.5 }}>背调是常规流程，如实配合即可</Text>
                <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #E5E7EB', borderLeft: '4px solid #DC2626', borderRadius: 8, padding: '12px 18px', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#DC2626' }}>红线：履历真实性不可碰</Text>
                </Box>
            </Box>
            <Box style={{ flex: 1, background: '#EFF6FF', borderRadius: 12, padding: 26, flexDirection: 'column', gap: 14 }}>
                <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E1B4B' }}>口头 vs 书面 offer</Text>
                <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #DBEAFE', borderRadius: 8, padding: '12px 18px', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 17, color: '#1E1B4B', lineHeight: 1.5 }}>口头 offer：意向表达，<span style={{ fontWeight: 'bold' }}>不作数</span></Text>
                </Box>
                <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #DBEAFE', borderRadius: 8, padding: '12px 18px', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 17, color: '#1E1B4B', lineHeight: 1.5 }}>书面 offer：正式依据，<span style={{ fontWeight: 'bold' }}>逐条看清再签</span></Text>
                </Box>
            </Box>
        </Box>
        <Box style={{ flexDirection: 'row', gap: 24, height: 244 }}>
            <Box style={{ flex: 1, background: '#F5F3FF', borderRadius: 12, padding: 26, flexDirection: 'column', gap: 14 }}>
                <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E1B4B' }}>三方与竞业</Text>
                <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #E5E7EB', borderRadius: 8, padding: '12px 18px', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 17, color: '#1E1B4B', lineHeight: 1.5 }}>三方协议：入职意向的约定，<span style={{ fontWeight: 'bold' }}>违约条款看清</span></Text>
                </Box>
                <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #E5E7EB', borderRadius: 8, padding: '12px 18px', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 17, color: '#1E1B4B', lineHeight: 1.5 }}>竞业限制：<span style={{ fontWeight: 'bold' }}>范围、期限、补偿</span>逐条确认</Text>
                </Box>
            </Box>
            <Box style={{ flex: 1, background: '#EFF6FF', borderRadius: 12, padding: 26, flexDirection: 'column', gap: 14 }}>
                <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E1B4B' }}>入职前 30 天四件事</Text>
                <Box style={{ flex: 1, flexDirection: 'row', flexWrap: 'wrap', gap: 12, alignItems: 'center' }}>
                    <Box style={{ background: '#FFFFFF', border: '1px solid #DBEAFE', borderRadius: 8, padding: '10px 18px' }}>
                        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#2563EB' }}>备齐入职材料</Text>
                    </Box>
                    <Box style={{ background: '#FFFFFF', border: '1px solid #DBEAFE', borderRadius: 8, padding: '10px 18px' }}>
                        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#2563EB' }}>完成离职交接</Text>
                    </Box>
                    <Box style={{ background: '#FFFFFF', border: '1px solid #DBEAFE', borderRadius: 8, padding: '10px 18px' }}>
                        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#2563EB' }}>对齐首月目标</Text>
                    </Box>
                    <Box style={{ background: '#FFFFFF', border: '1px solid #DBEAFE', borderRadius: 8, padding: '10px 18px' }}>
                        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#2563EB' }}>给自己留缓冲时间</Text>
                    </Box>
                </Box>
            </Box>
        </Box>
    </Box>
</Slide>
