<Slide style={{ width: 1280, height: 720, padding: 60, position: 'relative', background: '#FFFFFF' }}>
    <Box style={{ position: 'absolute', top: 28, left: 60, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
        <Box style={{ width: 8, height: 24, background: '#7C3AED', borderRadius: 4 }} />
        <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W8D5</Text>
    </Box>
    <Text style={{ position: 'absolute', bottom: 24, right: 60, fontSize: 14, color: '#64748B' }}>07 / 14</Text>
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B' }}>第二步 给锚点</Text>
    <Box style={{ marginTop: 16, width: '100%', height: 1, background: '#E5E7EB' }} />
    <Text style={{ position: 'absolute', bottom: 52, right: 60, fontSize: 12, color: '#64748B' }}>数据由机构就业服务组每年更新，图为结构示意</Text>
    <Box style={{ marginTop: 20, width: '100%', height: 512, flexDirection: 'row', gap: 36, alignItems: 'center' }}>
        <Box style={{ width: 470, flexDirection: 'column', gap: 16 }}>
            <Image src="assets/salary-step2.svg" style={{ width: 470, height: 315, objectFit: 'contain' }} />
            <Box style={{ background: '#F5F3FF', borderRadius: 10, padding: 18, flexDirection: 'column', gap: 8 }}>
                <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#2563EB' }}>关键话术</Text>
                <Text style={{ fontSize: 17, color: '#5B21B6', lineHeight: 1.5 }}>「结合市场带宽和我目前的情况，期望在 X 到 Y 之间」</Text>
            </Box>
        </Box>
        <Box style={{ flex: 1, flexDirection: 'column', gap: 16 }}>
            <Box style={{ flexDirection: 'row', gap: 14 }}>
                <Box style={{ background: '#F5F3FF', borderRadius: 10, padding: '10px 22px' }}>
                    <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#7C3AED' }}>报区间</Text>
                </Box>
                <Box style={{ background: '#F5F3FF', borderRadius: 10, padding: '10px 22px' }}>
                    <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#7C3AED' }}>锚上沿</Text>
                </Box>
                <Box style={{ background: '#F5F3FF', borderRadius: 10, padding: '10px 22px' }}>
                    <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#7C3AED' }}>带依据</Text>
                </Box>
            </Box>
            <Text style={{ fontSize: 18, color: '#1E1B4B' }}>依据：<span style={{ fontWeight: 'bold' }}>市场带宽 · 当前薪资 · 能力对标</span></Text>
            <Box style={{ width: '100%', border: '1px solid #E5E7EB', borderRadius: 10, overflow: 'hidden' }}>
                <Table
                    style={{ width: '100%', height: 232 }}
                    defaultTextStyle={{ fontSize: 16, textAlign: 'center', color: '#1E1B4B' }}
                    defaultCellStyle={{
                        border: {
                            left: { width: 1, color: '#E5E7EB' },
                            right: { width: 1, color: '#E5E7EB' },
                            top: { width: 1, color: '#E5E7EB' },
                            bottom: { width: 1, color: '#E5E7EB' },
                        },
                    }}
                    cells={[
                        [
                            { text: '分位', textStyle: { fontSize: 16, fontWeight: 'bold', color: '#FFFFFF' }, cellStyle: { background: { color: '#7C3AED' } } },
                            { text: '位置', textStyle: { fontSize: 16, fontWeight: 'bold', color: '#FFFFFF' }, cellStyle: { background: { color: '#7C3AED' } } },
                            { text: '谈薪用法', textStyle: { fontSize: 16, fontWeight: 'bold', color: '#FFFFFF' }, cellStyle: { background: { color: '#7C3AED' } } },
                        ],
                        ['P25', '带宽下沿', '心里的地板，低于要谨慎'],
                        [
                            { text: 'P50', cellStyle: { background: { color: '#F5F3FF' } } },
                            { text: '市场中位', cellStyle: { background: { color: '#F5F3FF' } } },
                            { text: '常规对照参考', cellStyle: { background: { color: '#F5F3FF' } } },
                        ],
                        ['P75', '带宽上沿', '报区间锚这里'],
                    ]}
                />
            </Box>
