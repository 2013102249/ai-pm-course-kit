<Slide style={{ width: 1280, height: 720, padding: 60, position: 'relative', background: '#FFFFFF' }}>
    <Box style={{ position: 'absolute', top: 28, left: 60, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
        <Box style={{ width: 8, height: 24, background: '#7C3AED', borderRadius: 4 }} />
        <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W8D5</Text>
    </Box>
    <Text style={{ position: 'absolute', bottom: 24, right: 60, fontSize: 14, color: '#64748B' }}>08 / 14</Text>
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B' }}>第三步 谈总包</Text>
    <Box style={{ marginTop: 16, width: '100%', height: 1, background: '#E5E7EB' }} />
    <Box style={{ marginTop: 20, width: '100%', height: 512, flexDirection: 'row', gap: 40, alignItems: 'center' }}>
        <Box style={{ width: 500, flexDirection: 'column', gap: 16 }}>
            <Image src="assets/salary-step3.svg" style={{ width: 500, height: 335, objectFit: 'contain' }} />
            <Box style={{ background: '#F5F3FF', borderRadius: 10, padding: 20, flexDirection: 'column', gap: 8 }}>
                <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#2563EB' }}>关键话术</Text>
                <Text style={{ fontSize: 18, color: '#5B21B6', lineHeight: 1.5 }}>「签字费、期权、公积金基数、调薪节奏，我算下总包」</Text>
            </Box>
        </Box>
        <Box style={{ flex: 1, flexDirection: 'column', gap: 20 }}>
            <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#64748B', letterSpacing: 2 }}>总包构成</Text>
            <Box style={{ background: '#F5F3FF', borderRadius: 12, padding: 26, flexDirection: 'column', alignItems: 'center', gap: 8 }}>
                <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#7C3AED' }}>月薪 × 月数</Text>
                <Text style={{ fontSize: 15, color: '#64748B' }}>基础项</Text>
            </Box>
            <Text style={{ fontSize: 15, color: '#64748B' }}>再加五项，缺一项就少算一块钱</Text>
            <Box style={{ flexDirection: 'row', flexWrap: 'wrap', gap: 14 }}>
                <Box style={{ background: '#EFF6FF', borderRadius: 10, padding: '12px 24px' }}>
                    <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#2563EB' }}>签字费</Text>
                </Box>
                <Box style={{ background: '#EFF6FF', borderRadius: 10, padding: '12px 24px' }}>
                    <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#2563EB' }}>期权</Text>
                </Box>
                <Box style={{ background: '#EFF6FF', borderRadius: 10, padding: '12px 24px' }}>
                    <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#2563EB' }}>补贴</Text>
                </Box>
                <Box style={{ background: '#EFF6FF', borderRadius: 10, padding: '12px 24px' }}>
                    <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#2563EB' }}>公积金基数</Text>
                </Box>
                <Box style={{ background: '#EFF6FF', borderRadius: 10, padding: '12px 24px' }}>
                    <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#2563EB' }}>调薪节奏</Text>
                </Box>
            </Box>
        </Box>
    </Box>
</Slide>
