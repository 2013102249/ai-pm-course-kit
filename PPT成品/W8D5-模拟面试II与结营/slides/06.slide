<Slide style={{ width: 1280, height: 720, padding: 60, position: 'relative', background: '#FFFFFF' }}>
    <Box style={{ position: 'absolute', top: 28, left: 60, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
        <Box style={{ width: 8, height: 24, background: '#7C3AED', borderRadius: 4 }} />
        <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W8D5</Text>
    </Box>
    <Text style={{ position: 'absolute', bottom: 24, right: 60, fontSize: 14, color: '#64748B' }}>06 / 14</Text>
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B' }}>第一步 探区间</Text>
    <Box style={{ marginTop: 16, width: '100%', height: 1, background: '#E5E7EB' }} />
    <Box style={{ marginTop: 20, width: '100%', height: 512, flexDirection: 'row', gap: 40, alignItems: 'center' }}>
        <Box style={{ width: 500, flexDirection: 'column', gap: 16 }}>
            <Image src="assets/salary-step1.svg" style={{ width: 500, height: 335, objectFit: 'contain' }} />
            <Box style={{ background: '#F5F3FF', borderRadius: 10, padding: 20, flexDirection: 'column', gap: 8 }}>
                <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#2563EB' }}>关键话术</Text>
                <Text style={{ fontSize: 18, color: '#5B21B6', lineHeight: 1.5 }}>「这个岗位的薪资带宽大概在什么范围？」</Text>
            </Box>
        </Box>
        <Box style={{ flex: 1, flexDirection: 'column', gap: 24 }}>
            <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#64748B', letterSpacing: 2 }}>核心动作</Text>
            <Box style={{ height: 170, background: '#FFFFFF', border: '1px solid #E5E7EB', borderLeft: '4px solid #7C3AED', borderRadius: 10, padding: 28, flexDirection: 'column', justifyContent: 'center', gap: 12 }}>
                <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#1E1B4B' }}>先问再答</Text>
                <Text style={{ fontSize: 17, color: '#64748B', lineHeight: 1.5 }}>让对方先亮出区间，再决定自己怎么报</Text>
            </Box>
            <Box style={{ height: 170, background: '#EFF6FF', border: '1px solid #DBEAFE', borderLeft: '4px solid #2563EB', borderRadius: 10, padding: 28, flexDirection: 'column', justifyContent: 'center', gap: 12 }}>
                <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#1E1B4B' }}>先报数 = 把锚点送给对方</Text>
                <Text style={{ fontSize: 17, color: '#64748B', lineHeight: 1.5 }}>先报的那个数，就是全场谈判的参照物</Text>
            </Box>
        </Box>
    </Box>
</Slide>
