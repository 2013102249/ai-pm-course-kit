<Slide style={{ width: 1280, height: 720, padding: 60, background: '#FFFFFF' }}>
    <Box style={{ position: 'absolute', top: 24, left: 60, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
        <Box style={{ width: 8, height: 24, background: '#7C3AED', borderRadius: 4 }} />
        <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W2D1</Text>
    </Box>
    <Box style={{ position: 'absolute', bottom: 28, right: 60 }}>
        <Text style={{ fontSize: 14, color: '#64748B' }}>13 / 16</Text>
    </Box>
    <Box style={{ flexDirection: 'column', gap: 18 }}>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B' }}>选型决策树五问</Text>
        <Box style={{ width: '100%', height: 1, background: '#E5E7EB' }} />
    </Box>
    <Box style={{ flexDirection: 'row', gap: 28, paddingTop: 24, alignItems: 'center' }}>
        <Box style={{ width: 490, flexDirection: 'column', gap: 14 }}>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16, background: '#F5F3FF', borderRadius: 10, padding: '16px 22px' }}>
                <Box style={{ width: 28, height: 28, background: '#7C3AED', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>1</Text>
                </Box>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1E1B4B' }}>任务类型</Text>
            </Box>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16, background: '#EFF6FF', borderRadius: 10, padding: '16px 22px' }}>
                <Box style={{ width: 28, height: 28, background: '#7C3AED', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>2</Text>
                </Box>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1E1B4B' }}>质量底线（小模型三条件）</Text>
            </Box>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16, background: '#F5F3FF', borderRadius: 10, padding: '16px 22px' }}>
                <Box style={{ width: 28, height: 28, background: '#7C3AED', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>3</Text>
                </Box>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1E1B4B' }}>延迟容忍</Text>
            </Box>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16, background: '#EFF6FF', borderRadius: 10, padding: '16px 22px' }}>
                <Box style={{ width: 28, height: 28, background: '#7C3AED', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>4</Text>
                </Box>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1E1B4B' }}>预算量级</Text>
            </Box>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16, background: '#FFFFFF', border: '2px solid #B91C1C', borderRadius: 10, padding: '16px 22px' }}>
                <Box style={{ width: 28, height: 28, background: '#7C3AED', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>5</Text>
                </Box>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1E1B4B' }}>合规部署</Text>
                <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#B91C1C' }}>一票否决</Text>
            </Box>
        </Box>
        <Box style={{ flex: 1, alignItems: 'center', justifyContent: 'center' }}>
            <Image src="assets/decision-tree.svg" style={{ width: 600, height: 420, objectFit: 'contain' }} />
