        <Box style={{ flexDirection: 'row', gap: 14 }}>
            <Box style={{ flex: 1, background: '#EFF6FF', borderRadius: 8, padding: '16px 0', alignItems: 'center' }}>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#1E1B4B' }}>通用对话</Text>
            </Box>
            <Box style={{ flex: 1, background: '#EFF6FF', borderRadius: 8, padding: '16px 0', alignItems: 'center' }}>
