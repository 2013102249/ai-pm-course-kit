<Slide style={{ width: 1280, height: 720, padding: 60, background: '#FFFFFF' }}>
    <Box style={{ position: 'absolute', top: 24, left: 60, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
        <Box style={{ width: 8, height: 24, background: '#7C3AED', borderRadius: 4 }} />
        <Text style={{ fontSize: 14, color: '#64748B' }}>AI 产品经理实战训练营 · W2D1</Text>
    </Box>
    <Box style={{ position: 'absolute', bottom: 28, right: 60 }}>
        <Text style={{ fontSize: 14, color: '#64748B' }}>06 / 16</Text>
    </Box>
    <Box style={{ flexDirection: 'column', gap: 18 }}>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B' }}>一道无法回答的题</Text>
        <Box style={{ width: '100%', height: 1, background: '#E5E7EB' }} />
    </Box>
    <Box style={{ flex: 1, flexDirection: 'column', justifyContent: 'center', gap: 18 }}>
        <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E1B4B' }}>「A 能力最强 / B 便宜三倍 / C 快三倍，选谁？」</Text>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16, background: '#F5F3FF', borderRadius: 12, padding: '20px 28px' }}>
            <Box style={{ width: 40, height: 40, background: '#7C3AED', borderRadius: 8, alignItems: 'center', justifyContent: 'center' }}>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#FFFFFF' }}>A</Text>
            </Box>
            <Text style={{ fontSize: 20, color: '#1E1B4B' }}>能力最强</Text>
        </Box>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16, background: '#EFF6FF', borderRadius: 12, padding: '20px 28px' }}>
            <Box style={{ width: 40, height: 40, background: '#2563EB', borderRadius: 8, alignItems: 'center', justifyContent: 'center' }}>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#FFFFFF' }}>B</Text>
            </Box>
            <Text style={{ fontSize: 20, color: '#1E1B4B' }}>便宜三倍</Text>
        </Box>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16, background: '#F5F3FF', borderRadius: 12, padding: '20px 28px' }}>
            <Box style={{ width: 40, height: 40, background: '#7C3AED', borderRadius: 8, alignItems: 'center', justifyContent: 'center' }}>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#FFFFFF' }}>C</Text>
            </Box>
            <Text style={{ fontSize: 20, color: '#1E1B4B' }}>快三倍</Text>
        </Box>
        <Box style={{ alignItems: 'center', paddingTop: 10 }}>
            <Text style={{ fontSize: 40, fontWeight: 'bold', color: '#7C3AED' }}>缺场景，无解</Text>
        </Box>
    </Box>
</Slide>
