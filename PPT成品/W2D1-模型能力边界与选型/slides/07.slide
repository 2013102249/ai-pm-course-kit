    </Box>
    <Box style={{ position: 'absolute', bottom: 28, right: 60 }}>
        <Text style={{ fontSize: 14, color: '#64748B' }}>07 / 16</Text>
    </Box>
    <Box style={{ flexDirection: 'column', gap: 18 }}>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E1B4B' }}>能力-成本-延迟三角</Text>
        <Box style={{ width: '100%', height: 1, background: '#E5E7EB' }} />
    </Box>
    <Box style={{ flexDirection: 'row', gap: 28, paddingTop: 24, alignItems: 'center' }}>
        <Box style={{ width: 460, flexDirection: 'column', gap: 20 }}>
            <Box style={{ flexDirection: 'row', alignItems: 'flex-start', gap: 16, background: '#F5F3FF', borderRadius: 12, padding: '22px 24px' }}>
                <Box style={{ width: 28, height: 28, background: '#7C3AED', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>1</Text>
                </Box>
                <Box style={{ flex: 1, flexDirection: 'column', gap: 8 }}>
                    <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E1B4B' }}>能力</Text>
                    <Text style={{ fontSize: 17, color: '#64748B' }}>先定能力线，再挑选模型</Text>
                </Box>
            </Box>
            <Box style={{ flexDirection: 'row', alignItems: 'flex-start', gap: 16, background: '#EFF6FF', borderRadius: 12, padding: '22px 24px' }}>
                <Box style={{ width: 28, height: 28, background: '#7C3AED', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>2</Text>
                </Box>
                <Box style={{ flex: 1, flexDirection: 'column', gap: 8 }}>
                    <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E1B4B' }}>成本</Text>
                    <Text style={{ fontSize: 17, color: '#64748B' }}>调用 + 运维 + 切换（以官网实时价格为准）</Text>
